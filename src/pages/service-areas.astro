---
import MainLayout from "../layouts/MainLayout.astro";

const cities = [
  "Dover", "Harrington", "Milford", "Bowers", "Camden",
  "Cheswold", "Clayton", "Farmington", "Felton", "Frederica",
  "Hartly", "Houston", "Kenton", "Leipsic", "Little Creek",
  "Magnolia", "Smyrna", "Viola", "Woodside", "Wyoming"
];

const slugify = (city: string) => city.toLowerCase().replaceAll(" ", "-") + "-de";
---

<MainLayout
  title="Locksmith Service Areas in Kent County, DE | 1st Capital Locksmith"
  description="1st Capital Locksmith provides fast mobile locksmith services throughout Dover and all of Kent County, Delaware. Automotive, residential, commercial, and emergency locksmith service available in your area now."
>

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li>
          <a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-[#A61E22] font-semibold">Service Areas</span>
        </li>
      </ol>
    </div>
  </nav>

  <!-- Schema: Breadcrumb -->
  <Fragment set:html={`<script type="application/ld+json">${JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.1stcapitallocksmith.com/" },
      { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": "https://www.1stcapitallocksmith.com/service-areas/" }
    ]
  })}</script>`} />

  <!-- Hero -->
  <section
    class="relative min-h-[450px] flex items-center text-white py-20"
    style="background-image: url('/images/hero.png'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative max-w-6xl mx-auto px-6 z-10">
      <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-4">Service Areas</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-6 max-w-3xl leading-tight">
        Mobile Locksmith Service Throughout Kent County, Delaware
      </h1>
      <p class="text-gray-300 text-lg max-w-2xl leading-relaxed mb-8">
        1st Capital Locksmith serves Dover and every community across Kent County, Delaware. We dispatch quickly and come directly to your location for automotive, residential, commercial, and emergency locksmith services.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="tel:3027350050"
          class="inline-flex items-center rounded-full bg-[#A61E22] px-8 py-3 text-white font-semibold hover:bg-[#8C181B] transition"
        >
          Call (302) 735-0050
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center rounded-full border border-white px-8 py-3 text-white font-semibold hover:bg-white hover:text-[#1A1F22] transition"
        >
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Where We Work</p>
      <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-6">
        Your Local Locksmith in Dover and Kent County, DE
      </h2>
      <p class="text-gray-700 text-lg max-w-4xl mx-auto leading-relaxed">
        As a fully mobile locksmith company based in Dover, Delaware, 1st Capital Locksmith proudly serves homeowners, drivers, renters, and business owners throughout Kent County and surrounding communities. No matter where you are in our service area, we come directly to your location with all the tools and equipment needed to handle any lock and key situation on the spot. From emergency car lockouts in Dover to residential rekeying in Smyrna and commercial lock installations in Milford, we are your trusted local locksmith in Delaware.
      </p>
    </div>
  </section>

  <!-- City Grid -->
  <section class="bg-[#F8F8F5] py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Communities We Serve</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-4">
          Locksmith Services in These Kent County Communities
        </h2>
        <p class="text-gray-700 max-w-3xl mx-auto leading-relaxed">
          Select your city or town below to learn more about the locksmith services available in your area throughout Kent County, Delaware.
        </p>
      </div>

      <div class="grid md:grid-cols-3 lg:grid-cols-4 gap-6">
        {cities.map((city) => (
          <a
            href={`/service-areas/${slugify(city)}/`}
            class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm hover:shadow-md hover:border-[#A61E22] transition text-center group"
          >
            <div class="w-10 h-10 bg-[#A61E22] rounded-full flex items-center justify-center mx-auto mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0L6.343 16.657a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#1A1F22] mb-1 group-hover:text-[#A61E22] transition">{city}, DE</h3>
            <p class="text-gray-500 text-sm">Locksmith Services</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Services We Offer -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">What We Offer</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-4">
          Full-Service Mobile Locksmith Available Throughout Delaware
        </h2>
        <p class="text-gray-700 max-w-3xl mx-auto leading-relaxed">
          No matter where you are in Kent County, 1st Capital Locksmith provides a complete range of professional locksmith services for vehicles, homes, and businesses. Click any service below to learn more.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4">

        <a href="/services/automotive-locksmith/" class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:shadow-md hover:border-[#A61E22] transition group">
          <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10l2 2h7l1-2zM13 6h3l3 4v4h-2" />
            </svg>
          </div>
          <h3 class="font-bold text-lg text-[#1A1F22] mb-2 group-hover:text-[#A61E22] transition">Automotive Locksmith</h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-3">Car lockouts, key replacement, transponder programming, key fob setup, and ignition repair throughout Kent County.</p>
          <span class="text-[#A61E22] font-semibold text-sm">Learn more →</span>
        </a>

        <a href="/services/residential-locksmith/" class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:shadow-md hover:border-[#A61E22] transition group">
          <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 9.75L12 3l9 6.75V21a1 1 0 01-1 1H4a1 1 0 01-1-1V9.75z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 22V12h6v10" />
            </svg>
          </div>
          <h3 class="font-bold text-lg text-[#1A1F22] mb-2 group-hover:text-[#A61E22] transition">Residential Locksmith</h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-3">House lockouts, lock rekeying, deadbolt installation, lock repair, and home security upgrades for Dover area homeowners.</p>
          <span class="text-[#A61E22] font-semibold text-sm">Learn more →</span>
        </a>

        <a href="/services/commercial-locksmith/" class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:shadow-md hover:border-[#A61E22] transition group">
          <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V7a2 2 0 00-2-2H7a2 2 0 00-2 2v14M3 21h18M9 21v-4a1 1 0 011-1h4a1 1 0 011 1v4" />
            </svg>
          </div>
          <h3 class="font-bold text-lg text-[#1A1F22] mb-2 group-hover:text-[#A61E22] transition">Commercial Locksmith</h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-3">Office lockouts, business rekeying, panic bars, master key systems, and high-security locks for Delaware businesses.</p>
          <span class="text-[#A61E22] font-semibold text-sm">Learn more →</span>
        </a>

        <a href="/services/emergency-locksmith/" class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:shadow-md hover:border-[#A61E22] transition group">
          <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 10-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
          </div>
          <h3 class="font-bold text-lg text-[#1A1F22] mb-2 group-hover:text-[#A61E22] transition">Emergency Locksmith</h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-3">Urgent car, home, and business lockouts, broken key extraction, and emergency lock repairs throughout Kent County.</p>
          <span class="text-[#A61E22] font-semibold text-sm">Learn more →</span>
        </a>

      </div>

      <div class="mt-10 text-center">
        <a
          href="/services/"
          class="inline-flex items-center rounded-full bg-[#A61E22] px-8 py-3 text-white font-semibold hover:bg-[#8C181B] transition"
        >
          View All Services →
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="bg-[#0E1B2F] py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Why Choose Us</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
          The Trusted Locksmith Company Serving All of Kent County
        </h2>
        <p class="text-gray-300 max-w-3xl mx-auto leading-relaxed">
          Customers throughout Dover, Smyrna, Milford, Camden, and every corner of Kent County trust 1st Capital Locksmith for fast, professional, and affordable mobile locksmith service.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white/10 rounded-2xl p-8 border border-white/10 text-center">
          <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="font-bold text-white text-lg mb-2">Fast Mobile Dispatch</h3>
          <p class="text-gray-300 text-sm leading-relaxed">We dispatch immediately and come directly to your location anywhere in Kent County. No shop visit required.</p>
        </div>

        <div class="bg-white/10 rounded-2xl p-8 border border-white/10 text-center">
          <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-bold text-white text-lg mb-2">Upfront Honest Pricing</h3>
          <p class="text-gray-300 text-sm leading-relaxed">We provide clear quotes before starting any work. No hidden fees, no bait-and-switch pricing for any customer in our service area.</p>
        </div>

        <div class="bg-white/10 rounded-2xl p-8 border border-white/10 text-center">
          <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="font-bold text-white text-lg mb-2">Trained Professionals</h3>
          <p class="text-gray-300 text-sm leading-relaxed">Our locksmiths are skilled, experienced, and equipped to handle any automotive, residential, or commercial lock and key situation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Customer Reviews</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22]">
          Trusted by Customers Throughout Kent County, Delaware
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-[#F8F8F5] p-6 rounded-xl border border-gray-200 shadow-sm">
          <p class="mb-4 text-gray-700">"Fast response and very professional. Got my car unlocked quickly and without damage. Best locksmith in Dover!"</p>
          <p class="text-sm text-gray-500 mb-1">Michael R. — Car lockout</p>
          <p class="text-sm text-gray-500">Dover, DE</p>
          <strong class="text-[#1A1F22]">★★★★★</strong>
        </div>

        <div class="bg-[#F8F8F5] p-6 rounded-xl border border-gray-200 shadow-sm">
          <p class="mb-4 text-gray-700">"Needed a new key fob programmed on-site. Service was quick, pricing was fair, and the technician was very knowledgeable."</p>
          <p class="text-sm text-gray-500 mb-1">Samantha T. — Key fob programming</p>
          <p class="text-sm text-gray-500">Milford, DE</p>
          <strong class="text-[#1A1F22]">★★★★★</strong>
        </div>

        <div class="bg-[#F8F8F5] p-6 rounded-xl border border-gray-200 shadow-sm">
          <p class="mb-4 text-gray-700">"Excellent locksmith service. Arrived on time and rekeyed all our locks the same day. Very professional team."</p>
          <p class="text-sm text-gray-500 mb-1">David H. — Residential rekey</p>
          <p class="text-sm text-gray-500">Smyrna, DE</p>
          <strong class="text-[#1A1F22]">★★★★★</strong>
        </div>

        <div class="bg-[#F8F8F5] p-6 rounded-xl border border-gray-200 shadow-sm">
          <p class="mb-4 text-gray-700">"Replaced the deadbolt on our storefront and helped with a panic bar install. Great work and very fair pricing."</p>
          <p class="text-sm text-gray-500 mb-1">Emma L. — Commercial locks</p>
          <p class="text-sm text-gray-500">Camden, DE</p>
          <strong class="text-[#1A1F22]">★★★★★</strong>
        </div>

        <div class="bg-[#F8F8F5] p-6 rounded-xl border border-gray-200 shadow-sm">
          <p class="mb-4 text-gray-700">"Locked my keys in the house late at night. They arrived fast and got me back inside without any damage to my door."</p>
          <p class="text-sm text-gray-500 mb-1">Tyler S. — Home lockout</p>
          <p class="text-sm text-gray-500">Harrington, DE</p>
          <strong class="text-[#1A1F22]">★★★★★</strong>
        </div>

        <div class="bg-[#F8F8F5] p-6 rounded-xl border border-gray-200 shadow-sm">
          <p class="mb-4 text-gray-700">"Great service for our business lock rekey and new access keys after a staff change. Dependable and professional."</p>
          <p class="text-sm text-gray-500 mb-1">Olivia M. — Business rekey</p>
          <p class="text-sm text-gray-500">Dover, DE</p>
          <strong class="text-[#1A1F22]">★★★★★</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#1A1F22] py-20">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Need a Locksmith in Kent County, DE?
      </h2>
      <p class="text-gray-300 mb-8 text-lg max-w-2xl mx-auto leading-relaxed">
        Call 1st Capital Locksmith for fast, professional mobile locksmith service throughout Dover and all of Kent County, Delaware. We are ready to help right now.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="tel:3027350050"
          class="inline-flex items-center rounded-full bg-[#A61E22] px-10 py-4 text-white font-bold text-lg hover:bg-[#8C181B] transition"
        >
          Call (302) 735-0050
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center rounded-full border border-white px-10 py-4 text-white font-bold text-lg hover:bg-white hover:text-[#1A1F22] transition"
        >
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>

</MainLayout>