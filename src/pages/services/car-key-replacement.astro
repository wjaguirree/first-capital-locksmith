---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="Car Key Replacement in Delaware | Mobile Key Cutting & Programming | 1st Capital Locksmith"
  description="Lost your car keys? 1st Capital Locksmith provides mobile car key replacement throughout Delaware. We cut and program transponder keys, smart keys, key fobs, and laser-cut keys on-site — at a fraction of dealership cost. Serving Dover, Milford, Smyrna & all of Kent County, DE."
>

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li>
          <a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-[#A61E22] font-semibold">Car Key Replacement</span>
        </li>
      </ol>
    </div>
  </nav>

  <!-- Schema Markup for Breadcrumbs -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.1stcapitallocksmith.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.1stcapitallocksmith.com/services/" },
      { "@type": "ListItem", "position": 3, "name": "Car Key Replacement", "item": "https://www.1stcapitallocksmith.com/services/car-key-replacement/" }
    ]
  })} />

  <!-- Schema: Service -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Car Key Replacement in Delaware",
    "description": "Mobile car key replacement throughout Delaware — standard keys, transponder keys, and smart keys cut and programmed on-site. 1st Capital Locksmith serves Dover, Milford, Smyrna, Camden, Harrington and all of Kent County. No towing required.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "1st Capital Locksmith",
      "telephone": "+13027350050",
      "address": { "@type": "PostalAddress", "addressLocality": "Dover", "addressRegion": "DE", "addressCountry": "US" }
    },
    "areaServed": { "@type": "State", "name": "Delaware" },
    "serviceType": "Car Key Replacement"
  })} />

  <!-- Schema: FAQ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does car key replacement cost in Delaware?", "acceptedAnswer": { "@type": "Answer", "text": "The cost depends on the type of key your vehicle uses (standard, transponder, smart key) and your specific vehicle make and model. We provide a clear, upfront quote before any work begins. Call us at (302) 735-0050 and give us your year, make, and model for a fast, accurate estimate." } },
      { "@type": "Question", "name": "Can you replace my car key if I don't have the original?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We can replace your car key even with no original to copy from. We use your vehicle's VIN to determine the correct key profile and cut a new key from scratch. For vehicles requiring transponder programming, we handle that on-site as well." } },
      { "@type": "Question", "name": "Is a locksmith cheaper than a dealership for car key replacement?", "acceptedAnswer": { "@type": "Answer", "text": "In almost every case, yes — significantly cheaper. Dealerships have high labor overhead and often require you to tow your vehicle to them if you have no key at all. Our mobile locksmiths come directly to you throughout Delaware and typically charge considerably less for the same quality service." } },
      { "@type": "Question", "name": "How long does car key replacement take?", "acceptedAnswer": { "@type": "Answer", "text": "The time varies depending on the type of key and whether transponder programming is required. In most cases you will have a fully working replacement key within a single visit. Smart keys and more complex systems may take slightly longer." } },
      { "@type": "Question", "name": "Can you make a spare car key while my car is working fine?", "acceptedAnswer": { "@type": "Answer", "text": "Absolutely, and we strongly encourage it. Having a spare key made now is far less expensive and far less stressful than an emergency replacement later. We will come to your home or workplace at a time convenient for you and have it done in about 20-30 minutes." } },
      { "@type": "Question", "name": "Do you come to me, or do I have to bring the car to you?", "acceptedAnswer": { "@type": "Answer", "text": "We come to you. 1st Capital Locksmith is a fully mobile car key replacement service. We dispatch to your location throughout Delaware — your home, workplace, parking lot, or anywhere else your vehicle happens to be. No towing required." } }
    ]
  })} />

  <!-- Hero -->
  <section
    class="relative min-h-[340px] md:min-h-[550px] flex items-center text-white py-10 md:py-20"
    style="background-image: url('/images/smart-key-programming.jpg'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative max-w-6xl mx-auto px-5 md:px-6 z-10">
      <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-xs md:text-sm mb-2 md:mb-4">Car Key Replacement — Delaware</p>
      <h1 class="text-2xl sm:text-3xl md:text-5xl font-bold mb-3 md:mb-6 max-w-3xl leading-tight">
        Car Key Replacement in Delaware — Cut & Programmed On-Site
      </h1>
      <p class="text-gray-300 text-sm md:text-lg max-w-2xl leading-relaxed mb-5 md:mb-8">
        Lost your car keys? Need a spare key made before it's too late? 1st Capital Locksmith provides fast, mobile car key replacement throughout Delaware. We come directly to your location, cut your new key, and program it on the spot — no dealership, no towing, no waiting.
      </p>
      <div class="flex flex-wrap gap-3 md:gap-4">
        <a
          href="tel:3027350050"
          class="inline-flex items-center rounded-full bg-[#A61E22] px-6 py-3 md:px-8 md:py-4 text-white font-bold text-base md:text-lg hover:bg-[#8C181B] transition"
        >
          Call (302) 735-0050
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center rounded-full border border-white px-6 py-3 md:px-8 md:py-4 text-white font-semibold text-sm md:text-base hover:bg-white hover:text-[#1A1F22] transition"
        >
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">All Makes</p>
          <p class="text-gray-300 text-sm mt-1">Domestic & Foreign Vehicles</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Mobile</p>
          <p class="text-gray-300 text-sm mt-1">We Come to Your Location</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">On-Site</p>
          <p class="text-gray-300 text-sm mt-1">Cut & Programmed Where You Are</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Less Than Dealer</p>
          <p class="text-gray-300 text-sm mt-1">Save vs. Dealership Pricing</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Delaware's Mobile Car Key Specialist</p>
          <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-6 leading-snug">
            Professional Car Key Replacement Throughout Delaware
          </h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            Losing your car keys is one of the most frustrating things that can happen to any driver. The dealership wants to charge you hundreds of dollars, you need to arrange a tow if you have no key at all, and you're looking at days of waiting. There's a better way. 1st Capital Locksmith is a fully mobile car key replacement service that comes directly to wherever your vehicle is located throughout Delaware — and we do it for significantly less than the dealership.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            Our locksmiths are trained and equipped to replace all types of car keys including standard cut keys, transponder chip keys, laser-cut keys, smart keys, and push-to-start proximity keys. We carry professional key cutting machines and programming equipment in our mobile vehicles, which means we can cut and program your replacement key on-site in a single visit.
          </p>
          <p class="text-gray-700 leading-relaxed">
            We serve drivers throughout Dover, Milford, Smyrna, Camden, Harrington, Frederica, and all surrounding communities in Kent County. Whether you've lost your only key or you just want a spare made while everything is working fine, call 1st Capital Locksmith and we'll take care of it.
          </p>
        </div>
        <div class="flex flex-col gap-6">
          <!-- PHOTO SLOT 1: Recommended size 800×500px — e.g. locksmith cutting a car key on-site -->
          <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-sm">
            <img
              src="/images/car-key-replacement.jpg"
              alt="1st Capital Locksmith technician cutting a car key on-site in Delaware"
              class="w-full h-64 object-cover"
              width="800"
              height="500"
            />
          </div>
          <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200">
          <h3 class="text-xl font-bold text-[#1A1F22] mb-6">Car Key Replacement Services We Provide:</h3>
          <ul class="space-y-3">
            {[
              "Lost Car Key Replacement (All Types)",
              "Transponder / Chip Key Cutting & Programming",
              "Laser-Cut & High-Security Key Replacement",
              "Smart Key & Push-to-Start Key Programming",
              "Key Fob Replacement & Programming",
              "Duplicate / Spare Car Key Made On-Site",
              "Key Replacement Without the Original",
              "All Makes & Models — Domestic & Foreign",
            ].map((item) => (
              <li class="flex items-center gap-3 text-gray-700">
                <span class="w-6 h-6 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
          <div class="mt-6 pt-6 border-t border-gray-200">
            <a
              href="tel:3027350050"
              class="w-full inline-flex justify-center items-center rounded-full bg-[#A61E22] px-6 py-3 text-white font-bold hover:bg-[#8C181B] transition"
            >
              Call (302) 735-0050 Now
            </a>
          </div>
        </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Detail -->
  <section id="services" class="bg-[#F8F8F5] py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-14">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">What We Do</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-4">
          Car Key Replacement Services in Delaware
        </h2>
        <p class="text-gray-700 max-w-3xl mx-auto leading-relaxed">
          Modern car keys are far more complex than they used to be. Here is a detailed breakdown of every type of car key replacement we offer and how we handle each one on-site throughout Delaware.
        </p>
      </div>

      <div class="space-y-8">

        <!-- Lost Car Key Replacement -->
        <div id="lost-car-key" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Lost Car Key Replacement in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Losing your only set of car keys puts you in a genuinely stressful situation. Without a spare, you cannot drive, and arranging a tow to a dealership only adds cost and time to an already frustrating day. The good news is that you do not need a tow and you do not need to go to the dealership. 1st Capital Locksmith can replace your lost car keys on-site, right where your vehicle is parked throughout Delaware.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              Even if you have no original key to copy from, our locksmiths can generate the correct key cut for your vehicle using your Vehicle Identification Number (VIN) and our professional key cutting equipment. For vehicles that require transponder programming, we handle that on-site as well so your new key starts the engine on the first try.
            </p>
            <p class="text-gray-700 leading-relaxed">
              The moment you realize your keys are lost, call 1st Capital Locksmith at (302) 735-0050. We will gather your vehicle information over the phone, dispatch a mobile locksmith to your location, and have you back behind the wheel as quickly as possible.
            </p>
            <!-- PHOTO SLOT 2: Recommended size 1200×500px — e.g. stranded driver next to car, locksmith arriving -->
            <div class="mt-6 rounded-xl overflow-hidden border border-gray-200">
              <img
                src="/images/car-key-replacement-locksmith.jpg"
                alt="Mobile locksmith arriving to replace lost car keys for a Delaware driver"
                class="w-full h-90 object-cover"
                width="1200"
                height="500"
              />
            </div>
          </div>
        </div>

        <!-- Transponder Key Replacement -->
        <div id="transponder-key" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Transponder Key Cutting & Programming in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Most vehicles manufactured after 1995 use transponder keys, also called chip keys. The head of the key contains a small electronic microchip that must communicate with your vehicle's immobilizer system for the car to start. If you simply have the key cut at a hardware store without programming the chip, the key will physically turn the <a href="/services/ignition-repair/" class="text-[#A61E22] hover:underline font-medium">ignition</a> but the engine will not start. Programming the chip requires specialized equipment — the kind our mobile locksmiths carry with them every day.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              At 1st Capital Locksmith, we cut and program transponder keys on-site throughout Delaware using professional-grade key cutting machines and programming tools equivalent to those used by dealerships. We work with transponder keys for virtually all makes and models including Toyota, Honda, Ford, Chevrolet, Nissan, Hyundai, Kia, Jeep, Dodge, RAM, Subaru, and many more.
            </p>
            <p class="text-gray-700 leading-relaxed">
              Transponder key replacement at a dealership can cost $200–$500 or more, not counting labor or towing fees. Our mobile service typically comes in well below that — and we come to you. Call us for an upfront quote on your specific year, make, and model.
            </p>
            <!-- PHOTO SLOT 3: Recommended size 1200×500px — e.g. close-up of transponder chip key or programming equipment -->
            <div class="mt-6 rounded-xl overflow-hidden border border-gray-200">
              <img
                src="/images/transponder-key-programming.jpg"
                alt="Transponder chip key being programmed on-site by 1st Capital Locksmith in Delaware"
                class="w-full h-120 object-fill"
                width="1200"
                height="500"
              />
            </div>
          </div>
        </div>

        <!-- Laser Cut & High-Security Key Replacement -->
        <div id="laser-cut-key" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Laser-Cut & High-Security Key Replacement in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Laser-cut keys — sometimes called sidewinder keys — feature a distinctive winding channel cut down the center of the blade rather than the standard serrated edge on a traditional key. They are used on a wide range of modern vehicles and are significantly more difficult to duplicate than a standard key, which is exactly what makes them a stronger anti-theft measure.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              Cutting a laser key requires a specialized key cutting machine that most hardware stores simply do not have. Our mobile locksmiths carry the equipment needed to cut laser-cut keys on-site and program the transponder chip if the key requires it — all at your location, anywhere in Delaware.
            </p>
            <p class="text-gray-700 leading-relaxed">
              Many European and luxury vehicles such as BMW, Mercedes-Benz, Audi, and Volkswagen use laser-cut keys as standard, as do many domestic models from Ford, GM, and Chrysler. If you are unsure what type of key your vehicle uses, just give us a call and we can identify it from your vehicle's year, make, and model.
            </p>
          </div>
        </div>

        <!-- Smart Key & Push-to-Start -->
        <div id="smart-key" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Smart Key & Push-to-Start Key Replacement in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Smart keys and proximity fobs have become the standard on most new vehicles. These keyless entry and push-button start systems allow you to unlock your car and start the engine simply by having the fob nearby — but when that <a href="/services/key-fob-programming/" class="text-[#A61E22] hover:underline font-medium">fob is lost or stops working</a>, you are completely unable to use your vehicle without a replacement that has been properly programmed to your car's security system.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              Smart key programming is one of the more technically involved types of car key replacement, which is why most people assume they have no choice but to go to the dealership. 1st Capital Locksmith has the diagnostic programming tools needed to pair new smart keys and proximity fobs to your vehicle's system on-site throughout Delaware — no dealer visit required.
            </p>
            <p class="text-gray-700 leading-relaxed">
              We work with smart key systems from Toyota, Lexus, Honda, Acura, Nissan, Infiniti, Hyundai, Kia, Ford, Chevrolet, Dodge, BMW, Mercedes-Benz, and many others. Call us with your vehicle details and we will confirm compatibility before we dispatch.
            </p>
          </div>
        </div>

        <!-- Duplicate / Spare Car Key -->
        <div id="spare-key" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Duplicate & Spare Car Key Made On-Site in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Having a spare car key is one of the smartest things a vehicle owner can do. It protects you against the stress and expense of a lost-key emergency, makes it easy to share the vehicle with a family member, and gives you peace of mind every single day. Most people only think about a spare after they've already lost their keys — don't wait until that happens.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              1st Capital Locksmith can make a duplicate car key on-site at your home, workplace, or anywhere else in Delaware. We bring our key cutting machine and programming tools directly to you, cut a new key from your existing one, program the transponder chip if required, and have a working spare ready for you in a single visit. The entire process typically takes 20–30 minutes.
            </p>
            <p class="text-gray-700 leading-relaxed">
              Getting a spare made now while everything is working is always far less expensive than an emergency replacement later. Give us a call and schedule a convenient time — we will come to you at your home or office whenever it works best for your schedule.
            </p>
          </div>
        </div>

        <!-- Key Replacement Without Original -->
        <div id="key-no-original" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Car Key Replacement Without the Original in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
