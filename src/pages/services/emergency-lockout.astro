---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="Emergency Lockout Service in Delaware | Lockout Help | 1st Capital Locksmith"
  description="emergency lockout service in Delaware. Locked out of your home, car, or office? 1st Capital Locksmith responds fast across Dover, Smyrna, Milford, and all of Kent County. Call (302) 735-0050 now."
>

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li>
          <a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-[#A61E22] font-semibold">Emergency Lockout Service</span>
        </li>
      </ol>
    </div>
  </nav>

  <!-- Schema: Breadcrumbs -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.1stcapitallocksmith.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.1stcapitallocksmith.com/services/" },
      { "@type": "ListItem", "position": 3, "name": "Emergency Lockout Service", "item": "https://www.1stcapitallocksmith.com/services/emergency-lockout/" }
    ]
  })} />

  <!-- Schema: Service -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Emergency Lockout Service in Delaware",
    "description": "emergency lockout service for homes, cars, and businesses throughout Delaware. 1st Capital Locksmith responds fast to lockouts in Dover, Smyrna, Milford, Camden, Harrington, and all of Kent County with professional, non-destructive entry techniques.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "1st Capital Locksmith",
      "telephone": "+13027350050",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Dover",
        "addressRegion": "DE",
        "addressCountry": "US"
      }
    },
    "areaServed": {
      "@type": "State",
      "name": "Delaware"
    },
    "serviceType": "Emergency Lockout Service"
  })} />

  <!-- Schema: FAQ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How fast can you respond to an emergency lockout in Delaware?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We aim to reach most locations in Kent County within 20–30 minutes of your call. Response times vary slightly depending on your exact location and traffic conditions, but we dispatch immediately and keep you updated on our ETA. Call (302) 735-0050 and we will be on our way."
        }
      },
      {
        "@type": "Question",
        "name": "Do you respond to lockouts 24 hours a day?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We are open 6 days a week. Call (302) 735-0050 during business hours and a technician will be dispatched to your location."
        }
      },
      {
        "@type": "Question",
        "name": "Will you damage my lock or door to get me inside?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Our technicians are trained in non-destructive entry techniques designed to open locks without damaging them. In most residential and automotive lockouts, we use lock picks and specialized tools that leave the lock fully functional after entry. Destructive methods are a last resort and discussed with you beforehand."
        }
      },
      {
        "@type": "Question",
        "name": "What types of lockouts do you handle?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We handle all lockout types: home lockouts, car lockouts, office lockouts, storage unit lockouts, and more. We also carry replacement locks in our van if needed and can rekey or replace a lock on the same visit."
        }
      },
      {
        "@type": "Question",
        "name": "How much does emergency lockout service cost in Delaware?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pricing depends on the type of lockout, time of day, and what services are needed. We provide upfront pricing before any work begins — no surprise fees. Call (302) 735-0050 for an immediate quote based on your specific situation."
        }
      },
      {
        "@type": "Question",
        "name": "Do I need to prove I own the property or vehicle?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For security purposes, our technicians may ask for identification or proof of residence or vehicle ownership before completing service. This protects you and the property. Please have your ID and any vehicle registration or property documents available if possible."
        }
      },
      {
        "@type": "Question",
        "name": "Can you rekey my locks after a lockout?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. If your lockout was caused by a lost key or you have security concerns, we can rekey your locks immediately following the lockout service on the same visit. This invalidates any lost keys and gives you new keys without replacing the hardware."
        }
      },
      {
        "@type": "Question",
        "name": "Do you serve all of Kent County, Delaware?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We serve all of Kent County including Dover, Smyrna, Milford, Camden, Harrington, Felton, Frederica, Wyoming, Clayton, Magnolia, and surrounding communities. Call us wherever you are and we will get to you as fast as possible."
        }
      }
    ]
  })} />

  <!-- Hero -->
  <section
    class="relative min-h-[340px] md:min-h-[500px] flex items-center text-white py-10 md:py-20"
    style="background-image: url('/images/emergency-lockout.png'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0 bg-black/72"></div>
    <div class="relative max-w-6xl mx-auto px-5 md:px-6 z-10">
      <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-xs md:text-sm mb-2 md:mb-4">Emergency Lockout Service — Delaware</p>
      <h1 class="text-2xl sm:text-3xl md:text-5xl font-bold mb-3 md:mb-6 max-w-3xl leading-tight">
        Emergency Lockout Service in Delaware — Fast Response, Any Lock, Any Time
      </h1>
      <p class="text-gray-300 text-sm md:text-lg max-w-2xl leading-relaxed mb-5 md:mb-8">
        Locked out of your home, car, or office? 1st Capital Locksmith provides emergency lockout service throughout Delaware with fast dispatch, professional non-destructive entry techniques, and upfront pricing. We are on the way the moment you call.
      </p>
      <div class="flex flex-wrap gap-3 md:gap-4">
        <a
          href="tel:3027350050"
          class="inline-flex items-center rounded-full bg-[#A61E22] px-6 py-3 md:px-8 md:py-4 text-white font-bold text-base md:text-lg hover:bg-[#8C181B] transition"
        >
          Call (302) 735-0050
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center rounded-full border border-white px-6 py-3 md:px-8 md:py-4 text-white font-semibold text-sm md:text-base hover:bg-white hover:text-[#1A1F22] transition"
        >
          Get Help Now
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Fast Response</p>
          <p class="text-gray-300 text-sm mt-1">Available 6 Days a Week</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">20–30 Min ETA</p>
          <p class="text-gray-300 text-sm mt-1">Fast Dispatch Across Kent County</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">All Lockout Types</p>
          <p class="text-gray-300 text-sm mt-1">Home, Car, Office & More</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Upfront Pricing</p>
          <p class="text-gray-300 text-sm mt-1">No Hidden Fees or Surprises</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Delaware's Emergency Lockout Specialists</p>
          <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-6 leading-snug">
            Professional Emergency Lockout Service Across Delaware
          </h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            Being locked out is one of those situations where every minute counts — whether you are locked out of your home, car, or office. 1st Capital Locksmith specializes in fast, professional emergency lockout response throughout Delaware so that you are never waiting longer than necessary.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            Our technicians are trained in non-destructive entry techniques for all common residential, commercial, and automotive locks. That means we open your lock using professional tools — picks, decoders, and specialized entry equipment — without damaging the door, frame, or lock itself. In the vast majority of lockouts, your lock is fully functional after we open it.
          </p>
          <p class="text-gray-700 leading-relaxed">
            We serve all of Kent County and surrounding areas including <a href="/service-areas/dover-de/" class="text-[#A61E22] hover:underline font-medium">Dover</a>, <a href="/service-areas/smyrna-de/" class="text-[#A61E22] hover:underline font-medium">Smyrna</a>, <a href="/service-areas/milford-de/" class="text-[#A61E22] hover:underline font-medium">Milford</a>, <a href="/service-areas/camden-de/" class="text-[#A61E22] hover:underline font-medium">Camden</a>, <a href="/service-areas/harrington-de/" class="text-[#A61E22] hover:underline font-medium">Harrington</a>, <a href="/service-areas/felton-de/" class="text-[#A61E22] hover:underline font-medium">Felton</a>, and beyond. Call (302) 735-0050 and a technician is dispatched immediately — day or night.
          </p>
        </div>
        <div class="space-y-6">
          <div class="rounded-2xl overflow-hidden border border-gray-200 bg-[#F8F8F5] aspect-[4/3] flex items-center justify-center">
            <img
              src="/images/emergency-lockout-service.png"
              alt="Emergency lockout service technician in Delaware"
              class="w-full h-full object-cover"
              width="600"
              height="450"
              loading="lazy"
            />
          </div>
          <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200">
            <h3 class="text-xl font-bold text-[#1A1F22] mb-6">We Handle All Lockout Situations:</h3>
            <ul class="space-y-3">
              {[
                "Locked Out of Home or Apartment",
                "Keys Locked Inside Your Car",
                "Office or Commercial Lockout",
                "Lost House or Car Keys",
                "Broken Key in Lock",
                "Malfunctioning or Jammed Lock",
                "Storage Unit or Padlock Lockout",
                "Safe Lockout",
                "After-Hours or Holiday Lockout",
                "Post-Lockout Rekeying Available",
              ].map((item) => (
                <li class="flex items-center gap-3 text-gray-700">
                  <span class="w-6 h-6 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="mt-6 pt-6 border-t border-gray-200">
              <a
                href="tel:3027350050"
                class="w-full inline-flex justify-center items-center rounded-full bg-[#A61E22] px-6 py-3 text-white font-bold hover:bg-[#8C181B] transition"
              >
                Call (302) 735-0050 Now
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Types Detail -->
  <section id="services" class="bg-[#F8F8F5] py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-14">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">All Lockout Types Covered</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-4">Emergency Lockout Services We Provide</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          From residential house lockouts to commercial office entry and automotive lockouts, our technicians are trained and equipped to handle any situation — 6 days a week.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

        <!-- Card 1 -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition">
          <div class="w-14 h-14 bg-[#A61E22]/10 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 9.75L12 3l9 6.75V21a.75.75 0 01-.75.75H3.75A.75.75 0 013 21V9.75z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[#1A1F22] mb-4">Emergency House Lockout</h3>
          <p class="text-gray-600 leading-relaxed mb-3">
            Locked out of your home? We respond fast to residential lockouts throughout Delaware. Our technicians use professional pick sets and bypass tools to open your door without damage, getting you back inside quickly and safely.
          </p>
          <p class="text-gray-600 leading-relaxed mb-3">
            We handle standard knob locks, deadbolts, lever handles, and most keypad or smart lock overrides. Whether you are at your primary residence or a rental property, we get you in. See our dedicated <a href="/services/emergency-house-lockout/" class="text-[#A61E22] hover:underline font-medium">emergency house lockout service</a> page for more detail.
          </p>
          <p class="text-gray-600 leading-relaxed">
            After entry, we recommend <a href="/services/lock-rekeying/" class="text-[#A61E22] hover:underline font-medium">rekeying your locks</a> if keys were lost, or a <a href="/services/lock-change/" class="text-[#A61E22] hover:underline font-medium">lock change</a> if the hardware is damaged or you want an upgrade.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition">
          <div class="w-14 h-14 bg-[#A61E22]/10 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[#1A1F22] mb-4">Emergency Car Lockout</h3>
          <p class="text-gray-600 leading-relaxed mb-3">
            Keys locked in your car? Left them on the seat, trunk, or ignition? We handle emergency car lockouts for all makes and models throughout Delaware. Our automotive entry tools open modern vehicles without damage to door seals, weather stripping, or locking mechanisms.
          </p>
          <p class="text-gray-600 leading-relaxed mb-3">
            We work on sedans, SUVs, trucks, and minivans using slim jim tools, long reach equipment, and air wedge systems appropriate for the vehicle type and door configuration. Visit our <a href="/services/emergency-car-lockout/" class="text-[#A61E22] hover:underline font-medium">emergency car lockout page</a> for vehicle-specific details.
          </p>
          <p class="text-gray-600 leading-relaxed">
            If your key broke inside the door lock or ignition, we also provide <a href="/services/broken-key-extraction/" class="text-[#A61E22] hover:underline font-medium">broken key extraction</a> on the same visit — no need to call a second technician.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition">
          <div class="w-14 h-14 bg-[#A61E22]/10 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[#1A1F22] mb-4">Office & Commercial Lockout</h3>
          <p class="text-gray-600 leading-relaxed mb-3">
            Locked out of your office, storefront, or commercial property? Business lockouts cost money every minute the doors stay closed. We prioritize commercial calls and dispatch quickly so you can get your business operating with minimal downtime.
          </p>
          <p class="text-gray-600 leading-relaxed mb-3">
            We handle all commercial door hardware including mortise locks, cylindrical locksets, electronic access control bypasses, and panic bar entry issues. Our technicians are familiar with commercial-grade hardware from brands like Schlage, Medeco, Corbin Russwin, and more.
          </p>
          <p class="text-gray-600 leading-relaxed">
            After gaining entry, we can assess your <a href="/services/office-lockout/" class="text-[#A61E22] hover:underline font-medium">office lockout</a> situation and recommend whether a <a href="/services/commercial-lock-rekeying/" class="text-[#A61E22] hover:underline font-medium">commercial rekey</a> or lock upgrade is the right next step.
          </p>
        </div>

        <!-- Card 4 -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition">
          <div class="w-14 h-14 bg-[#A61E22]/10 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[#1A1F22] mb-4">Lost Key & Lockout Combination</h3>
          <p class="text-gray-600 leading-relaxed mb-3">
            When a lockout is caused by a truly lost key — not just a key left inside — the problem extends beyond simply opening the door. Anyone who finds that key, especially if it has an address tag or is linked to your vehicle registration, could potentially gain access to your property.
          </p>
          <p class="text-gray-600 leading-relaxed mb-3">
            In these situations, we recommend combining the lockout service with an immediate <a href="/services/lock-rekeying/" class="text-[#A61E22] hover:underline font-medium">lock rekey</a>. Rekeying changes the internal pin configuration of your lock so the lost key no longer works — all in one visit, with no need to replace the hardware.
          </p>
          <p class="text-gray-600 leading-relaxed">
            For higher security needs or significantly outdated hardware, we can also install new <a href="/services/deadbolt-installation/" class="text-[#A61E22] hover:underline font-medium">deadbolts</a> on the same visit. We carry a selection of residential and commercial grade hardware in our van.
          </p>
        </div>

        <!-- Card 5 -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition">
          <div class="w-14 h-14 bg-[#A61E22]/10 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[#1A1F22] mb-4">Broken Key Lockout</h3>
          <p class="text-gray-600 leading-relaxed mb-3">
            A broken key creates a double problem — not only are you locked out, but there is now a fragment of metal lodged inside your lock that prevents any key from working. This type of lockout requires a different approach than a standard entry job, and attempting to remove a broken key with improvised tools almost always makes things worse.
          </p>
          <p class="text-gray-600 leading-relaxed mb-3">
            Our technicians carry dedicated <a href="/services/broken-key-extraction/" class="text-[#A61E22] hover:underline font-medium">broken key extraction</a> tools that remove fragments cleanly from lock cylinders without damaging the internal mechanism. In most cases the lock can then be used normally once the fragment is removed.
          </p>
          <p class="text-gray-600 leading-relaxed">
            If the break occurred inside a car ignition, we assess whether the ignition needs <a href="/services/ignition-repair/" class="text-[#A61E22] hover:underline font-medium">repair</a> or full replacement. We handle both on-site so you are not stranded.
          </p>
        </div>

        <!-- Card 6 -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition">
          <div class="w-14 h-14 bg-[#A61E22]/10 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
