---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="Emergency Locksmith in Delaware | 24/7 Lockout Service | 1st Capital Locksmith"
  description="1st Capital Locksmith provides 24/7 emergency locksmith services throughout Delaware. Fast response for home lockouts, car lockouts, broken key extraction, safe lockouts, and after-hours urgent locksmith help across Kent County, DE."
>

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li>
          <a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <a href="/services" class="hover:text-[#A61E22] transition font-medium">Services</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-[#A61E22] font-semibold">Emergency Locksmith</span>
        </li>
      </ol>
    </div>
  </nav>

  <!-- Schema Markup for Breadcrumbs -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.1stcapitallocksmith.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.1stcapitallocksmith.com/services/" },
      { "@type": "ListItem", "position": 3, "name": "Emergency Locksmith", "item": "https://www.1stcapitallocksmith.com/services/emergency-locksmith/" }
    ]
  })} />

  <!-- Hero -->
  <section
    class="relative min-h-[340px] md:min-h-[550px] flex items-center text-white py-10 md:py-20"
    style="background-image: url('/images/emergency-locksmith.jpg'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative max-w-6xl mx-auto px-5 md:px-6 z-10">
      <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-xs md:text-sm mb-2 md:mb-4">24/7 Emergency Locksmith Services</p>
      <h1 class="text-2xl sm:text-3xl md:text-5xl font-bold mb-3 md:mb-6 max-w-3xl leading-tight">
        Emergency Locksmith in Delaware — Fast Response, Any Time of Day or Night
      </h1>
      <p class="text-gray-300 text-sm md:text-lg max-w-2xl leading-relaxed mb-5 md:mb-8">
        Locked out of your home at midnight? Keys locked inside your car? Broken key stuck in your lock? 1st Capital Locksmith responds fast to emergency locksmith calls throughout Delaware — 24 hours a day, 7 days a week. We come directly to you.
      </p>
      <div class="flex flex-wrap gap-3 md:gap-4">
        <a
          href="tel:3027350050"
          class="inline-flex items-center rounded-full bg-[#A61E22] px-6 py-3 md:px-8 md:py-4 text-white font-bold text-base md:text-lg hover:bg-[#8C181B] transition"
        >
          Call (302) 735-0050 Now
        </a>
        <a
          href="/contact"
          class="inline-flex items-center rounded-full border border-white px-6 py-3 md:px-8 md:py-4 text-white font-semibold text-sm md:text-base hover:bg-white hover:text-[#1A1F22] transition"
        >
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">24/7</p>
          <p class="text-gray-300 text-sm mt-1">Available Day & Night, Every Day</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Mobile</p>
          <p class="text-gray-300 text-sm mt-1">We Come Directly to Your Location</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Fast</p>
          <p class="text-gray-300 text-sm mt-1">Rapid Response Across Delaware</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Upfront</p>
          <p class="text-gray-300 text-sm mt-1">Clear Pricing Before We Start</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Delaware's Emergency Locksmith</p>
          <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-6 leading-snug">
            24/7 Emergency Locksmith Services Throughout Delaware
          </h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            Lock and key emergencies have a way of happening at the worst possible times — late at night, early in the morning, on weekends, and on holidays. That's why 1st Capital Locksmith is available around the clock to respond to emergency locksmith calls throughout Delaware. No matter when you call, a real person will answer and a technician will be on the way.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            We handle all types of lock and key emergencies — from residential lockouts and car lockouts to broken key extractions, safe lockouts, and urgent lock repairs following a break-in. Our mobile locksmiths are equipped to handle each situation professionally and efficiently, with the goal of getting you back to normal as quickly as possible.
          </p>
          <p class="text-gray-700 leading-relaxed">
            We serve customers throughout Dover, Milford, Smyrna, Camden, Harrington, and all of Kent County, Delaware. When a lock or key emergency strikes, don't panic — just call us and we'll take care of it.
          </p>
        </div>
        <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200">
          <h3 class="text-xl font-bold text-[#1A1F22] mb-6">Our Emergency Locksmith Services Include:</h3>
          <ul class="space-y-3">
            {[
              "Emergency House Lockout Service",
              "Emergency Car Lockout Service",
              "Emergency Business Lockout Service",
              "Broken Key Extraction",
              "Safe Lockout Service",
              "After-Hours Lock Repair",
              "Damaged Lock Emergency Replacement",
              "Post Break-In Emergency Service",
            ].map((item) => (
              <li class="flex items-center gap-3 text-gray-700">
                <span class="w-6 h-6 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
          <div class="mt-6 pt-6 border-t border-gray-200">
            <a
              href="tel:3027350050"
              class="w-full inline-flex justify-center items-center rounded-full bg-[#A61E22] px-6 py-3 text-white font-bold hover:bg-[#8C181B] transition"
            >
              Call (302) 735-0050 Now
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Detail -->
  <section id="services" class="bg-[#F8F8F5] py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-14">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">What We Do</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-4">
          Emergency Locksmith Services in Delaware
        </h2>
        <p class="text-gray-700 max-w-3xl mx-auto leading-relaxed">
          Here is a detailed look at every emergency locksmith service we provide throughout Delaware. Whatever your situation, we're ready to help — day or night.
        </p>
      </div>

      <div class="space-y-8">

        <!-- Emergency House Lockout -->
        <div id="house-lockout" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 9.75L12 3l9 6.75V21a1 1 0 01-1 1H4a1 1 0 01-1-1V9.75z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 22V12h6v10" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Emergency House Lockout Service in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Being locked out of your own home is one of those situations that immediately puts you on edge — especially late at night, in the cold or rain, or when you have children or pets inside waiting for you. It's stressful, it feels urgent, and the last thing you need is to wait hours for help to arrive.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              1st Capital Locksmith responds to emergency house lockouts throughout Delaware around the clock. Our locksmiths use professional non-destructive entry methods to get you back inside without damaging your door, frame, or lock hardware. We work on all types of residential locks including standard deadbolts, knob locks, lever handles, and electronic keypad entry systems.
            </p>
            <p class="text-gray-700 leading-relaxed">
              No matter what time it is or what brought you to this situation, just call us. We'll dispatch as quickly as possible and get you back inside your home safely.
            </p>
          </div>
        </div>

        <!-- Emergency Car Lockout -->
        <div id="car-lockout" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10l2 2h7l1-2zM13 6h3l3 4v4h-2" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Emergency Car Lockout Service in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Locking your keys inside your car is one of the most common roadside emergencies — and it always seems to happen at the most inconvenient time. Whether your keys are sitting on the seat in plain sight, you've lost them entirely, or your key fob has stopped working, 1st Capital Locksmith responds quickly to car lockouts throughout Delaware.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              Our mobile locksmiths carry the professional tools needed to open vehicles without causing any damage to your door, window, or lock mechanism. We work on all makes and models including cars, trucks, vans, and SUVs. If you're in a parking lot, on the side of the road, at home, or anywhere else in Delaware, we'll come to your location.
            </p>
            <p class="text-gray-700 leading-relaxed">
              If there's a child or pet locked inside your vehicle, please call 911 first. Once the immediate emergency is handled, we're here to help with the lock itself.
            </p>
          </div>
        </div>

        <!-- Emergency Business Lockout -->
        <div id="business-lockout" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V7a2 2 0 00-2-2H7a2 2 0 00-2 2v14M3 21h18M9 21v-4a1 1 0 011-1h4a1 1 0 011 1v4" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Emergency Business Lockout Service in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              A commercial lockout doesn't keep business hours. Whether you arrive at your office before sunrise and discover you left your keys at home, or a lock malfunctions right before your business opens, the impact is immediate — lost time, lost productivity, and frustrated employees or customers waiting outside.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              1st Capital Locksmith handles emergency commercial lockouts throughout Delaware at any hour. We respond to offices, retail stores, restaurants, warehouses, and all other types of commercial properties. Our locksmiths use professional non-destructive entry methods to get your business open quickly without any damage to your door or hardware.
            </p>
            <p class="text-gray-700 leading-relaxed">
              After gaining entry, we can also assess your lock and recommend a repair or replacement on the spot if the hardware is the source of the problem — so you're not dealing with the same issue again tomorrow.
            </p>
          </div>
        </div>

        <!-- Broken Key Extraction -->
        <div id="broken-key" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Broken Key Extraction in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              A key that snaps off inside a lock is one of those problems that looks simple but can quickly become complicated if handled the wrong way. Attempting to dig the broken piece out yourself with a paperclip, bobby pin, or knife blade almost always makes things worse — pushing the fragment deeper into the cylinder or damaging the lock mechanism in the process.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              1st Capital Locksmith provides professional broken key extraction throughout Delaware. Our locksmiths use specialized extraction tools designed specifically for this job — removing the broken key fragment cleanly without damaging the lock. In most cases the lock can be saved entirely, and we can cut you a new key on the spot if needed.
            </p>
            <p class="text-gray-700 leading-relaxed">
              Broken key extractions happen in door locks, car ignitions, padlocks, and safe locks. Whatever type of lock your key broke in, we can handle it. Call us before you make the situation worse — we'll get it sorted quickly.
            </p>
          </div>
        </div>

        <!-- Safe Lockout -->
        <div id="safe-lockout" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Safe Lockout Service in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Safes are built to resist unauthorized access — which means when you lose the combination, forget the code, or the locking mechanism malfunctions, getting back inside is genuinely difficult without professional help. Whether it's a home safe, a gun safe, a fireproof document safe, or a commercial safe, 1st Capital Locksmith provides safe lockout service throughout Delaware.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              Our locksmiths are experienced with a wide range of safe types and locking mechanisms including combination dial safes, electronic keypad safes, and key-operated safes. We assess each situation carefully and use the most appropriate method to gain access — with the goal of preserving the safe and its contents whenever possible.
            </p>
            <p class="text-gray-700 leading-relaxed">
              If your safe's electronic keypad has died, your combination has been forgotten, or the mechanism has jammed, don't force it. Call 1st Capital Locksmith and we'll handle it properly.
            </p>
          </div>
        </div>

        <!-- Post Break-In Emergency -->
        <div id="post-breakin" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Post Break-In Emergency Service in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Discovering that your home or business has been broken into is an unsettling experience. Beyond the emotional impact, you're also left with a very practical and urgent problem — damaged locks, a compromised door, and a property that isn't secure until the hardware is repaired or replaced. This is exactly the kind of situation where a fast emergency locksmith response matters most.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              1st Capital Locksmith provides emergency post break-in service throughout Delaware. We respond quickly to repair or replace damaged locks, reinforce compromised entry points, and get your property secured as fast as possible. We work on residential and commercial properties and carry quality lock hardware on our vehicles so repairs can happen on the same visit.
            </p>
            <p class="text-gray-700 leading-relaxed">
              After a break-in, we can also walk through your property with you and make security recommendations to help reduce the risk of it happening again. Your safety is the priority — call us and we'll be there quickly.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Why Choose Us</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-4">
          Why Delaware Residents Call 1st Capital Locksmith First
        </h2>
        <p class="text-gray-700 max-w-3xl mx-auto leading-relaxed">
          In an emergency, you need a locksmith you can count on — someone who shows up fast, handles the job properly, and doesn't take advantage of a stressful situation. Here's why people throughout Delaware trust us.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200">
          <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-bold text-[#1A1F22] text-lg mb-2">Available 24 Hours a Day</h3>
          <p class="text-gray-700 text-sm leading-relaxed">Lock emergencies don't wait for business hours, and neither do we. We answer calls and dispatch technicians around the clock — including nights, weekends, and holidays.</p>
        </div>

        <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200">
          <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="font-bold text-[#1A1F22] text-lg mb-2">Fast Dispatch to Your Location</h3>
          <p class="text-gray-700 text-sm leading-relaxed">We dispatch mobile locksmiths quickly to homes, vehicles, and businesses throughout Delaware. We know that in an emergency, every minute counts.</p>
        </div>

        <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200">
          <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-bold text-[#1A1F22] text-lg mb-2">Honest Emergency Pricing</h3>
          <p class="text-gray-700 text-sm leading-relaxed">We provide clear, upfront pricing before any work begins — even in an emergency. We never take advantage of stressful situations with hidden fees or inflated after-hours charges.</p>
        </div>

        <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200">
          <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="font-bold text-[#1A1F22] text-lg mb-2">Non-Destructive Entry Methods</h3>
          <p class="text-gray-700 text-sm leading-relaxed">Our locksmiths are trained in professional non-destructive entry techniques, which means we get you back in without damaging your door, frame, window, or lock hardware.</p>
        </div>

        <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200">
