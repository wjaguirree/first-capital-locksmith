---
import MainLayout from "../../../../layouts/MainLayout.astro";
import { locations } from "../../../../data/locations";
import type { Location } from "../../../../data/locations";

export function getStaticPaths() {
  return locations.map((loc) => ({
    params: { location: loc.slug },
    props: { location: loc },
  }));
}

interface Props { location: Location; }
const { location } = Astro.props;
const { city, state, slug, county } = location;
---

<MainLayout
  title={`Key Fob Programming in ${city}, ${state} | Remote & Smart Key | 1st Capital Locksmith`}
  description={`Key fob programming and replacement in ${city}, ${state}. 1st Capital Locksmith programs all types of key fobs and remote start fobs on-site throughout ${city} and ${county}, Delaware. Call (302) 735-0050.`}
>

  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li><a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href="/services" class="hover:text-[#A61E22] transition font-medium">Services</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href={`/services/automotive-locksmith/${slug}`} class="hover:text-[#A61E22] transition font-medium">Automotive Locksmith in {city}</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><span class="text-[#A61E22] font-semibold">Key Fob Programming — {city}, {state}</span></li>
      </ol>
    </div>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.1stcapitallocksmith.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.1stcapitallocksmith.com/services/" },
      { "@type": "ListItem", "position": 3, "name": `Automotive Locksmith in ${city}`, "item": `https://www.1stcapitallocksmith.com/services/automotive-locksmith/${slug}/` },
      { "@type": "ListItem", "position": 4, "name": `Key Fob Programming in ${city}, ${state}`, "item": `https://www.1stcapitallocksmith.com/services/automotive-locksmith/${slug}/key-fob-programming/` }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "LocalBusiness",
    "@id": "https://www.1stcapitallocksmith.com",
    "name": "1st Capital Locksmith", "telephone": "+13027350050",
    "url": `https://www.1stcapitallocksmith.com/services/automotive-locksmith/${slug}/key-fob-programming/`,
    "description": `Key fob programming and replacement in ${city}, ${state}. On-site programming for all remote fob types and all vehicle makes and models throughout ${county}, Delaware.`,
    "areaServed": { "@type": "City", "name": city, "containedInPlace": { "@type": "State", "name": "Delaware" } },
    "priceRange": "$$"
  })} />

  <section class="relative min-h-[420px] flex items-center py-12 md:py-20" style="background-image: url('/images/key-fob-programming.jpg'); background-size: cover; background-position: center;">
  <div class="absolute inset-0 bg-[#0E1B2F]/85"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 w-full">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Automotive Locksmith · {city}, {state}</p>
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Key Fob Programming in {city}, {state}</h1>
          <p class="text-gray-300 mb-6 leading-relaxed">
            1st Capital Locksmith programs and replaces key fobs on-site throughout {city} and {county}. Whether your fob stopped working, was lost, or needs a second fob added, we handle all remote fob types for all major vehicle brands — at your location, not at a dealership.
          </p>
          <ul class="space-y-3">
            {[
              { label: "Standard Remote Key Fob Programming", href: "/services/key-fob-programming" },
              { label: "Smart Key / Proximity Fob Programming", href: "/services/key-fob-programming" },
              { label: "Remote Start Fob Programming", href: "/services/key-fob-programming" },
              { label: "Replacement Fob Sourcing & Programming", href: "/services/key-fob-programming" },
              { label: "Additional Fob Programming (2nd, 3rd Key)", href: "/services/key-fob-programming" },
              { label: "Transponder Key Replacement", href: "/services/car-key-replacement" },
              { label: "Car Key Cutting & Programming", href: "/services/car-key-replacement" },
            ].map(({ label, href }) => (
              <li class="flex items-center gap-3 text-gray-300">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <a href={href} class="hover:text-white hover:underline transition">{label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-[#1A2B45] rounded-2xl p-8 border border-[#2A3B55]">
          <h2 class="text-xl font-bold text-white mb-5">On-Site Fob Programming in {city}</h2>
          <div class="space-y-4">
            {[
              { title: "No Dealership Needed", desc: "We program your fob on-site at your location in " + city + " — faster and more affordable than a dealership visit." },
              { title: "All Fob Types", desc: "Standard remotes, smart fobs, proximity keys, flip keys, and remote start fobs for all brands." },
              { title: "All Major Brands", desc: `Toyota, Honda, Ford, GM, Chrysler, Nissan, Hyundai, Kia, BMW, Mercedes, VW, and more in ${city}.` },
              { title: "Lost Fob Replacement", desc: "We can source and program a replacement fob if your original is lost or damaged." },
            ].map((item) => (
              <div class="flex gap-3 items-start">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <div><p class="font-semibold text-white text-sm">{item.title}</p><p class="text-gray-400 text-sm">{item.desc}</p></div>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-6 border-t border-[#2A3B55]">
            <a href="tel:3027350050" class="block text-center bg-[#A61E22] text-white font-bold rounded-full py-3 px-6 hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div><p class="text-2xl font-bold text-[#A61E22]">All Makes</p><p class="text-gray-300 text-sm mt-1">Domestic & Import Vehicles</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Mobile</p><p class="text-gray-300 text-sm mt-1">We Come to {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Fast</p><p class="text-gray-300 text-sm mt-1">Quick Response in {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">No Damage</p><p class="text-gray-300 text-sm mt-1">Professional Entry Tools</p></div>
      </div>
    </div>
  </section>

  <section class="bg-[#F8F8F5] py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Fob Programming Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">Key Fob Programming Services in {city}, {state}</h2>
        <p class="text-gray-600 max-w-2xl mx-auto text-sm">We handle all types of key fob programming for all vehicle makes and models throughout {city}, Delaware.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Standard Remote Key Fob</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Standard key fobs control your car's locks remotely and often include a panic button and trunk release. When a fob stops working, it can be due to a dead battery, a pairing issue, or internal damage. We diagnose the issue, replace the battery if that's the fix, or program a new fob to your vehicle's system on-site in {city}.</p>
          <div class="mt-4"><a href="/services/key-fob-programming" class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Key Fob Programming →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Smart Key & Proximity Fob</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Smart keys and proximity fobs (used with push-button start vehicles) require advanced OBD programming equipment. These fobs must be registered to your vehicle's immobilizer and keyless entry system. We program smart fobs for Toyota, Honda, Ford, GM, Chrysler, Nissan, Hyundai, Kia, and most other major brands throughout {city}.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Remote Start Fob Programming</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Many modern vehicles include factory remote start capability built into the key fob. We program remote start fobs on-site in {city}, including situations where a fob with remote start is being replaced or a second fob is being added to the vehicle. Not all vehicles support remote start — we can advise during your service call.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Replacement Fob — Lost or Damaged</h3>
          <p class="text-gray-600 text-sm leading-relaxed">If you've lost a key fob or it's been damaged beyond repair, we can source a compatible replacement and program it to your vehicle on-site in {city}. We work with all OEM-compatible fob blanks and program them to your car's specifications. In most cases, we can complete lost fob replacement in a single visit.</p>
          <div class="mt-4"><a href="/services/car-key-replacement" class="text-[#A61E22] font-semibold hover:underline text-sm">See also: Car Key Replacement in {city} →</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">More Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">More Locksmith Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <a href={`/services/automotive-locksmith/${slug}`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Automotive Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full automotive locksmith services in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/car-key-replacement`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Car Key Replacement in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Transponder key cutting and programming for all vehicle makes in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/car-lockout`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Car Lockout Service in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast non-destructive car lockout service throughout {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/ignition-repair`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Ignition Repair in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Ignition cylinder diagnosis and repair in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/ignition-replacement`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Ignition Replacement in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full ignition cylinder replacement in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/emergency-car-lockout`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Car Lockout in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency car lockout response in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Residential Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">House lockouts, lock rekeying, and deadbolts in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency locksmith response in {city}.</p>
        </a>
        <a href={`/service-areas/${slug}`} class="bg-[#A61E22] rounded-2xl p-6 border border-[#A61E22] hover:bg-[#8C181B] transition">
          <h3 class="font-bold text-white text-base mb-2">All Services in {city}, {state}</h3>
          <p class="text-white/80 text-sm">View all locksmith services available in {city}, {state}.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Need Key Fob Programming in {city}, {state}?</h2>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto mb-8">Call 1st Capital Locksmith for on-site key fob programming and replacement in {city}. We come to you — all fob types, all vehicle makes.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:3027350050" class="inline-flex items-center rounded-full bg-[#A61E22] px-8 py-4 text-white font-bold text-lg hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
        <a href="/contact" class="inline-flex items-center rounded-full border border-white px-8 py-4 text-white font-semibold hover:bg-white hover:text-[#1A1F22] transition">Get a Free Quote</a>
      </div>
    </div>
  </section>

</MainLayout>
