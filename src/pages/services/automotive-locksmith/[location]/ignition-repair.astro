---
import MainLayout from "../../../../layouts/MainLayout.astro";
import LocationLocalFlavor from "../../../../components/LocationLocalFlavor.astro";
import { sp, compose2, townAnchor } from "../../../../data/serviceCopy";
import { locations } from "../../../../data/locations";
import type { Location } from "../../../../data/locations";

export function getStaticPaths() {
  return locations.map((loc) => ({
    params: { location: loc.slug },
    props: { location: loc },
  }));
}

interface Props { location: Location; }
const { location } = Astro.props;
const { city, state, slug, county } = location;

const heroP = sp(slug, "hero", [
  `1st Capital Locksmith provides mobile ignition repair throughout ${city} and ${county}. We diagnose and repair stuck, stiff, worn, and damaged ignition cylinders on-site — for all vehicle makes and models, without the need for a tow.`,
  `A key that won't turn — or won't come out — is an ignition problem, and in ${city} it's one we fix at your location. 1st Capital Locksmith repairs stuck, worn, and damaged ignition cylinders on-site throughout ${county}.`,
  `Ignition trouble strands you where you sit. 1st Capital Locksmith's mobile technicians diagnose and repair ignition cylinders wherever your vehicle is in ${city} — all makes and models, no tow required.`,
  `When your ignition sticks, binds, or stops turning in ${city}, don't force it. Our mobile locksmiths repair ignition cylinders on-site across ${city} and ${county} — usually saving the cylinder and always saving you the tow.`,
]);

const card1 = compose2(slug, "card-1", {
  open: [
    `A key that won't turn in the ignition is one of the most common automotive locksmith calls we receive in ${city}.`,
    `The top ignition call in ${city}: a key that suddenly refuses to turn, or turns only after a fight.`,
    `Stuck, stiff, or grinding ignition keys are daily calls for our ${city} technicians.`,
    `When an ignition stops cooperating in ${city}, the cause is usually mechanical wear — and usually repairable.`,
  ],
  close: [
    `The cause is often worn tumblers inside the cylinder, a bent key, debris inside the cylinder, or the steering column lock engaging. We diagnose the root cause and repair the cylinder on-site whenever possible, without requiring replacement.`,
    `Worn tumblers, a bent key, cylinder debris, or an engaged steering lock — we diagnose the actual cause and repair on-site whenever the cylinder can be saved.`,
    `We trace the problem — tumblers, key wear, debris, or steering lock — and fix the cylinder where it sits, avoiding replacement whenever repair works.`,
    townAnchor(slug, "automotive", "card-1"),
  ],
});

const card2 = sp(slug, "card-2", [
  `A key broken off inside the ignition is a stressful situation — and attempting to remove it with tweezers, glue, or improvised tools almost always makes it worse. We use dedicated extraction tools to safely remove the broken fragment without damaging the cylinder internals. After extraction, we can cut a new key and assess the cylinder for damage.`,
  `When a key snaps off in the ignition, tweezers and glue are the enemy — they push the fragment deeper and can destroy the wafers. Our extraction tools are purpose-built to slide the fragment out cleanly. Once it's out, we cut a new key and check the cylinder for damage, all on-site in ${city}.`,
  `A broken key in the ignition looks catastrophic but usually isn't — if the fragment comes out the right way. We use dedicated extraction tools that protect the cylinder internals, then cut your replacement key on the spot anywhere in ${city}.`,
  `Keys break in ignitions after years of wear, and the DIY extraction attempt is usually what turns a small job into a cylinder replacement. We extract fragments with professional tools, assess the cylinder, and cut a new key — one visit, anywhere in ${city}.`,
]);

const card3 = sp(slug, "card-3", [
  `If your ignition cylinder is in good mechanical condition but you need it to work with a different key — for example after a key is lost — we can rekey the cylinder's internal tumblers to match a new key. This is a more cost-effective option than full ignition replacement. We perform ignition rekeying on-site throughout ${city} for most vehicle makes and models.`,
  `When the cylinder is mechanically sound but the key situation has changed — a lost key, a security concern — rekeying the ignition is cheaper than replacing it. We re-pin the tumblers to a new key on-site in ${city}, for most makes and models.`,
  `Lost a key but the ignition itself is fine? Rekeying the cylinder to a new key costs less than replacement and restores your security. We do it at your ${city} location for most vehicles.`,
  `Ignition rekeying solves the 'lost key, healthy cylinder' situation without the cost of a new cylinder. Our technicians re-pin the tumblers to match a fresh key, on-site throughout ${city}.`,
]);

const card4 = sp(slug, "card-4", [
  `Some ignition cylinders are too worn, cracked, or damaged to repair — in those cases, replacement is the correct solution. We assess the cylinder honestly and only recommend replacement when repair is not a viable option. When replacement is needed, we handle the ignition replacement and new key programming on the same visit in ${city}.`,
  `We'll tell you honestly when a cylinder is past saving — cracks, severe corrosion, or damage from forced entry mean replacement is the right call. When that happens, we replace the cylinder and program the new key in the same ${city} visit.`,
  `Repair first, replace only when necessary — that's our approach in ${city}. Cylinders that are cracked or damaged beyond repair get replaced on-site, with the new key cut and programmed before we leave.`,
  `Not every cylinder can be repaired, and we won't pretend otherwise. If yours is too far gone, we handle the full replacement and key programming on-site in ${city} during the same visit.`,
]);

const ctaP = sp(slug, "cta", [
  `Call 1st Capital Locksmith for mobile ignition diagnosis and repair in ${city}. We come to you — no tow needed.`,
  `Ignition trouble in ${city}? One call brings a mobile locksmith to your vehicle — diagnosis, repair, and keys handled on-site.`,
  `Don't force a sticking key. Call now and we'll repair the ignition where your car sits in ${city}.`,
]);
---

<MainLayout
  title={`Ignition Repair in ${city}, ${state} | 1st Capital Locksmith`}
  description={`Ignition repair in ${city}, ${state} for stuck, worn, or damaged cylinders, on-site. Call (302) 735-0050.`}
>

  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li><a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href={`/services/automotive-locksmith/${slug}/`} class="hover:text-[#A61E22] transition font-medium">Automotive Locksmith in {city}</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><span class="text-[#A61E22] font-semibold">Ignition Repair — {city}, {state}</span></li>
      </ol>
    </div>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://1stcapitallocksmithde.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://1stcapitallocksmithde.com/services/" },
      { "@type": "ListItem", "position": 3, "name": `Automotive Locksmith in ${city}`, "item": `https://1stcapitallocksmithde.com/services/automotive-locksmith/${slug}/` },
      { "@type": "ListItem", "position": 4, "name": `Ignition Repair in ${city}, ${state}`, "item": `https://1stcapitallocksmithde.com/services/automotive-locksmith/${slug}/ignition-repair/` }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "LocalBusiness",
    "@id": "https://1stcapitallocksmithde.com",
    "name": "1st Capital Locksmith", "telephone": "+13027350050",
    "url": "https://1stcapitallocksmithde.com",
    "address": { "@type": "PostalAddress", "streetAddress": "2089 S Dupont Hwy #2", "addressLocality": "Dover", "addressRegion": "DE", "postalCode": "19901", "addressCountry": "US" },
    "geo": { "@type": "GeoCoordinates", "latitude": "39.1212111", "longitude": "-75.5331705" },
    "description": `Ignition cylinder repair in ${city}, ${state}. Diagnosis and repair of stuck, worn, and damaged ignition cylinders for all vehicle makes throughout ${county}, Delaware.`,
    "areaServed": { "@type": "City", "name": city, "containedInPlace": { "@type": "State", "name": "Delaware" } },
    "priceRange": "$$"
  })} />

  <!-- Schema: Service -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "Service",
    "name": `Ignition Repair in ${city}, ${state}`,
    "serviceType": "Ignition Repair",
    "provider": { "@type": "LocalBusiness", "name": "1st Capital Locksmith", "telephone": "+13027350050", "url": "https://1stcapitallocksmithde.com" },
    "areaServed": { "@type": "City", "name": city, "containedInPlace": { "@type": "State", "name": "Delaware" } }
  })} />

  <section class="relative min-h-105 flex items-center py-12 md:py-20" style="background-image: url('/images/ignition-repair-technician.jpg'); background-size: cover; background-position: center;">
  <div class="absolute inset-0 bg-[#0E1B2F]/85"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 w-full">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Automotive Locksmith · {city}, {state}</p>
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Ignition Repair in {city}, {state}</h1>
          <p class="text-gray-300 mb-6 leading-relaxed">
            {heroP}
          </p>
          <ul class="space-y-3">
            {[
              { label: "Stuck or Stiff Ignition Cylinder Repair", href: "/services/ignition-repair" },
              { label: "Ignition Cylinder Diagnosis", href: "/services/ignition-repair" },
              { label: "Broken Key Extraction from Ignition", href: "/services/broken-key-extraction" },
              { label: "Ignition Rekeying", href: "/services/ignition-repair" },
              { label: "Worn Tumbler Replacement", href: "/services/ignition-repair" },
              { label: "Ignition Cylinder Replacement", href: "/services/ignition-replacement" },
              { label: "New Key Cutting After Repair", href: "/services/car-key-replacement" },
            ].map(({ label, href }) => (
              <li class="flex items-center gap-3 text-gray-300">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <a href={href} class="hover:text-white hover:underline transition">{label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-[#1A2B45] rounded-2xl p-8 border border-[#2A3B55]">
          <h2 class="text-xl font-bold text-white mb-5">Mobile Ignition Repair in {city}</h2>
          <div class="space-y-4">
            {[
              { title: "On-Site Diagnosis", desc: "We come to your location in " + city + " and diagnose the ignition issue before recommending a repair or replacement." },
              { title: "Repair vs Replace", desc: "Many ignition problems can be repaired without full replacement, saving you significant cost." },
              { title: "All Vehicle Makes", desc: `Domestic and import vehicles throughout ${city} and ${county}, Delaware.` },
              { title: "Key Extraction Included", desc: "We remove broken key fragments from the ignition safely as part of our ignition repair service." },
            ].map((item) => (
              <div class="flex gap-3 items-start">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <div><p class="font-semibold text-white text-sm">{item.title}</p><p class="text-gray-400 text-sm">{item.desc}</p></div>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-6 border-t border-[#2A3B55]">
            <a href="tel:3027350050" class="block text-center bg-[#A61E22] text-white font-bold rounded-full py-3 px-6 hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div><p class="text-2xl font-bold text-[#A61E22]">All Makes</p><p class="text-gray-300 text-sm mt-1">Domestic & Import Vehicles</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Mobile</p><p class="text-gray-300 text-sm mt-1">We Come to {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Fast</p><p class="text-gray-300 text-sm mt-1">Quick Response in {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">No Damage</p><p class="text-gray-300 text-sm mt-1">Professional Entry Tools</p></div>
      </div>
    </div>
  </section>

  <section class="bg-[#F8F8F5] py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Ignition Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">Ignition Repair Services in {city}, {state}</h2>
        <p class="text-gray-600 max-w-2xl mx-auto text-sm">We diagnose and repair all types of ignition issues for vehicles throughout {city}, Delaware.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Stuck or Stiff Ignition Repair</h3>
          <p class="text-gray-600 text-sm leading-relaxed">{card1}</p>
          <div class="mt-4"><a href="/services/ignition-repair/" class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Ignition Repair →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Broken Key Extraction from Ignition</h3>
          <p class="text-gray-600 text-sm leading-relaxed">{card2}</p>
          <div class="mt-4"><a href="/services/broken-key-extraction/" class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Broken Key Extraction →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Ignition Rekeying</h3>
          <p class="text-gray-600 text-sm leading-relaxed">{card3}</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">When Repair Becomes Replacement</h3>
          <p class="text-gray-600 text-sm leading-relaxed">{card4}</p>
          <div class="mt-4"><a href={`/services/automotive-locksmith/${slug}/ignition-replacement/`} class="text-[#A61E22] font-semibold hover:underline text-sm">See Ignition Replacement in {city} →</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">More Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">More Locksmith Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <a href={`/services/automotive-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Automotive Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full automotive locksmith services in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/ignition-replacement/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Ignition Replacement in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full ignition cylinder replacement when repair is not an option in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/car-key-replacement/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Car Key Replacement in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">On-site transponder key cutting and programming in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/broken-key-extraction/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Broken Key Extraction in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Safe removal of broken key fragments from ignition and door cylinders in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/car-lockout/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Car Lockout Service in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast non-destructive car lockout service in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/key-fob-programming/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Key Fob Programming in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Key fob replacement and programming in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Residential Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">House lockouts, rekeying, and deadbolts in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency locksmith response in {city}.</p>
        </a>
        <a href={`/service-areas/${slug}/`} class="bg-[#A61E22] rounded-2xl p-6 border border-[#A61E22] hover:bg-[#8C181B] transition">
          <h3 class="font-bold text-white text-base mb-2">All Services in {city}, {state}</h3>
          <p class="text-white/80 text-sm">View all locksmith services in {city}, {state}.</p>
        </a>
      </div>
    </div>
  </section>

  <LocationLocalFlavor location={location} variant="automotive" />

  <section class="bg-[#0E1B2F] py-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Need Ignition Repair in {city}, {state}?</h2>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto mb-8">Call 1st Capital Locksmith for on-site ignition diagnosis and repair in {city}. We come to your vehicle — no tow required.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:3027350050" class="inline-flex items-center rounded-full bg-[#A61E22] px-8 py-4 text-white font-bold text-lg hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
        <a href="/contact/" class="inline-flex items-center rounded-full border border-white px-8 py-4 text-white font-semibold hover:bg-white hover:text-[#1A1F22] transition">Get a Free Quote</a>
      </div>
    </div>
  </section>

</MainLayout>


