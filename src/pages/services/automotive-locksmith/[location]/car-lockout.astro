---
import MainLayout from "../../../../layouts/MainLayout.astro";
import { locations } from "../../../../data/locations";
import type { Location } from "../../../../data/locations";

export function getStaticPaths() {
  return locations.map((loc) => ({
    params: { location: loc.slug },
    props: { location: loc },
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;
const { city, state, slug, county } = location;
---

<MainLayout
  title={`Car Lockout Service in ${city}, ${state} | Mobile Car Lockout | 1st Capital Locksmith`}
  description={`Locked out of your car in ${city}, ${state}? 1st Capital Locksmith provides fast mobile car lockout service throughout ${city} and ${county}. Non-destructive entry for all makes and models. Call (302) 735-0050.`}
>

  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li><a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a></li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          <a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          <a href={`/services/automotive-locksmith/${slug}`} class="hover:text-[#A61E22] transition font-medium">Automotive Locksmith in {city}</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          <span class="text-[#A61E22] font-semibold">Car Lockout — {city}, {state}</span>
        </li>
      </ol>
    </div>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.1stcapitallocksmith.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.1stcapitallocksmith.com/services/" },
      { "@type": "ListItem", "position": 3, "name": `Automotive Locksmith in ${city}`, "item": `https://www.1stcapitallocksmith.com/services/automotive-locksmith/${slug}/` },
      { "@type": "ListItem", "position": 4, "name": `Car Lockout Service in ${city}, ${state}`, "item": `https://www.1stcapitallocksmith.com/services/automotive-locksmith/${slug}/car-lockout/` }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "https://www.1stcapitallocksmith.com",
    "name": "1st Capital Locksmith",
    "telephone": "+13027350050",
    "url": `https://www.1stcapitallocksmith.com/services/automotive-locksmith/${slug}/car-lockout/`,
    "description": `Mobile car lockout service in ${city}, ${state}. Fast, non-destructive entry for all vehicle makes and models throughout ${city} and ${county}, Delaware.`,
    "areaServed": { "@type": "City", "name": city, "containedInPlace": { "@type": "State", "name": "Delaware" } },
    "priceRange": "$$"
  })} />

  <section class="relative min-h-[420px] flex items-center py-12 md:py-20" style="background-image: url('/images/car-lockout-technician.jpg'); background-size: cover; background-position: center;">
  <div class="absolute inset-0 bg-[#0E1B2F]/85"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 w-full">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Automotive Locksmith · {city}, {state}</p>
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Car Lockout Service in {city}, {state}</h1>
          <p class="text-gray-300 mb-6 leading-relaxed">
            1st Capital Locksmith provides fast mobile car lockout service throughout {city} and {county}. We respond promptly, use professional non-destructive entry tools, and get you back in your vehicle quickly — without damage to your car or its finish.
          </p>
          <ul class="space-y-3">
            {[
              { label: "Car Door Lockout — All Makes & Models", href: "/services/car-lockout" },
              { label: "Truck & SUV Lockout Service", href: "/services/car-lockout" },
              { label: "Keys Locked in Trunk", href: "/services/car-lockout" },
              { label: "Keys Locked with Engine Running", href: "/services/emergency-car-lockout" },
              { label: "Damaged or Frozen Car Lock", href: "/services/car-lockout" },
              { label: "Commercial & Fleet Vehicle Lockout", href: "/services/car-lockout" },
              { label: "Emergency Car Lockout Response", href: "/services/emergency-car-lockout" },
            ].map(({ label, href }) => (
              <li class="flex items-center gap-3 text-gray-300">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <a href={href} class="hover:text-white hover:underline transition">{label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-[#1A2B45] rounded-2xl p-8 border border-[#2A3B55]">
          <h2 class="text-xl font-bold text-white mb-5">Why Choose 1st Capital Locksmith in {city}?</h2>
          <div class="space-y-4">
            {[
              { title: "Non-Destructive Entry", desc: "Professional automotive opening tools — no drilling, no damage to your vehicle." },
              { title: "All Vehicle Types", desc: `Cars, trucks, SUVs, vans, and commercial vehicles — all makes and models served in ${city}.` },
              { title: "Mobile Service", desc: `We come directly to your location anywhere in ${city} and surrounding ${county}.` },
              { title: "Fast Response", desc: "Call us and we dispatch immediately — we aim to get to you as quickly as possible." },
            ].map((item) => (
              <div class="flex gap-3 items-start">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <div>
                  <p class="font-semibold text-white text-sm">{item.title}</p>
                  <p class="text-gray-400 text-sm">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-6 border-t border-[#2A3B55]">
            <a href="tel:3027350050" class="block text-center bg-[#A61E22] text-white font-bold rounded-full py-3 px-6 hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div><p class="text-2xl font-bold text-[#A61E22]">All Makes</p><p class="text-gray-300 text-sm mt-1">Domestic & Import Vehicles</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Mobile</p><p class="text-gray-300 text-sm mt-1">We Come to {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Fast</p><p class="text-gray-300 text-sm mt-1">Quick Response in {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">No Damage</p><p class="text-gray-300 text-sm mt-1">Professional Entry Tools</p></div>
      </div>
    </div>
  </section>

  <section class="bg-[#F8F8F5] py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">What We Do in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">Car Lockout Services in {city}, {state}</h2>
        <p class="text-gray-600 max-w-2xl mx-auto text-sm">We handle all types of vehicle lockout situations throughout {city} using professional automotive entry tools.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Car Door Lockout</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Whether your keys are on the seat, in a bag, or simply misplaced, we respond throughout {city} with professional automotive opening tools — slim jims, air wedges, long-reach tools — to open your door without damage. We work on all major brands: Honda, Toyota, Ford, Chevrolet, Dodge, Nissan, Hyundai, Kia, BMW, Mercedes, and more.</p>
          <div class="mt-4"><a href="/services/car-lockout/" class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Car Lockout Service →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Truck & SUV Lockout</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Larger vehicles require specialized tools and techniques. Our mobile locksmith units serving {city} are equipped for Ford F-Series, Chevy Silverado, RAM trucks, full-size SUVs like Suburban and Expedition, minivans, and cargo vans. We work on both traditional key-entry and modern push-button start vehicles.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Keys Locked in Trunk</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Many vehicles don't have a trunk release accessible from the passenger compartment without the key fob. We can open the vehicle door first and access the trunk release, or in some cases open the trunk directly. If your trunk lock mechanism is damaged or malfunctioning, we can assess that during the same service call in {city}.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Emergency Car Lockout</h3>
          <p class="text-gray-600 text-sm leading-relaxed">When a child or pet is locked inside a hot vehicle, or you're stranded in an unsafe location, call us immediately at <a href="tel:3027350050" class="text-[#A61E22] font-semibold">(302) 735-0050</a>. We serve all of {city} and {county}. Don't attempt DIY entry — improper tools routinely cause expensive damage to door frames and lock mechanisms.</p>
          <div class="mt-4"><a href="/services/emergency-car-lockout/" class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Emergency Car Lockout →</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">More Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">More Locksmith Services in {city}, {state}</h2>
        <p class="text-gray-600 max-w-2xl mx-auto text-sm">1st Capital Locksmith provides automotive, residential, commercial, and emergency locksmith services throughout {city}, Delaware.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <a href={`/services/automotive-locksmith/${slug}`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Automotive Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full automotive locksmith services in {city} — car lockouts, key replacement, key fob programming, and ignition repair.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/car-key-replacement`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Car Key Replacement in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">On-site transponder key cutting and programming for all vehicle makes and models in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/key-fob-programming`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Key Fob Programming in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Key fob replacement and programming for all major vehicle brands in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/ignition-repair`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Ignition Repair in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Ignition cylinder diagnosis, repair, and broken key extraction for vehicles in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/ignition-replacement`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Ignition Replacement in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full ignition cylinder replacement for all vehicle makes and models in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/emergency-car-lockout`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Car Lockout in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency car lockout response for urgent situations throughout {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Residential Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">House lockouts, lock rekeying, deadbolt installation, and lock repair in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency locksmith response for any lockout or urgent lock situation in {city}.</p>
        </a>
        <a href={`/service-areas/${slug}`} class="bg-[#A61E22] rounded-2xl p-6 border border-[#A61E22] hover:bg-[#8C181B] transition">
          <h3 class="font-bold text-white text-base mb-2">All Locksmith Services in {city}, {state}</h3>
          <p class="text-white/80 text-sm">View our complete list of locksmith services available in {city}, {state}.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Locked Out of Your Car in {city}, {state}?</h2>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto mb-8">Call 1st Capital Locksmith now for fast, professional car lockout service in {city}. We come to you — mobile service throughout {county}.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:3027350050" class="inline-flex items-center rounded-full bg-[#A61E22] px-8 py-4 text-white font-bold text-lg hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
        <a href="/contact/" class="inline-flex items-center rounded-full border border-white px-8 py-4 text-white font-semibold hover:bg-white hover:text-[#1A1F22] transition">Get a Free Quote</a>
      </div>
    </div>
  </section>

</MainLayout>
