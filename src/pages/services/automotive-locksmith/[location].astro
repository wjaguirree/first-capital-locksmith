---
import MainLayout from "../../../layouts/MainLayout.astro";
import { locations } from "../../../data/locations";
import type { Location } from "../../../data/locations";

export function getStaticPaths() {
  return locations.map((loc) => ({
    params: { location: loc.slug },
    props: { location: loc },
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;
const { city, state, slug, county, description } = location;
---

<MainLayout
  title={`Automotive Locksmith in ${city}, ${state} | Car Lockout & Key Replacement | 1st Capital Locksmith`}
  description={`1st Capital Locksmith provides fast mobile automotive locksmith services in ${city}, ${state}. Car lockouts, car key replacement, transponder key programming, key fob programming, and ignition repair in ${city}, DE.`}
>

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li>
          <a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <a href="/services/automotive-locksmith/" class="hover:text-[#A61E22] transition font-medium">Automotive Locksmith</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-[#A61E22] font-semibold">{city}, {state}</span>
        </li>
      </ol>
    </div>
  </nav>

  <!-- Schema: Breadcrumb -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.1stcapitallocksmith.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.1stcapitallocksmith.com/services/" },
      { "@type": "ListItem", "position": 3, "name": "Automotive Locksmith", "item": "https://www.1stcapitallocksmith.com/services/automotive-locksmith/" },
      { "@type": "ListItem", "position": 4, "name": `${city}, ${state}`, "item": `https://www.1stcapitallocksmith.com/services/automotive-locksmith/${slug}/` }
    ]
  })} />

  <!-- Schema: Local Business -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "1st Capital Locksmith",
    "telephone": "+13027350050",
    "url": "https://www.1stcapitallocksmith.com",
    "areaServed": { "@type": "City", "name": city, "containedIn": { "@type": "State", "name": "Delaware" } },
    "serviceType": ["Automotive Locksmith", "Car Lockout", "Car Key Replacement", "Transponder Key Programming", "Key Fob Programming", "Ignition Repair"]
  })} />

  <!-- Hero -->
  <section
    class="relative min-h-[340px] md:min-h-[550px] flex items-center text-white py-10 md:py-20"
    style="background-image: url('/images/car-lockout-technician.jpg'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative max-w-6xl mx-auto px-5 md:px-6 z-10">
      <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-xs md:text-sm mb-2 md:mb-4">Automotive Locksmith in {city}, Delaware</p>
      <h1 class="text-2xl sm:text-3xl md:text-5xl font-bold mb-3 md:mb-6 max-w-3xl leading-tight">
        Automotive Locksmith in {city}, {state} — Car Lockouts, Key Replacement & More
      </h1>
      <p class="text-gray-300 text-sm md:text-lg max-w-2xl leading-relaxed mb-5 md:mb-8">
        Locked out of your car in {city}? Lost your car keys? Need a key fob programmed on-site? 1st Capital Locksmith provides fast, professional mobile automotive locksmith services throughout {city}, Delaware. We come directly to your location — no tow required.
      </p>
      <div class="flex flex-wrap gap-3 md:gap-4">
        <a
          href="tel:3027350050"
          class="inline-flex items-center rounded-full bg-[#A61E22] px-6 py-3 md:px-8 md:py-4 text-white font-bold text-base md:text-lg hover:bg-[#8C181B] transition"
        >
          Call (302) 735-0050
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center rounded-full border border-white px-6 py-3 md:px-8 md:py-4 text-white font-semibold text-sm md:text-base hover:bg-white hover:text-[#1A1F22] transition"
        >
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">All Makes</p>
          <p class="text-gray-300 text-sm mt-1">Domestic & Foreign Vehicles</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Mobile</p>
          <p class="text-gray-300 text-sm mt-1">We Come to {city}</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Fast</p>
          <p class="text-gray-300 text-sm mt-1">Quick Response in {city}, DE</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Upfront</p>
          <p class="text-gray-300 text-sm mt-1">Clear Pricing Before We Start</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Your Mobile Auto Locksmith in {city}</p>
          <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-6 leading-snug">
            Professional Automotive Locksmith Services in {city}, {state}
          </h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            {city} is {description}, and 1st Capital Locksmith is here to serve drivers throughout {city} with fast, professional automotive locksmith services. Whether you've locked your keys inside your car, lost your transponder key, or need a key fob programmed on the spot, we come directly to your location anywhere in {city} — no tow required.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            Our mobile automotive locksmiths serve {city} and all of {county} with the same professional tools and techniques used by dealerships — at a fraction of the cost and with the convenience of on-site service. No appointments, no waiting rooms, no tow trucks.
          </p>
          <p class="text-gray-700 leading-relaxed">
            Call us at <a href="tel:3027350050" class="text-[#A61E22] font-semibold hover:underline">(302) 735-0050</a> for immediate automotive locksmith service in {city}, {state}.
          </p>
