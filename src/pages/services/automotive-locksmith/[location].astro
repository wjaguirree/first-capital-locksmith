          <ul class="space-y-3">
            {[
              { label: "Car Lockout Service", href: `/services/automotive-locksmith/${slug}/car-lockout` },
              { label: "Car Key Replacement", href: `/services/automotive-locksmith/${slug}/car-key-replacement` },
              { label: "Transponder Key Cutting & Programming", href: `/services/automotive-locksmith/${slug}/car-key-replacement` },
              { label: "Key Fob Programming & Replacement", href: `/services/automotive-locksmith/${slug}/key-fob-programming` },
              { label: "Smart Key & Push-to-Start Programming", href: `/services/automotive-locksmith/${slug}/key-fob-programming` },
              { label: "Ignition Repair & Replacement", href: `/services/automotive-locksmith/${slug}/ignition-repair` },
              { label: "Broken Key Extraction", href: `/services/emergency-locksmith/${slug}/broken-key-extraction` },
              { label: "Duplicate Car Key Made On-Site", href: `/services/automotive-locksmith/${slug}/car-key-replacement` },
            ].map(({ label, href }) => (
              <li class="flex items-center gap-3 text-gray-700">
                <span class="w-6 h-6 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <a href={href} class="hover:text-[#A61E22] hover:underline transition">{label}</a>
              </li>
            ))}
          </ul>
          <div class="mt-6 pt-6 border-t border-gray-200">
            <a
              href="tel:3027350050"
              class="w-full inline-flex justify-center items-center rounded-full bg-[#A61E22] px-6 py-3 text-white font-bold hover:bg-[#8C181B] transition"
            >
              Call (302) 735-0050 Now
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Detail -->
  <section class="bg-[#F8F8F5] py-20">
