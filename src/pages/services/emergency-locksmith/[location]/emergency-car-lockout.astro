---
import MainLayout from "../../../../layouts/MainLayout.astro";
import { locations } from "../../../../data/locations";
import type { Location } from "../../../../data/locations";

export function getStaticPaths() {
  return locations.map((loc) => ({
    params: { location: loc.slug },
    props: { location: loc },
  }));
}

interface Props { location: Location; }
const { location } = Astro.props;
const { city, state, slug, county } = location;
---

<MainLayout
  title={`Emergency Car Lockout in ${city}, ${state} | Keys Locked in Car | 1st Capital Locksmith`}
  description={`Emergency car lockout service in ${city}, ${state}. Keys locked in your car? 1st Capital Locksmith responds fast throughout ${city} and ${county}, Delaware. All makes and models. Call: (302) 735-0050.`}
>

  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li><a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href={`/services/emergency-locksmith/${slug}`} class="hover:text-[#A61E22] transition font-medium">Emergency Locksmith in {city}</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><span class="text-[#A61E22] font-semibold">Emergency Car Lockout — {city}, {state}</span></li>
      </ol>
    </div>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.1stcapitallocksmith.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.1stcapitallocksmith.com/services/" },
      { "@type": "ListItem", "position": 3, "name": `Emergency Locksmith in ${city}`, "item": `https://www.1stcapitallocksmith.com/services/emergency-locksmith/${slug}/` },
      { "@type": "ListItem", "position": 4, "name": `Emergency Car Lockout in ${city}, ${state}`, "item": `https://www.1stcapitallocksmith.com/services/emergency-locksmith/${slug}/emergency-car-lockout/` }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "LocalBusiness",
    "@id": "https://www.1stcapitallocksmith.com",
    "name": "1st Capital Locksmith", "telephone": "+13027350050",
    "url": `https://www.1stcapitallocksmith.com/services/emergency-locksmith/${slug}/emergency-car-lockout/`,
    "description": `Emergency car lockout service in ${city}, ${state}. Fast automotive lockout response for all makes and models throughout ${county}, Delaware.`,
    "areaServed": { "@type": "City", "name": city, "containedInPlace": { "@type": "State", "name": "Delaware" } },
    "priceRange": "$$"
  })} />

  <section class="relative min-h-[420px] flex items-center py-12 md:py-20" style="background-image: url('/images/car-lockout-delaware.jpg'); background-size: cover; background-position: center;">
  <div class="absolute inset-0 bg-[#A61E22]/85"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 w-full">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-white/80 font-semibold uppercase tracking-wide text-sm mb-3">Emergency Locksmith · {city}, {state}</p>
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Emergency Car Lockout in {city}, {state}</h1>
          <p class="text-white/90 mb-6 leading-relaxed">
            Keys locked in your car in {city}? Keys in the trunk? Engine running with the doors locked? 1st Capital Locksmith responds fast to automotive lockouts throughout {city} and {county}. We use professional auto entry tools — no damage to your vehicle.
          </p>
          <ul class="space-y-3">
            {[
              { label: "Keys Locked Inside the Car", href: "/services/emergency-car-lockout" },
              { label: "Keys in the Trunk", href: "/services/emergency-car-lockout" },
              { label: "Engine Running with Doors Locked", href: "/services/emergency-car-lockout" },
              { label: "Broken Key in Car Lock or Ignition", href: "/services/broken-key-extraction" },
              { label: "All Makes & Models — Domestic & Import", href: "/services/emergency-car-lockout" },
              { label: "Cars, Trucks, SUVs, Vans", href: "/services/emergency-car-lockout" },
              { label: "Roadside & Parking Lot Lockout", href: "/services/emergency-car-lockout" },
            ].map(({ label, href }) => (
              <li class="flex items-center gap-3 text-white/90">
                <span class="w-5 h-5 bg-white rounded-full flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <a href={href} class="hover:text-white hover:underline transition">{label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-white rounded-2xl p-8">
          <h2 class="text-xl font-bold text-[#1A1F22] mb-5">Car Lockout in {city} — Call Now</h2>
          <div class="space-y-4">
            {[
              { title: "Fast Response Throughout " + city, desc: "We respond to automotive lockouts throughout " + city + " and " + county + ". Tell us your exact location when you call." },
              { title: "No Vehicle Damage", desc: "Professional auto entry tools designed for modern vehicles — no broken seals, no scratched doors." },
              { title: "All Makes & Models", desc: "Cars, trucks, SUVs, and vans — domestic and import — standard and keyless entry systems." },
              { title: "Safe Location Protocol", desc: "If you're in an unsafe location, stay in your vehicle with doors locked and call us. We'll respond fast." },
            ].map((item) => (
              <div class="flex gap-3 items-start">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <div><p class="font-semibold text-[#1A1F22] text-sm">{item.title}</p><p class="text-gray-500 text-sm">{item.desc}</p></div>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-6 border-t border-gray-200">
            <a href="tel:3027350050" class="block text-center bg-[#A61E22] text-white font-bold rounded-full py-3 px-6 hover:bg-[#8C181B] transition">Call (302) 735-0050 Now</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#1A1F22] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div><p class="text-2xl font-bold text-[#A61E22]">Fast</p><p class="text-gray-300 text-sm mt-1">Emergency Response in {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Mobile</p><p class="text-gray-300 text-sm mt-1">We Come to You</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">No Damage</p><p class="text-gray-300 text-sm mt-1">Professional Entry Tools</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Any Situation</p><p class="text-gray-300 text-sm mt-1">Home Â· Car Â· Business</p></div>
      </div>
    </div>
  </section>

  <section class="bg-[#F8F8F5] py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Car Lockout Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">Emergency Car Lockout Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Keys Locked Inside the Car</h3>
          <p class="text-gray-600 text-sm leading-relaxed">The most common automotive lockout — keys sitting inside the car while the doors are locked. We use professional automotive entry tools (air wedges, long reach tools, and slim jims designed for modern vehicle door construction) to gain entry without damage. We work on cars, trucks, SUVs, and vans throughout {city} — all makes, all models, domestic and import.</p>
          <div class="mt-4"><a href="/services/emergency-car-lockout/" class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Emergency Car Lockout →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Keys in the Trunk</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Keys accidentally left in the trunk when it closed are a common lockout scenario. Depending on your vehicle, we may be able to access the trunk release from inside the cabin, or we may need to enter through the door first. Either way, we have the tools and techniques to handle trunk lockouts across all vehicle types in {city} without causing damage.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Engine Running with Doors Locked</h3>
          <p class="text-gray-600 text-sm leading-relaxed">A running engine lockout is more urgent — especially in warm weather with children or pets inside, or in situations where the vehicle is in a hazardous location. Call us immediately at <a href="tel:3027350050" class="text-[#A61E22] font-semibold">(302) 735-0050</a>. If there is an immediate safety emergency, call 911 first. We respond throughout {city} as quickly as possible.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">After the Lockout</h3>
          <p class="text-gray-600 text-sm leading-relaxed">After getting you back into your car in {city}, we can also address any related automotive key issues — key duplication, key fob programming, or ignition service. If you're worried about your existing keys being lost or compromised, we can discuss replacement options on the spot. We also provide car key replacement and transponder key service throughout {county}.</p>
          <div class="mt-4"><a href={`/services/automotive-locksmith/${slug}/car-key-replacement`} class="text-[#A61E22] font-semibold hover:underline text-sm">Car Key Replacement in {city} →</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">More Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">More Locksmith Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <a href={`/services/emergency-locksmith/${slug}`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full emergency locksmith services in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/emergency-lockout`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Lockout Service in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Home, car, and business lockouts in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/emergency-house-lockout`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency House Lockout in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency house lockout in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/car-lockout`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Car Lockout Service in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Car lockout service in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/car-key-replacement`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Car Key Replacement in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Transponder and smart key replacement in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/broken-key-extraction`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Broken Key Extraction in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Professional broken key extraction in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Automotive Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full automotive locksmith services in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Residential Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">House lockouts, rekeying, and deadbolts in {city}.</p>
        </a>
        <a href={`/service-areas/${slug}`} class="bg-[#A61E22] rounded-2xl p-6 border border-[#A61E22] hover:bg-[#8C181B] transition">
          <h3 class="font-bold text-white text-base mb-2">All Services in {city}, {state}</h3>
          <p class="text-white/80 text-sm">View all locksmith services in {city}, {state}.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-[#A61E22] py-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Keys Locked in Your Car in {city}, {state}?</h2>
      <p class="text-white/90 text-lg max-w-2xl mx-auto mb-8">Call 1st Capital Locksmith for fast emergency car lockout service in {city}. We respond throughout {county}, Delaware — all makes and models.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:3027350050" class="inline-flex items-center rounded-full bg-white text-[#A61E22] px-8 py-4 font-bold text-lg hover:bg-gray-100 transition">Call (302) 735-0050</a>
        <a href="/contact/" class="inline-flex items-center rounded-full border border-white px-8 py-4 text-white font-semibold hover:bg-white hover:text-[#A61E22] transition">Get Help Now</a>
      </div>
    </div>
  </section>

</MainLayout>
