---
import MainLayout from "../../../../layouts/MainLayout.astro";
import { locations } from "../../../../data/locations";
import type { Location } from "../../../../data/locations";

export function getStaticPaths() {
  return locations.map((loc) => ({
    params: { location: loc.slug },
    props: { location: loc },
  }));
}

interface Props { location: Location; }
const { location } = Astro.props;
const { city, state, slug, county } = location;
---

<MainLayout
  title={`Emergency Lockout in ${city}, ${state} | 1st Capital Locksmith`}
  description={`Emergency lockout service in ${city}, ${state} for home, car & business. Call any time: (302) 735-0050.`}
>

  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li><a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href={`/services/emergency-locksmith/${slug}/`} class="hover:text-[#A61E22] transition font-medium">Emergency Locksmith in {city}</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><span class="text-[#A61E22] font-semibold">Emergency Lockout — {city}, {state}</span></li>
      </ol>
    </div>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://1stcapitallocksmithde.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://1stcapitallocksmithde.com/services/" },
      { "@type": "ListItem", "position": 3, "name": `Emergency Locksmith in ${city}`, "item": `https://1stcapitallocksmithde.com/services/emergency-locksmith/${slug}/` },
      { "@type": "ListItem", "position": 4, "name": `Emergency Lockout Service in ${city}, ${state}`, "item": `https://1stcapitallocksmithde.com/services/emergency-locksmith/${slug}/emergency-lockout/` }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "LocalBusiness",
    "@id": "https://1stcapitallocksmithde.com",
    "name": "1st Capital Locksmith", "telephone": "+13027350050",
    "url": "https://1stcapitallocksmithde.com",
    "address": { "@type": "PostalAddress", "streetAddress": "2089 S Dupont Hwy #2", "addressLocality": "Dover", "addressRegion": "DE", "postalCode": "19901", "addressCountry": "US" },
    "geo": { "@type": "GeoCoordinates", "latitude": "39.1212111", "longitude": "-75.5331705" },
    "description": `Emergency lockout service in ${city}, ${state}. Fast response for home, car, and business lockouts throughout ${county}, Delaware.`,
    "areaServed": { "@type": "City", "name": city, "containedInPlace": { "@type": "State", "name": "Delaware" } },
    "priceRange": "$$"
  })} />

  <!-- Schema: Service -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "Service",
    "name": `Emergency Lockout Service in ${city}, ${state}`,
    "serviceType": "Emergency Lockout Service",
    "provider": { "@type": "LocalBusiness", "name": "1st Capital Locksmith", "telephone": "+13027350050", "url": "https://1stcapitallocksmithde.com" },
    "areaServed": { "@type": "City", "name": city, "containedInPlace": { "@type": "State", "name": "Delaware" } }
  })} />

  <section class="relative min-h-105 flex items-center py-12 md:py-20" style="background-image: url('/images/emergency-locksmith.jpg'); background-size: cover; background-position: center;">
  <div class="absolute inset-0 bg-[#A61E22]/85"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 w-full">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-white/80 font-semibold uppercase tracking-wide text-sm mb-3">Emergency Locksmith · {city}, {state}</p>
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Emergency Lockout Service in {city}, {state}</h1>
          <p class="text-white/90 mb-6 leading-relaxed">
            Locked out of your home, car, or business in {city}? 1st Capital Locksmith responds fast to emergency lockouts throughout {city} and {county}. Call us any time — we come to you.
          </p>
          <ul class="space-y-3">
            {[
              { label: "Home Lockout — Locked Out of Your House", href: "/services/emergency-house-lockout" },
              { label: "Car Lockout — Keys Locked Inside", href: "/services/emergency-car-lockout" },
              { label: "Business & Office Lockout", href: "/services/office-lockout" },
              { label: "Apartment Lockout", href: "/services/emergency-house-lockout" },
              { label: "Broken Key in Lock", href: "/services/broken-key-extraction" },
              { label: "After-Hours Emergency Response", href: "/services/emergency-locksmith" },
              { label: "Safe Lockout", href: "/services/safe-lockout-services" },
            ].map(({ label, href }) => (
              <li class="flex items-center gap-3 text-white/90">
                <span class="w-5 h-5 bg-white rounded-full flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <a href={href} class="hover:text-white hover:underline transition">{label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-white rounded-2xl p-8">
          <h2 class="text-xl font-bold text-[#1A1F22] mb-5">Emergency Lockout in {city} — Call Now</h2>
          <div class="space-y-4">
            {[
              { title: "Fast Response", desc: "We respond as quickly as possible throughout " + city + " and " + county + " — tell us your location when you call." },
              { title: "Home, Car & Business", desc: "We handle all lockout types — residential, automotive, and commercial — in " + city + "." },
              { title: "Non-Destructive Entry", desc: "We use professional entry tools to get you in without damaging your locks or door hardware." },
              { title: "Professional & Verified", desc: "We verify your identity and right to access before proceeding — protecting you and your property." },
            ].map((item) => (
              <div class="flex gap-3 items-start">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <div><p class="font-semibold text-[#1A1F22] text-sm">{item.title}</p><p class="text-gray-500 text-sm">{item.desc}</p></div>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-6 border-t border-gray-200">
            <a href="tel:3027350050" class="block text-center bg-[#A61E22] text-white font-bold rounded-full py-3 px-6 hover:bg-[#8C181B] transition">Call (302) 735-0050 Now</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#1A1F22] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div><p class="text-2xl font-bold text-[#A61E22]">Fast</p><p class="text-gray-300 text-sm mt-1">Emergency Response in {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Mobile</p><p class="text-gray-300 text-sm mt-1">We Come to You</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">No Damage</p><p class="text-gray-300 text-sm mt-1">Professional Entry Tools</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Any Situation</p><p class="text-gray-300 text-sm mt-1">Home · Car · Business</p></div>
      </div>
    </div>
  </section>

  <section class="bg-[#F8F8F5] py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Emergency Lockout Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">Emergency Lockout Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Emergency House Lockout</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Locked out of your home in {city}? Whether you lost your keys, left them inside, or your lock is malfunctioning, we respond fast. We work on all residential door hardware — knob locks, lever sets, and deadbolts — without damaging your door or frame. After getting you in, we can assess whether your lock needs repair or replacement on the same visit.</p>
          <div class="mt-4"><a href={`/services/emergency-locksmith/${slug}/emergency-house-lockout/`} class="text-[#A61E22] font-semibold hover:underline text-sm">Emergency House Lockout in {city} →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Emergency Car Lockout</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Keys locked in your car in {city}? Keys in the trunk? Engine running with the door locked? We respond to automotive lockouts throughout {city} and {county} using professional auto entry tools designed for modern vehicles. We work on all makes and models, domestic and import, without causing damage to your vehicle.</p>
          <div class="mt-4"><a href={`/services/emergency-locksmith/${slug}/emergency-car-lockout/`} class="text-[#A61E22] font-semibold hover:underline text-sm">Emergency Car Lockout in {city} →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Business & Office Lockout</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Locked out of your office, retail store, or commercial property in {city}? We handle commercial lockouts on all types of commercial door hardware — cylindrical, mortise, and electronic lock systems. We work efficiently to minimize your business downtime and can address any hardware issues during the same service call.</p>
          <div class="mt-4"><a href={`/services/commercial-locksmith/${slug}/office-lockout/`} class="text-[#A61E22] font-semibold hover:underline text-sm">Office Lockout in {city} →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">What to Do When Locked Out</h3>
          <p class="text-gray-600 text-sm leading-relaxed">The moment you realize you're locked out in {city}: stay calm, move to a safe location if needed (especially for vehicle lockouts in traffic), and call <a href="tel:3027350050" class="text-[#A61E22] font-semibold">(302) 735-0050</a>. Have your location ready. We'll confirm your address, give you an estimated arrival time, and ask for basic verification that you have the right to access the property or vehicle. We will be there as fast as possible.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">More Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">More Locksmith Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <a href={`/services/emergency-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full emergency locksmith services in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/emergency-house-lockout/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency House Lockout in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency house lockout in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/emergency-car-lockout/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Car Lockout in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency car lockout in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/broken-key-extraction/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Broken Key Extraction in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Professional broken key extraction in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/safe-lockout-services/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Safe Lockout Services in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Safe and vault lockout service in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/house-lockout/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">House Lockout Service in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">House lockout service in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Residential Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full residential locksmith services in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Automotive Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Car lockouts and key replacement in {city}.</p>
        </a>
        <a href={`/service-areas/${slug}/`} class="bg-[#A61E22] rounded-2xl p-6 border border-[#A61E22] hover:bg-[#8C181B] transition">
          <h3 class="font-bold text-white text-base mb-2">All Services in {city}, {state}</h3>
          <p class="text-white/80 text-sm">View all locksmith services in {city}, {state}.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-[#A61E22] py-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Emergency Lockout in {city}, {state}?</h2>
      <p class="text-white/90 text-lg max-w-2xl mx-auto mb-8">Call 1st Capital Locksmith now for emergency lockout service in {city}. Fast response — home, car, and business lockouts throughout {county}, Delaware.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:3027350050" class="inline-flex items-center rounded-full bg-white text-[#A61E22] px-8 py-4 font-bold text-lg hover:bg-gray-100 transition">Call (302) 735-0050</a>
        <a href="/contact/" class="inline-flex items-center rounded-full border border-white px-8 py-4 text-white font-semibold hover:bg-white hover:text-[#A61E22] transition">Get Help Now</a>
      </div>
    </div>
  </section>

</MainLayout>


