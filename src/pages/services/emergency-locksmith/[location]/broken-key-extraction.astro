---
import MainLayout from "../../../../layouts/MainLayout.astro";
import { locations } from "../../../../data/locations";
import type { Location } from "../../../../data/locations";

export function getStaticPaths() {
  return locations.map((loc) => ({
    params: { location: loc.slug },
    props: { location: loc },
  }));
}

interface Props { location: Location; }
const { location } = Astro.props;
const { city, state, slug, county } = location;
---

<MainLayout
  title={`Broken Key Extraction in ${city}, ${state} | 1st Capital Locksmith`}
  description={`Key snapped in a lock or ignition in ${city}, ${state}? Fast broken key extraction. Call (302) 735-0050.`}
>

  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li><a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href={`/services/emergency-locksmith/${slug}/`} class="hover:text-[#A61E22] transition font-medium">Emergency Locksmith in {city}</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><span class="text-[#A61E22] font-semibold">Broken Key Extraction — {city}, {state}</span></li>
      </ol>
    </div>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://1stcapitallocksmithde.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://1stcapitallocksmithde.com/services/" },
      { "@type": "ListItem", "position": 3, "name": `Emergency Locksmith in ${city}`, "item": `https://1stcapitallocksmithde.com/services/emergency-locksmith/${slug}/` },
      { "@type": "ListItem", "position": 4, "name": `Broken Key Extraction in ${city}, ${state}`, "item": `https://1stcapitallocksmithde.com/services/emergency-locksmith/${slug}/broken-key-extraction/` }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "LocalBusiness",
    "@id": "https://1stcapitallocksmithde.com",
    "name": "1st Capital Locksmith", "telephone": "+13027350050",
    "url": "https://1stcapitallocksmithde.com",
    "address": { "@type": "PostalAddress", "streetAddress": "2089 S Dupont Hwy #2", "addressLocality": "Dover", "addressRegion": "DE", "postalCode": "19901", "addressCountry": "US" },
    "geo": { "@type": "GeoCoordinates", "latitude": "39.1212111", "longitude": "-75.5331705" },
    "description": `Broken key extraction in ${city}, ${state}. Professional broken key removal from door locks and car ignitions throughout ${county}, Delaware.`,
    "areaServed": { "@type": "City", "name": city, "containedInPlace": { "@type": "State", "name": "Delaware" } },
    "priceRange": "$$"
  })} />

  <!-- Schema: Service -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "Service",
    "name": `Broken Key Extraction in ${city}, ${state}`,
    "serviceType": "Broken Key Extraction",
    "provider": { "@type": "LocalBusiness", "name": "1st Capital Locksmith", "telephone": "+13027350050", "url": "https://1stcapitallocksmithde.com" },
    "areaServed": { "@type": "City", "name": city, "containedInPlace": { "@type": "State", "name": "Delaware" } }
  })} />

  <section class="relative min-h-105 flex items-center py-12 md:py-20" style="background-image: url('/images/broken-key-door-extraction.jpg'); background-size: cover; background-position: center;">
  <div class="absolute inset-0 bg-[#A61E22]/85"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 w-full">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-white/80 font-semibold uppercase tracking-wide text-sm mb-3">Emergency Locksmith · {city}, {state}</p>
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Broken Key Extraction in {city}, {state}</h1>
          <p class="text-white/90 mb-6 leading-relaxed">
            Key snapped off in a lock or ignition in {city}? Don't try to dig it out with tools that weren't designed for the job — that usually makes it worse. 1st Capital Locksmith removes broken keys from door locks, deadbolts, and car ignitions throughout {city} and {county} using professional extraction tools.
          </p>
          <ul class="space-y-3">
            {[
              { label: "Broken Key in Door Lock (Deadbolt, Knob, Lever)", href: "/services/broken-key-extraction" },
              { label: "Broken Key in Car Ignition", href: "/services/ignition-repair" },
              { label: "Key Snapped at the Lock Face", href: "/services/broken-key-extraction" },
              { label: "Key Fragment Deep Inside Cylinder", href: "/services/broken-key-extraction" },
              { label: "Key Replacement After Extraction", href: "/services/broken-key-extraction" },
              { label: "Lock Assessment After Extraction", href: "/services/lock-repair" },
              { label: "Emergency Response — Locked Out", href: "/services/emergency-lockout" },
            ].map(({ label, href }) => (
              <li class="flex items-center gap-3 text-white/90">
                <span class="w-5 h-5 bg-white rounded-full flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <a href={href} class="hover:text-white hover:underline transition">{label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-white rounded-2xl p-8">
          <h2 class="text-xl font-bold text-[#1A1F22] mb-5">Broken Key Service in {city}</h2>
          <div class="space-y-4">
            {[
              { title: "Professional Extraction Tools", desc: "We use purpose-built broken key extractors — not improvised tools that damage your lock cylinder." },
              { title: "Door Locks & Car Ignitions", desc: "Residential deadbolts, knob locks, lever sets, and automotive ignition cylinders in " + city + "." },
              { title: "New Key Cut After Extraction", desc: "We cut a new key from your lock profile after removing the broken fragment so you're not left without a key." },
              { title: "Lock Assessment Included", desc: "After extraction, we assess the lock for damage — and can repair or replace it on the same visit in " + city + "." },
            ].map((item) => (
              <div class="flex gap-3 items-start">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <div><p class="font-semibold text-[#1A1F22] text-sm">{item.title}</p><p class="text-gray-500 text-sm">{item.desc}</p></div>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-6 border-t border-gray-200">
            <a href="tel:3027350050" class="block text-center bg-[#A61E22] text-white font-bold rounded-full py-3 px-6 hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#1A1F22] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div><p class="text-2xl font-bold text-[#A61E22]">Fast</p><p class="text-gray-300 text-sm mt-1">Emergency Response in {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Mobile</p><p class="text-gray-300 text-sm mt-1">We Come to You</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">No Damage</p><p class="text-gray-300 text-sm mt-1">Professional Entry Tools</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Any Situation</p><p class="text-gray-300 text-sm mt-1">Home · Car · Business</p></div>
      </div>
    </div>
  </section>

  <section class="bg-[#F8F8F5] py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Broken Key Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">Broken Key Extraction Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Broken Key in Door Lock</h3>
          <p class="text-gray-600 text-sm leading-relaxed">A key can snap in a lock cylinder for several reasons: a worn or fatigued key, an icy or frozen lock, a stiff or dry cylinder, or simply the wrong angle of force when turning. The fragment gets lodged in the lock profile and prevents normal operation. We use broken key extractor hooks to grip and remove the fragment cleanly. After extraction, we cut you a new key from the original lock profile in {city}.</p>
          <div class="mt-4"><a href="/services/broken-key-extraction/" class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Broken Key Extraction →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Broken Key in Car Ignition</h3>
          <p class="text-gray-600 text-sm leading-relaxed">An ignition cylinder is longer and often more challenging to extract from than a door lock — the key travels deeper into the ignition and the fragment may be in a turned position. We use ignition-specific extraction tools and techniques to remove the fragment without damaging the ignition cylinder. After extraction, we assess whether the ignition is still functional or requires repair or replacement in {city}.</p>
          <div class="mt-4"><a href={`/services/automotive-locksmith/${slug}/ignition-repair/`} class="text-[#A61E22] font-semibold hover:underline text-sm">Ignition Repair in {city} →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">What NOT to Do</h3>
          <p class="text-gray-600 text-sm leading-relaxed">If your key has broken in a lock in {city}, resist the temptation to dig at it with tweezers, paperclips, or other improvised tools. These often push the fragment deeper into the cylinder, damage the internal pins, or jam the fragment in a position that makes professional extraction harder. Leave the lock alone and call us — the sooner you call, the better your chances of a clean extraction without lock damage.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">After Extraction</h3>
          <p class="text-gray-600 text-sm leading-relaxed">A key that broke in a lock often indicates a worn key, a stiff cylinder, or both. After removing the fragment in {city}, we assess the lock — if the cylinder pins or the lock mechanism were damaged by the broken key or by previous attempts to remove it, we can repair or replace the lock on the same visit. We also cut you a fresh new key so you can immediately return to normal use.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">More Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">More Locksmith Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <a href={`/services/emergency-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full emergency locksmith services in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/emergency-lockout/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Lockout Service in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Home, car, and business lockouts in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/safe-lockout-services/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Safe Lockout Services in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Safe and vault opening in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/emergency-house-lockout/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency House Lockout in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency house lockout in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/emergency-car-lockout/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Car Lockout in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast car lockout response in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/ignition-repair/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Ignition Repair in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Car ignition repair after broken key or damage in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Residential Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full residential locksmith services in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Automotive Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Car key replacement and ignition repair in {city}.</p>
        </a>
        <a href={`/service-areas/${slug}/`} class="bg-[#A61E22] rounded-2xl p-6 border border-[#A61E22] hover:bg-[#8C181B] transition">
          <h3 class="font-bold text-white text-base mb-2">All Services in {city}, {state}</h3>
          <p class="text-white/80 text-sm">View all locksmith services in {city}, {state}.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-[#A61E22] py-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Broken Key in {city}, {state}?</h2>
      <p class="text-white/90 text-lg max-w-2xl mx-auto mb-8">Call 1st Capital Locksmith for professional broken key extraction in {city}. Door locks and car ignitions — we come to you throughout {county}, Delaware.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:3027350050" class="inline-flex items-center rounded-full bg-white text-[#A61E22] px-8 py-4 font-bold text-lg hover:bg-gray-100 transition">Call (302) 735-0050</a>
        <a href="/contact/" class="inline-flex items-center rounded-full border border-white px-8 py-4 text-white font-semibold hover:bg-white hover:text-[#A61E22] transition">Get Help Now</a>
      </div>
    </div>
  </section>

</MainLayout>


