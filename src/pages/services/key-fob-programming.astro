---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="Key Fob Programming in Delaware | Mobile Key Fob Replacement & Programming | 1st Capital Locksmith"
  description="Key fob stopped working or need a replacement programmed? 1st Capital Locksmith provides mobile key fob programming and replacement throughout Delaware. We program all types of fobs on-site — no dealership required. Serving Dover, Milford, Smyrna & all of Kent County, DE. Call (302) 735-0050."
>

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li>
          <a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-[#A61E22] font-semibold">Key Fob Programming</span>
        </li>
      </ol>
    </div>
  </nav>

  <!-- Schema Markup for Breadcrumbs -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.1stcapitallocksmith.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.1stcapitallocksmith.com/services/" },
      { "@type": "ListItem", "position": 3, "name": "Key Fob Programming", "item": "https://www.1stcapitallocksmith.com/services/key-fob-programming/" }
    ]
  })} />

  <!-- Schema: Service -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Key Fob Programming in Delaware",
    "description": "Professional mobile key fob programming and replacement throughout Delaware. 1st Capital Locksmith programs remote key fobs and smart keys for all major vehicle makes and models on-site — no dealership required.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "1st Capital Locksmith",
      "telephone": "+13027350050",
      "address": { "@type": "PostalAddress", "addressLocality": "Dover", "addressRegion": "DE", "addressCountry": "US" }
    },
    "areaServed": { "@type": "State", "name": "Delaware" },
    "serviceType": "Key Fob Programming"
  })} />

  <!-- Schema: FAQ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does key fob programming cost in Delaware?", "acceptedAnswer": { "@type": "Answer", "text": "Cost varies based on your vehicle's year, make, and model, and the type of fob required. We provide a clear upfront quote before any work begins. Call us at (302) 735-0050 with your vehicle details for a fast, accurate estimate." } },
      { "@type": "Question", "name": "Can I just buy a fob online and have you program it?", "acceptedAnswer": { "@type": "Answer", "text": "In some cases, yes — if you can confirm the fob you've purchased is the correct part number for your exact vehicle. However, we recommend calling us first so we can source the right fob and guarantee compatibility. Using an incorrect or incompatible fob can result in failed programming and wasted money." } },
      { "@type": "Question", "name": "Why won't my key fob work after I changed the battery?", "acceptedAnswer": { "@type": "Answer", "text": "If a fresh battery doesn't restore your fob's function, the fob itself has likely failed internally, or in some cases the fob may have lost its programming and needs to be re-paired to the vehicle. Call us and we can diagnose whether a reprogramming will fix it or whether a replacement is needed." } },
      { "@type": "Question", "name": "Do you program key fobs for all car brands?", "acceptedAnswer": { "@type": "Answer", "text": "We program fobs for the vast majority of vehicle makes and models including Toyota, Honda, Ford, Chevrolet, Dodge, Nissan, Hyundai, Kia, BMW, Mercedes-Benz, Jeep, RAM, Subaru, Lexus, Infiniti, and many others. Call us with your year, make, and model to confirm we can service your vehicle." } },
      { "@type": "Question", "name": "Can you program a push-to-start smart key?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Smart keys and proximity fobs for push-to-start vehicles are a service we handle regularly throughout Delaware. We carry the appropriate diagnostic programming tools to pair smart keys to your vehicle's immobilizer and keyless entry system on-site." } },
      { "@type": "Question", "name": "How long does key fob programming take?", "acceptedAnswer": { "@type": "Answer", "text": "Most key fob programming visits take 20-40 minutes on-site. The time varies slightly based on the vehicle and fob type. Smart keys and more complex systems may take a little longer, but the job is typically completed in a single visit." } }
    ]
  })} />

  <!-- Hero -->
  <section
    class="relative min-h-[340px] md:min-h-[550px] flex items-center text-white py-10 md:py-20"
    style="background-image: url('/images/key-fob-programming.jpg'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative max-w-6xl mx-auto px-5 md:px-6 z-10">
      <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-xs md:text-sm mb-2 md:mb-4">Key Fob Programming — Delaware</p>
      <h1 class="text-2xl sm:text-3xl md:text-5xl font-bold mb-3 md:mb-6 max-w-3xl leading-tight">
        Key Fob Programming in Delaware — Replacement & Programming On-Site
      </h1>
      <p class="text-gray-300 text-sm md:text-lg max-w-2xl leading-relaxed mb-5 md:mb-8">
        Lost your key fob? Fob stopped working? Need a spare programmed before you need it? 1st Capital Locksmith provides fully mobile key fob programming and replacement throughout Delaware. We source the right fob for your vehicle, program it on-site, and have you back to full functionality — no dealership trip required.
      </p>
      <div class="flex flex-wrap gap-3 md:gap-4">
        <a
          href="tel:3027350050"
          class="inline-flex items-center rounded-full bg-[#A61E22] px-6 py-3 md:px-8 md:py-4 text-white font-bold text-base md:text-lg hover:bg-[#8C181B] transition"
        >
          Call (302) 735-0050
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center rounded-full border border-white px-6 py-3 md:px-8 md:py-4 text-white font-semibold text-sm md:text-base hover:bg-white hover:text-[#1A1F22] transition"
        >
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">All Makes</p>
          <p class="text-gray-300 text-sm mt-1">Domestic & Foreign Vehicles</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Mobile</p>
          <p class="text-gray-300 text-sm mt-1">We Come to Your Location</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">On-Site</p>
          <p class="text-gray-300 text-sm mt-1">Programmed Where You Are</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Less Than Dealer</p>
          <p class="text-gray-300 text-sm mt-1">Save vs. Dealership Pricing</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Delaware's Mobile Key Fob Specialists</p>
          <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-6 leading-snug">
            Professional Key Fob Programming Throughout Delaware
          </h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            Key fobs have become one of the most essential parts of modern vehicle ownership. They lock and unlock your doors, open your trunk, trigger your alarm, and in many vehicles start the engine entirely without inserting a key. When a fob is lost, damaged, or stops responding, it's not just an inconvenience — it can leave you without full use of your vehicle until it's properly replaced and programmed.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            The programming process requires specialized diagnostic equipment that communicates directly with your vehicle's security system. Simply buying a replacement fob and swapping the battery won't work — every fob must be electronically paired to your specific vehicle. That's exactly what 1st Capital Locksmith does on-site throughout Delaware. We source quality replacement fobs for your vehicle, program them to your car's system, and have everything working correctly in a single visit.
          </p>
          <p class="text-gray-700 leading-relaxed">
            We serve drivers throughout <a href="/service-areas/dover-de/" class="text-[#A61E22] hover:underline font-medium">Dover</a>, <a href="/service-areas/milford-de/" class="text-[#A61E22] hover:underline font-medium">Milford</a>, <a href="/service-areas/smyrna-de/" class="text-[#A61E22] hover:underline font-medium">Smyrna</a>, <a href="/service-areas/camden-de/" class="text-[#A61E22] hover:underline font-medium">Camden</a>, <a href="/service-areas/harrington-de/" class="text-[#A61E22] hover:underline font-medium">Harrington</a>, <a href="/service-areas/frederica-de/" class="text-[#A61E22] hover:underline font-medium">Frederica</a>, and all surrounding communities in Kent County. Whether you've lost your only fob or just want a spare, call us and we'll take care of it at your location.
          </p>
        </div>
        <div class="flex flex-col gap-6">
          <!-- PHOTO SLOT 1: Recommended 800×500px — key fob being programmed or close-up of fob -->
          <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-sm">
            <img
              src="/images/key-fob-programming.jpg"
              alt="Key fob programming on-site by 1st Capital Locksmith in Delaware"
              class="w-full h-80 object-cover"
              width="800"
              height="500"
            />
          </div>
          <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200">
            <h3 class="text-xl font-bold text-[#1A1F22] mb-6">Key Fob Services We Provide:</h3>
            <ul class="space-y-3">
              {[
                "Lost Key Fob Replacement & Programming",
                "Spare / Additional Fob Programming",
                "Smart Key & Push-to-Start Fob Programming",
                "Remote Start Fob Programming",
                "Broken or Damaged Fob Replacement",
                "Key Fob That Won't Lock / Unlock Doors",
                "All Types — Standard, Flip, Proximity Fobs",
                "All Makes & Models — Domestic & Foreign",
              ].map((item) => (
                <li class="flex items-center gap-3 text-gray-700">
                  <span class="w-6 h-6 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="mt-6 pt-6 border-t border-gray-200">
              <a
                href="tel:3027350050"
                class="w-full inline-flex justify-center items-center rounded-full bg-[#A61E22] px-6 py-3 text-white font-bold hover:bg-[#8C181B] transition"
              >
                Call (302) 735-0050 Now
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Detail -->
  <section id="services" class="bg-[#F8F8F5] py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-14">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">What We Do</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-4">
          Key Fob Programming Services in Delaware
        </h2>
        <p class="text-gray-700 max-w-3xl mx-auto leading-relaxed">
          Modern key fobs come in several forms and handle a range of vehicle functions. Here is a detailed look at every type of key fob programming and replacement we provide on-site throughout Delaware.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

        <!-- Lost Key Fob Replacement -->
        <div id="lost-key-fob" class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition">
          <div class="w-14 h-14 bg-[#A61E22]/10 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Lost Key Fob Replacement & Programming in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Losing your key fob is more disruptive than most people anticipate until it actually happens. Without it, you lose remote access to your locks, your trunk release, and in push-to-start vehicles, the ability to drive the car at all. And unlike older physical keys, you can't simply have a new fob cut at a hardware store — every replacement fob must be programmed electronically to communicate with your specific vehicle.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              1st Capital Locksmith sources quality replacement fobs for your vehicle's year, make, and model and programs them on-site throughout Delaware using professional diagnostic equipment. When we're finished, your new fob is fully paired to your vehicle and operates all the same functions your original did — remote lock, unlock, trunk, panic, and in applicable vehicles, remote start.
            </p>
            <p class="text-gray-700 leading-relaxed">
              If you've lost your only fob, we can also advise on whether a spare fob should be programmed at the same time — it's more convenient and often less expensive to add a spare during the same visit than to schedule a separate call later.
            </p>
          </div>
        </div>

        <!-- Smart Key & Push-to-Start Fob -->
        <div id="smart-key-fob" class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition">
          <div class="w-14 h-14 bg-[#A61E22]/10 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18" />
            </svg>
          </div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Smart Key & Push-to-Start Fob Programming in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Smart keys and push-to-start proximity fobs are now standard on a wide range of vehicles. These fobs communicate with your vehicle via a short-range radio signal — when the fob is in range, the car recognizes it and allows the push-button start to function. They also handle keyless entry automatically as you approach and lock the car as you walk away. When they stop working or need to be replaced, the programming process is more complex than a standard remote fob.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              Replacing a smart key or proximity fob requires the right replacement unit for your exact vehicle as well as the proper diagnostic programming tools to pair it to your car's immobilizer and keyless entry system. This is precisely the kind of work that most people assume can only be done at the dealership — and it's exactly what 1st Capital Locksmith does on-site throughout Delaware.
            </p>
            <p class="text-gray-700 leading-relaxed">
              We work with smart key systems from Toyota, Lexus, Honda, Acura, Nissan, Infiniti, Hyundai, Kia, Ford, Chevrolet, Dodge, BMW, Mercedes-Benz, Subaru, and many others. Call us with your vehicle details and we'll confirm compatibility before we dispatch.
            </p>
          </div>
        </div>

        <!-- Spare Fob Programming -->
        <div id="spare-fob" class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition">
          <div class="w-14 h-14 bg-[#A61E22]/10 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Spare & Additional Key Fob Programming in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Most vehicles come with two fobs from the factory, but it's surprisingly common to end up with only one working fob over time — a spare may have been lost, damaged, or simply never passed along when a used vehicle changed hands. Operating with just one fob is a risk. If that fob dies, gets lost, or stops working, you may find yourself unable to access or start your vehicle.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              Getting a spare fob programmed now — while everything is working fine — is the smart move. It's far less stressful and typically less expensive than an emergency replacement after the fact. 1st Capital Locksmith will come to your home or workplace, program a new fob to your vehicle on the spot, and test it thoroughly before we leave.
            </p>
            <p class="text-gray-700 leading-relaxed">
              This is also a great option for families where multiple drivers share a vehicle. Having a second properly programmed fob eliminates the daily hassle of sharing a single key and ensures every driver has reliable access to the car.
            </p>
          </div>
        </div>

        <!-- Remote Start Fob -->
        <div id="remote-start-fob" class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition">
          <div class="w-14 h-14 bg-[#A61E22]/10 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Remote Start Fob Programming in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Many vehicles — particularly trucks, SUVs, and newer models — come factory-equipped with remote start functionality built into the key fob. Being able to start your car from inside your home or office before you head out is a genuine convenience, especially during Delaware's hot summers and cold winters. When a remote start fob is lost or fails, that convenience disappears along with it.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              Factory remote start fobs are integrated into the vehicle's security and <a href="/services/ignition-repair/" class="text-[#A61E22] hover:underline font-medium">ignition system</a> and require the same professional programming equipment as any other fob. 1st Capital Locksmith can source and program replacement remote start fobs for factory-installed systems on a wide range of vehicles, all on-site at your location throughout Delaware.
            </p>
            <p class="text-gray-700 leading-relaxed">
              Note: We program factory-installed remote start systems. Aftermarket remote start systems vary widely by brand and installer, so call us with your vehicle details and system information and we will let you know if we can assist.
            </p>
          </div>
        </div>

        <!-- Broken or Non-Responsive Fob -->
        <div id="broken-fob" class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition">
          <div class="w-14 h-14 bg-[#A61E22]/10 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Broken or Non-Responsive Key Fob Replacement in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Sometimes a fob doesn't get lost — it just stops working. The buttons stop responding, the casing cracks from being dropped, or the internal circuit board fails. Before assuming you need a full replacement, there are a couple of things worth checking: first, try a fresh battery (many fob failures are simply a dead battery). If a new battery doesn't solve it, the fob itself has likely failed internally and needs to be replaced.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              A broken or non-responsive fob that still has the physical key blade inside it means you can still get into the vehicle and start it manually — but you lose all the remote functions until the fob is replaced. Don't let a broken fob go unaddressed; driving without a working fob means you also have no backup if the <a href="/services/car-key-replacement/" class="text-[#A61E22] hover:underline font-medium">ignition key itself is ever lost</a>.
            </p>
            <p class="text-gray-700 leading-relaxed">
              Call 1st Capital Locksmith and we will bring a replacement fob to your location throughout Delaware, program it to your vehicle on-site, and make sure every function works correctly before we leave.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Photo Gallery Strip -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">On-Site Key Fob Programming</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22]">Sourced, Programmed & Tested at Your Location — Anywhere in Delaware</h2>
      </div>
      <!-- PHOTO SLOT 4, 5, 6: Recommended 600×400px each
           Photo 4 — selection of key fobs for different vehicles
           Photo 5 — programming tool connected to OBD port
           Photo 6 — customer testing new fob at their vehicle -->
      <div class="grid md:grid-cols-3 gap-6">
        <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-sm">
          <img
            src="/images/key-fob-types.jpg"
            alt="Various types of key fobs programmed by 1st Capital Locksmith in Delaware"
            class="w-full h-64 object-contain"
            width="600"
            height="400"
          />
          <div class="p-4 bg-[#F8F8F5]">
            <p class="font-semibold text-[#1A1F22] text-sm">All Fob Types & Brands</p>
            <p class="text-gray-500 text-xs mt-1">Standard, flip, smart key, proximity & remote start fobs</p>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-sm">
          <img
            src="/images/fob-programming-tool.jpg"
            alt="Professional key fob programming equipment used by 1st Capital Locksmith"
            class="w-full h-64 object-contain"
            width="600"
            height="400"
          />
          <div class="p-4 bg-[#F8F8F5]">
            <p class="font-semibold text-[#1A1F22] text-sm">Professional Programming Equipment</p>
            <p class="text-gray-500 text-xs mt-1">The same tools used by dealerships — brought to you</p>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-sm">
          <img
            src="/images/key-fob-programmed-delaware.jpg"
            alt="Customer with newly programmed key fob at their vehicle in Delaware"
            class="w-full h-64 object-contain"
            width="600"
            height="400"
