    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Available 6 Days a Week</p>
          <p class="text-gray-300 text-sm mt-1">Open 6 Days a Week</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">All Commercial Locks</p>
