            <h3 class="text-xl font-bold text-[#1A1F22] mb-6">Commercial Lockout Situations We Handle:</h3>
            <ul class="space-y-3">
              {[
                "Keys Locked Inside Office or Storefront",
                "Lost or Missing Commercial Keys",
                "Employee or Manager Lockout",
                "After-Hours Business Lockout",
                "Broken Key in Commercial Door Lock",
                "Malfunctioning Electronic Keypad",
                "Jammed or Stuck Commercial Lock",
                "Interior Office or Server Room Lockout",
                "Terminated Employee â€” Lock Security",
                "New Tenancy or Business Takeover",
              ].map((item) => (
