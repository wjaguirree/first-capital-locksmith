  <!-- Trust Bar -->
  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">All Exit Device Types</p>
          <p class="text-gray-300 text-sm mt-1">Rim, Mortise & Vertical Rod</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Major Brands</p>
          <p class="text-gray-300 text-sm mt-1">Von Duprin, Corbin Russwin & More</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Master Key Integration</p>
          <p class="text-gray-300 text-sm mt-1">Keyed to Existing System</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Repair & Replace</p>
          <p class="text-gray-300 text-sm mt-1">Service Existing Panic Hardware</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Delaware's Commercial Exit Device Specialists</p>
          <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-6 leading-snug">
            Professional Panic Bar & Exit Device Installation Across Delaware
          </h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            Panic bars — also called crash bars, push bars, or exit devices — are required life safety hardware on many commercial doors throughout Delaware. In an emergency evacuation, the ability to exit a building quickly and without operating a handle or turning a key can mean the difference between a safe exit and a tragedy. Building codes reflect this reality, mandating panic hardware on exit doors for occupancies above certain thresholds.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            1st Capital Locksmith installs, repairs, and replaces all types of commercial exit devices for businesses throughout Delaware. We work with rim exit devices, mortise exit devices, vertical rod devices, and surface vertical rod systems for all commercial door types — wood, hollow metal, and aluminum storefront. We supply and install units from trusted brands including Von Duprin, Corbin Russwin, Sargent, ASSA ABLOY, and Adams Rite.
          </p>
          <p class="text-gray-700 leading-relaxed">
            We serve commercial properties across <a href="/service-areas/dover-de" class="text-[#A61E22] hover:underline font-medium">Dover</a>, <a href="/service-areas/smyrna-de" class="text-[#A61E22] hover:underline font-medium">Smyrna</a>, <a href="/service-areas/milford-de" class="text-[#A61E22] hover:underline font-medium">Milford</a>, <a href="/service-areas/harrington-de" class="text-[#A61E22] hover:underline font-medium">Harrington</a>, <a href="/service-areas/camden-de" class="text-[#A61E22] hover:underline font-medium">Camden</a>, and all of Kent County. Call (302) 735-0050 to schedule an on-site assessment.
          </p>
        </div>
        <div class="space-y-6">
          <div class="rounded-2xl overflow-hidden border border-gray-200 bg-[#F8F8F5] aspect-[4/3] flex items-center justify-center">
            <img
              src="/images/panic-bar-service.png"
              alt="Panic bar exit device installation for Delaware commercial building"
              class="w-full h-full object-cover"
              width="600"
              height="450"
              loading="lazy"
            />
          </div>
          <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200">
            <h3 class="text-xl font-bold text-[#1A1F22] mb-6">Businesses That Need Panic Bar Hardware:</h3>
            <ul class="space-y-3">
              {[
                "Offices & Business Parks",
                "Retail Stores & Malls",
                "Warehouses & Distribution Centers",
                "Restaurants & Food Service",
                "Schools & Educational Facilities",
                "Medical Offices & Clinics",
                "Churches & Worship Facilities",
                "Gyms & Fitness Centers",
                "Hotels & Lodging Properties",
                "Government & Municipal Buildings",
              ].map((item) => (
                <li class="flex items-center gap-3 text-gray-700">
                  <span class="w-6 h-6 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
