      {
        "@type": "Question",
        "name": "How quickly can you get to my house for an emergency lockout?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We typically arrive within 20â€“30 minutes for most locations across Kent County. We dispatch immediately upon your call and keep you updated on our ETA. Call (302) 735-0050 now and we will head to you right away."
        }
      },
      {
