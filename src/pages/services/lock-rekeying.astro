---
import MainLayout from "../../layouts/MainLayout.astro";
import Reviews from "../../components/Reviews.astro";
---

<MainLayout
  title="Lock Rekeying in Delaware | Mobile Rekey Service | 1st Capital Locksmith"
  description="Need your locks rekeyed in Delaware? 1st Capital Locksmith provides professional mobile lock rekeying throughout Kent County. We rekey deadbolts, knob locks & more on-site — old keys won't work, new keys provided. Serving Dover, Milford, Smyrna & surrounding areas. Call (302) 735-0050."
>

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li>
          <a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-[#A61E22] font-semibold">Lock Rekeying</span>
        </li>
      </ol>
    </div>
  </nav>

  <!-- Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://1stcapitallocksmithde.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://1stcapitallocksmithde.com/services/" },
      { "@type": "ListItem", "position": 3, "name": "Lock Rekeying", "item": "https://1stcapitallocksmithde.com/services/lock-rekeying/" }
    ]
  })} />

  <!-- Schema: Service -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Lock Rekeying in Delaware",
    "description": "Professional mobile lock rekeying throughout Delaware. 1st Capital Locksmith rekeys deadbolts and knob locks on-site — old keys stop working, new keys provided on the spot. Serving Dover, Milford, Smyrna, Camden, Harrington and all of Kent County.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "1st Capital Locksmith",
      "telephone": "+13027350050",
      "address": { "@type": "PostalAddress", "addressLocality": "Dover", "addressRegion": "DE", "addressCountry": "US" }
    },
    "areaServed": { "@type": "State", "name": "Delaware" },
    "serviceType": "Lock Rekeying"
  })} />

  <!-- Schema: FAQ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the difference between rekeying and replacing a lock?", "acceptedAnswer": { "@type": "Answer", "text": "Rekeying changes the internal pin configuration of an existing lock cylinder so that only a new key works — the lock hardware stays in place. Lock replacement involves removing the entire lock and installing brand-new hardware. Rekeying is significantly less expensive and achieves the same security result when the lock hardware is in good condition." } },
      { "@type": "Question", "name": "Will my old keys definitely not work after rekeying?", "acceptedAnswer": { "@type": "Answer", "text": "Yes — 100%. When a lock is rekeyed, the internal pins are physically replaced with a new set configured to a different key cut pattern. The old key's profile no longer matches the new pin heights, so it cannot operate the lock. Every old key, including any copies that were made, is immediately and permanently deactivated." } },
      { "@type": "Question", "name": "Can you rekey my locks if I don't have a working key?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. If you don't have a working key, we first need to pick or bypass the lock to open it, and then rekey the cylinder. This adds a small amount of time to the service but is a very common scenario — particularly after a lockout, a lost key situation, or when someone moves into a home where no working key was provided." } },
      { "@type": "Question", "name": "Can you rekey my locks so they all use one key?", "acceptedAnswer": { "@type": "Answer", "text": "Yes — this is called 'keyed alike' service. We rekey every lock in your home to the same pin configuration so one key operates all of them. This works even if your existing locks are different brands or models." } },
      { "@type": "Question", "name": "How many locks can you rekey in one visit?", "acceptedAnswer": { "@type": "Answer", "text": "We can rekey as many locks as you need in a single visit. Most homes have two to four exterior lock cylinders, which we can complete in well under an hour. Larger properties or rental units with more entry points take a bit longer but are still typically handled in one efficient visit." } },
      { "@type": "Question", "name": "What brands of locks can you rekey?", "acceptedAnswer": { "@type": "Answer", "text": "We rekey all major residential lock brands including Kwikset, Schlage, Defiant, Baldwin, Yale, and others. If you have a high-security lock such as Medeco, Mul-T-Lock, or Abloy, these can also be rekeyed — call us and we will confirm based on the specific model." } }
    ]
  })} />

  <!-- Hero -->
  <section
    class="relative min-h-85 md:min-h-137.5 flex items-center text-white py-10 md:py-20"
    style="background-image: url('/images/lock-rekeying.jpg'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative max-w-6xl mx-auto px-5 md:px-6 z-10">
      <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-xs md:text-sm mb-2 md:mb-4">Lock Rekeying — Kent County, Delaware</p>
      <h1 class="text-2xl sm:text-3xl md:text-5xl font-bold mb-3 md:mb-6 max-w-3xl leading-tight">
        Lock Rekeying in Delaware — Old Keys Won't Work. New Keys Provided.
      </h1>
      <p class="text-gray-300 text-sm md:text-lg max-w-2xl leading-relaxed mb-5 md:mb-8">
        Moving into a new home? Lost your keys? Concerned about who has copies? Lock rekeying is the fast, affordable way to take full control of who can access your home — without replacing your hardware. 1st Capital Locksmith provides professional mobile rekeying throughout Delaware. We come to you, rekey your locks on-site, and hand you fresh keys before we leave.
      </p>
      <div class="flex flex-wrap gap-3 md:gap-4">
        <a
          href="tel:3027350050"
          class="inline-flex items-center rounded-full bg-[#A61E22] px-6 py-3 md:px-8 md:py-4 text-white font-bold text-base md:text-lg hover:bg-[#8C181B] transition"
        >
          Call (302) 735-0050
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center rounded-full border border-white px-6 py-3 md:px-8 md:py-4 text-white font-semibold text-sm md:text-base hover:bg-white hover:text-[#1A1F22] transition"
        >
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Mobile</p>
          <p class="text-gray-300 text-sm mt-1">We Come to Your Home</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Affordable</p>
          <p class="text-gray-300 text-sm mt-1">Much Less Than Replacing Locks</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Same Visit</p>
          <p class="text-gray-300 text-sm mt-1">Old Keys Dead, New Keys In Hand</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Upfront</p>
          <p class="text-gray-300 text-sm mt-1">Clear Pricing Before We Start</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Delaware's Mobile Lock Rekeying Specialists</p>
          <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-6 leading-snug">
            Professional Lock Rekeying Throughout Delaware
          </h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            Lock rekeying is one of the smartest security investments you can make for your home — and most people do not realize how affordable and quick it is. When a lock is rekeyed, a locksmith removes the cylinder from the lock hardware and replaces the internal pins with a new set configured to a different key pattern. The result: every old key that previously worked in that lock is immediately rendered useless, and you receive fresh keys cut to the new pattern.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            The lock hardware itself — the deadbolt, knob, or lever — stays exactly where it is. You are not replacing the lock, just changing what key opens it. This makes rekeying significantly more cost-effective than a full lock change while providing exactly the same security outcome: complete control over who has access to your home.
          </p>
          <p class="text-gray-700 leading-relaxed">
            1st Capital Locksmith provides fully mobile rekeying throughout <a href="/service-areas/dover-de/" class="text-[#A61E22] hover:underline font-medium">Dover</a>, <a href="/service-areas/milford-de/" class="text-[#A61E22] hover:underline font-medium">Milford</a>, <a href="/service-areas/smyrna-de/" class="text-[#A61E22] hover:underline font-medium">Smyrna</a>, <a href="/service-areas/camden-de/" class="text-[#A61E22] hover:underline font-medium">Camden</a>, <a href="/service-areas/harrington-de/" class="text-[#A61E22] hover:underline font-medium">Harrington</a>, <a href="/service-areas/frederica-de/" class="text-[#A61E22] hover:underline font-medium">Frederica</a>, <a href="/service-areas/felton-de/" class="text-[#A61E22] hover:underline font-medium">Felton</a>, and all Kent County communities. We come to your home, rekey every lock you need done in a single visit, and leave you with new keys and peace of mind.
          </p>
        </div>
        <div class="flex flex-col gap-6">
          <!-- PHOTO SLOT 1: Recommended 800×500px — locksmith rekeying a deadbolt or close-up of lock cylinder pins -->
          <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-sm">
            <img
              src="/images/lock-rekeying.jpg"
              alt="1st Capital Locksmith rekeying a residential deadbolt in Kent County, Delaware"
              class="w-full h-70 object-cover"
              width="800"
              height="500"
            />
          </div>
          <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200">
            <h3 class="text-xl font-bold text-[#1A1F22] mb-6">Lock Rekeying Services We Provide:</h3>
            <ul class="space-y-3">
              {[
                "Residential Deadbolt Rekeying",
                "Knob & Lever Lock Rekeying",
                "Rekeying After Moving Into a New Home",
                "Rekeying After Lost or Stolen Keys",
                "Rekeying After a Breakup or Tenant Turnover",
                "Rekeying After a Lockout",
                "Master Key System Rekeying",
                "Multiple Locks Keyed Alike (One Key for All)",
                "Apartment & Rental Property Rekeying",
                "Kwikset, Schlage & All Major Brands",
              ].map((item) => (
                <li class="flex items-center gap-3 text-gray-700">
                  <span class="w-6 h-6 bg-[#A61E22] rounded-full flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="mt-6 pt-6 border-t border-gray-200">
              <a
                href="tel:3027350050"
                class="w-full inline-flex justify-center items-center rounded-full bg-[#A61E22] px-6 py-3 text-white font-bold hover:bg-[#8C181B] transition"
              >
                Call (302) 735-0050 Now
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Detail -->
  <section id="services" class="bg-[#F8F8F5] py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-14">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">When to Rekey</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-4">
          Lock Rekeying Situations We Handle in Delaware
        </h2>
        <p class="text-gray-700 max-w-3xl mx-auto leading-relaxed">
          There are many situations where rekeying is the right move. Here is a detailed look at each one and how we approach it professionally throughout Kent County.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

        <!-- Moving Into a New Home -->
        <div id="new-home-rekey" class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition">
          <div class="w-14 h-14 bg-[#A61E22]/10 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Rekeying Locks When Moving Into a New Home in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Moving into a new home is one of the most important times to rekey your locks — and it is something the vast majority of homeowners skip entirely. When you receive the keys at closing, you have no way of knowing how many copies of those keys exist, or who has them. Previous owners may have given copies to contractors, neighbors, family members, or cleaning services. Real estate agents may still hold copies. Those keys all continue to work in your locks until someone changes that.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              Rekeying on move-in day is the most cost-effective way to ensure that only you and the people you choose have access to your new home. We can rekey every exterior lock in a single visit, keying them all alike so one key opens every door — or setting them on separate keys if you prefer. We can have all your exterior locks rekeyed and new keys in your hands within an hour in most cases.
            </p>
            <p class="text-gray-700 leading-relaxed">
              This is a service we strongly recommend to every new homeowner in Delaware. Call us on or shortly after move-in day and we will take care of it efficiently and affordably.
            </p>
        </div>

        <!-- Lost or Stolen Keys -->
        <div id="lost-keys-rekey" class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition">
          <div class="w-14 h-14 bg-[#A61E22]/10 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Rekeying After Lost or Stolen House Keys in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              If you have lost your house keys — or had them stolen — rekeying is the right response. Lost keys can turn up anywhere, and if they are found by someone who knows or can determine your address, they have a key to your home. Stolen keys in particular represent a direct and immediate security threat that should be addressed as soon as possible.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              Rekeying after a lost or stolen key situation is faster and less expensive than <a href="/services/lock-change/" class="text-[#A61E22] hover:underline font-medium">replacing the entire lock set</a>. We come to your home, remove the cylinder from each affected lock, replace the internal pins with a new configuration, cut you fresh keys, and test everything thoroughly before leaving. The whole process per lock takes only a matter of minutes once we are on-site.
            </p>
            <p class="text-gray-700 leading-relaxed">
              If your keys were stolen as part of a break-in or theft attempt, consider rekeying all exterior locks at once for complete security. Call 1st Capital Locksmith and we will assess your situation and advise on the best approach throughout Delaware.
            </p>
        </div>

        <!-- Keyed Alike — One Key for All Locks -->
        <div id="keyed-alike" class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition">
          <div class="w-14 h-14 bg-[#A61E22]/10 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
            </svg>
          </div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Keyed Alike — One Key for Every Lock in Your Home</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Many homes accumulate locks over time — a <a href="/services/deadbolt-installation/" class="text-[#A61E22] hover:underline font-medium">deadbolt</a> on the front door, a knob lock on the back door, a separate lock on the garage entry, and perhaps locks on side gates or outbuildings — all requiring different keys. This creates a bulky and confusing keyring that is frustrating to deal with every day. The solution is a "keyed alike" rekeying job, where we configure all of your locks to operate on the same single key.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              We can rekey your entire home — regardless of whether the existing locks are the same brand or model — so that every door opens with one key. This requires us to rekey each cylinder to the same pin configuration that matches a single key blank. The result is a clean, convenient setup where you carry one house key that opens everything.
            </p>
            <p class="text-gray-700 leading-relaxed">
              This service is especially popular with new homeowners, landlords setting up rental properties, and anyone upgrading their home's key management. We handle keyed-alike rekeying throughout Delaware in a single visit.
            </p>
        </div>

        <!-- Tenant Turnover & Rental Properties -->
        <div id="rental-rekey" class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition">
          <div class="w-14 h-14 bg-[#A61E22]/10 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Rental Property & Tenant Turnover Rekeying in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              For landlords and property managers, rekeying between tenants is not just a best practice — in many cases it is a legal or insurance requirement. When a tenant moves out, they are supposed to return all keys, but there is no guarantee that copies were not made during the tenancy. The only way to be certain that a former tenant cannot access the property after move-out is to rekey the locks.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              1st Capital Locksmith works with landlords and property managers throughout Kent County to provide efficient tenant turnover rekeying. We can rekey single units or multiple properties as needed. We also provide multiple copies of the new keys — typically one set for the new tenant and one for the landlord — and document the job clearly.
            </p>
            <p class="text-gray-700 leading-relaxed">
              If you manage rental properties in Dover, Milford, Smyrna, Camden, or anywhere in Kent County and need a reliable locksmith for tenant turnover rekeying, call 1st Capital Locksmith to set up recurring service or a one-time appointment.
            </p>
        </div>

        <!-- After a Breakup or Security Concern -->
        <div id="security-rekey" class="bg-white rounded-2xl p-8 border border-gray-200 hover:shadow-lg transition">
          <div class="w-14 h-14 bg-[#A61E22]/10 rounded-2xl flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#A61E22]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Rekeying After a Breakup, Separation, or Security Concern</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Life circumstances change, and when they do your home's access list should change with them. After a relationship ends, a roommate moves out, a family dispute arises, or any other situation where someone previously trusted now should no longer have access — rekeying your locks is the right and responsible step to take. This is not about distrust; it is about ensuring your home remains a safe and private space.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              Asking for a key back does not guarantee that copies were not made. Rekeying is the only way to be certain. The process takes only minutes per lock and is completely non-disruptive — the same lock hardware stays in place. No drilling, no replacement, no mess.
            </p>
            <p class="text-gray-700 leading-relaxed">
              We handle these situations with complete discretion and professionalism throughout Delaware. Your privacy and security are the priority. Call 1st Capital Locksmith and we will handle it promptly and without judgment.
            </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Photo Gallery Strip -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Mobile Lock Rekeying</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22]">Rekeyed On-Site — Old Keys Dead, New Keys in Your Hand</h2>
      </div>
      <!-- PHOTO SLOT 4, 5, 6: Recommended 600×400px each
           Photo 4 — lock cylinder pins / rekeying kit
           Photo 5 — locksmith working at front door
           Photo 6 — new keys being handed to homeowner -->
      <div class="grid md:grid-cols-3 gap-6">
        <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-sm">
          <img
            src="/images/rekey-lock-cylinder.jpg"
            alt="Lock cylinder and rekeying pins used by 1st Capital Locksmith in Delaware"
            class="w-full h-64 object-cover"
            width="600"
            height="400"
          />
          <div class="p-4 bg-[#F8F8F5]">
            <p class="font-semibold text-[#1A1F22] text-sm">Precision Rekeying — Pin by Pin</p>
            <p class="text-gray-500 text-xs mt-1">New pin configuration means old keys no longer work</p>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-sm">
          <img
            src="/images/rekey-technician-delaware.jpg"
            alt="1st Capital Locksmith technician rekeying a home lock in Kent County, Delaware"
            class="w-full h-64 object-cover"
            width="600"
            height="400"
