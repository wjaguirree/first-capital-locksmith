      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">All Lock Types</p>
          <p class="text-gray-300 text-sm mt-1">Door Locks, Deadbolts & Ignitions</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Non-Destructive</p>
          <p class="text-gray-300 text-sm mt-1">Professional Tools — No Damage</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Replacement Key</p>
