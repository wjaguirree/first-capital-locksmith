  <!-- Schema: Service -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Ignition Repair in Delaware",
    "description": "Professional mobile ignition repair throughout Delaware — sticky ignitions, worn cylinders, broken keys in ignition, and transponder issues fixed on-site. 1st Capital Locksmith serves Dover, Milford, Smyrna and all of Kent County.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "1st Capital Locksmith",
      "telephone": "+13027350050",
      "address": { "@type": "PostalAddress", "addressLocality": "Dover", "addressRegion": "DE", "addressCountry": "US" }
    },
    "areaServed": { "@type": "State", "name": "Delaware" },
    "serviceType": "Ignition Repair"
  })} />

  <!-- Schema: FAQ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How do I know if my ignition needs repair or full replacement?", "acceptedAnswer": { "@type": "Answer", "text": "If the ignition cylinder is stiff, sticky, or slightly worn but physically intact, repair is often possible. If the cylinder is severely worn, cracked, broken, or has been tampered with or damaged in a theft attempt, replacement is usually the better solution. Our technicians assess the cylinder on-site and give you an honest recommendation." } },
      { "@type": "Question", "name": "Can I use WD-40 to fix a stiff ignition?", "acceptedAnswer": { "@type": "Answer", "text": "WD-40 is not a recommended lubricant for ignition cylinders. It tends to attract and trap debris over time and can make the problem worse. For ignition cylinders, professional locksmiths use graphite-based or PTFE dry lubricants specifically designed for precision lock mechanisms." } },
      { "@type": "Question", "name": "My key won't turn in the ignition — what should I try first?", "acceptedAnswer": { "@type": "Answer", "text": "With your foot off the brake, gently rock the steering wheel left and right while simultaneously turning the key. A locked steering column is one of the most common causes. If that doesn't work, check the transmission is fully in park. If neither solves the problem, stop attempting to force the key and call 1st Capital Locksmith to diagnose the issue properly." } },
      { "@type": "Question", "name": "My car cranks but won't start and the security light is on — is that an ignition problem?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, this is often a transponder or immobilizer issue related to the ignition system. When the security light stays illuminated and the engine cranks but won't fire, it typically means the vehicle's immobilizer system is not recognizing the transponder chip in your key. Call us and we can test the transponder and ignition reader on-site." } },
      { "@type": "Question", "name": "How long does ignition repair take?", "acceptedAnswer": { "@type": "Answer", "text": "For straightforward ignition cylinder cleaning and lubrication, we are typically done within 20-30 minutes on-site. More involved repairs may take 45 minutes to an hour depending on the vehicle and specific problem. We work efficiently and will give you a realistic estimate when we arrive." } },
      { "@type": "Question", "name": "Can you repair the ignition on any make or model of vehicle?", "acceptedAnswer": { "@type": "Answer", "text": "We work on a very wide range of domestic and foreign vehicles including Toyota, Honda, Ford, Chevrolet, Dodge, GMC, Jeep, RAM, Nissan, Hyundai, Kia, Subaru, Volkswagen, BMW, Mercedes-Benz, and many more. If you are unsure whether we can help with your specific vehicle, call us and we will let you know upfront." } }
    ]
  })} />

