  description="1st Capital Locksmith provides fast mobile automotive locksmith services throughout Delaware. Car lockouts, car key replacement, transponder key programming, key fob programming, and ignition repair throughout Kent County, DE."
>

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li>
          <a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <a href="/services" class="hover:text-[#A61E22] transition font-medium">Services</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-[#A61E22] font-semibold">Automotive Locksmith</span>
        </li>
      </ol>
    </div>
  </nav>

  <!-- Schema Markup for Breadcrumbs -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.1stcapitallocksmith.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.1stcapitallocksmith.com/services/" },
      { "@type": "ListItem", "position": 3, "name": "Automotive Locksmith", "item": "https://www.1stcapitallocksmith.com/services/automotive-locksmith/" }
    ]
  })} />

  <!-- Hero -->
  <section
    class="relative min-h-[340px] md:min-h-[550px] flex items-center text-white py-10 md:py-20"
    style="background-image: url('/images/car-lockout-technician.jpg'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative max-w-6xl mx-auto px-5 md:px-6 z-10">
      <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-xs md:text-sm mb-2 md:mb-4">Automotive Locksmith Services</p>
      <h1 class="text-2xl sm:text-3xl md:text-5xl font-bold mb-3 md:mb-6 max-w-3xl leading-tight">
        Automotive Locksmith in Delaware — Car Lockouts, Key Replacement & More
      </h1>
      <p class="text-gray-300 text-sm md:text-lg max-w-2xl leading-relaxed mb-5 md:mb-8">
        Locked out of your car? Lost your car keys? Need a key fob programmed on-site? 1st Capital Locksmith provides fast, professional mobile automotive locksmith services throughout Delaware. We come directly to your location.
      </p>
      <div class="flex flex-wrap gap-3 md:gap-4">
        <a
          href="tel:3027350050"
          class="inline-flex items-center rounded-full bg-[#A61E22] px-6 py-3 md:px-8 md:py-4 text-white font-bold text-base md:text-lg hover:bg-[#8C181B] transition"
        >
          Call (302) 735-0050
        </a>
        <a
          href="/contact"
          class="inline-flex items-center rounded-full border border-white px-6 py-3 md:px-8 md:py-4 text-white font-semibold text-sm md:text-base hover:bg-white hover:text-[#1A1F22] transition"
        >
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">All Makes</p>
          <p class="text-gray-300 text-sm mt-1">Domestic & Foreign Vehicles</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Mobile</p>
          <p class="text-gray-300 text-sm mt-1">We Come to Your Location</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Fast</p>
          <p class="text-gray-300 text-sm mt-1">Quick Response Throughout Delaware</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Upfront</p>
          <p class="text-gray-300 text-sm mt-1">Clear Pricing Before We Start</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Delaware's Mobile Auto Locksmith</p>
          <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-6 leading-snug">
            Professional Automotive Locksmith Services Throughout Delaware
          </h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            Whether you've locked your keys in your car in a parking lot, broken your key off in the ignition, or need a replacement key programmed on the spot, 1st Capital Locksmith is the automotive locksmith Delaware drivers trust. We are a fully mobile locksmith service, which means we come directly to wherever your vehicle is — no towing required.
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            Our automotive locksmiths are trained and equipped to handle modern vehicle key systems including transponder keys, chip keys, smart keys, push-to-start fobs, and traditional cut keys for all makes and models. Whether you drive a domestic car, a foreign vehicle, a pickup truck, or an SUV, we have the tools and expertise to get you back on the road quickly.
          </p>
          <p class="text-gray-700 leading-relaxed">
            We proudly serve drivers throughout Dover, Milford, Smyrna, Camden, Harrington, and all surrounding Kent County communities. When you need an automotive locksmith in Delaware, call 1st Capital Locksmith first.
          </p>
        </div>
        <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200">
          <h3 class="text-xl font-bold text-[#1A1F22] mb-6">Our Automotive Locksmith Services Include:</h3>
          <ul class="space-y-3">
            {[
              "Car Lockout Service",
              "Car Key Replacement",
              "Transponder Key Cutting & Programming",
              "Key Fob Programming & Replacement",
              "Smart Key & Push-to-Start Programming",
              "Ignition Repair & Replacement",
              "Broken Key Extraction",
              "Duplicate Car Key Made On-Site",
            ].map((item) => (
              <li class="flex items-center gap-3 text-gray-700">
                <span class="w-6 h-6 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
          <div class="mt-6 pt-6 border-t border-gray-200">
            <a
              href="tel:3027350050"
              class="w-full inline-flex justify-center items-center rounded-full bg-[#A61E22] px-6 py-3 text-white font-bold hover:bg-[#8C181B] transition"
            >
              Call (302) 735-0050 Now
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Detail -->
  <section id="services" class="bg-[#F8F8F5] py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-14">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">What We Do</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-4">
          Automotive Locksmith Services in Delaware
        </h2>
        <p class="text-gray-700 max-w-3xl mx-auto leading-relaxed">
          From emergency car lockouts to on-site key programming, here is a detailed look at every automotive locksmith service we offer to drivers throughout Delaware.
        </p>
      </div>

      <div class="space-y-8">

        <!-- Car Lockout -->
        <div id="car-lockout" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10l2 2h7l1-2zM13 6h3l3 4v4h-2" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Car Lockout Service in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Locking your keys inside your car is one of the most common and frustrating situations a driver can face. It happens to everyone at some point — you step out for just a second, the door shuts, and suddenly you're standing in a parking lot with no way to get back in. When this happens to you anywhere in Delaware, 1st Capital Locksmith is the call to make.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              Our mobile automotive locksmiths respond quickly to your location and use professional non-destructive entry techniques to unlock your vehicle without causing any damage to your door, window, or lock mechanisms. We work on all types of vehicles including sedans, trucks, SUVs, minivans, and commercial vehicles.
            </p>
            <p class="text-gray-700 leading-relaxed">
              Whether you're stranded at a grocery store parking lot, stuck at work, or locked out at home, we will get there as quickly as possible and have you back inside your vehicle in no time. Call us instead of attempting to break in yourself — DIY attempts often result in expensive damage.
            </p>
          </div>
        </div>

        <!-- Car Key Replacement -->
        <div id="key-replacement" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Car Key Replacement in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Losing your car keys is stressful, especially with the cost and inconvenience of dealership replacements. The good news is that 1st Capital Locksmith can replace your car key on-site at a fraction of the dealership price, and we come directly to your location throughout Delaware.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              We replace all types of car keys including standard cut keys, transponder chip keys, laser cut keys, and high-security keys. Our mobile locksmiths carry the programming equipment needed to cut and program your new key on the spot, so you don't have to arrange a tow to the dealership and wait days for a replacement.
            </p>
            <p class="text-gray-700 leading-relaxed">
              We work with virtually all makes and models — Toyota, Honda, Ford, Chevrolet, Dodge, Nissan, Hyundai, Kia, BMW, Mercedes-Benz, Jeep, RAM, and more. Call us and we will confirm we can service your specific vehicle before dispatching.
            </p>
          </div>
        </div>

        <!-- Transponder Key -->
        <div id="transponder-key" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Transponder Key Cutting & Programming in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Most vehicles made after 1995 use transponder keys — keys that contain a small electronic chip in the head that communicates with your vehicle's immobilizer system. If the chip is not programmed correctly, your car will not start even if the key physically turns the ignition. This is an anti-theft feature, but it also means that simply cutting a key at a hardware store won't work.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              At 1st Capital Locksmith, our automotive locksmiths carry professional-grade transponder key programming equipment that allows us to cut and program your new transponder key on-site, anywhere in Delaware. We work with the same technology used by dealerships, delivered directly to your location.
            </p>
            <p class="text-gray-700 leading-relaxed">
              Whether you've lost your only key or need a spare programmed, we can handle it quickly and at a much lower cost than going to the dealership. Call us today for a quote on transponder key programming for your specific vehicle.
            </p>
          </div>
        </div>

        <!-- Key Fob -->
        <div id="key-fob" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Key Fob Programming & Replacement in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              Key fobs have become standard on virtually every modern vehicle. They allow you to remotely lock and unlock your doors, open your trunk, activate your alarm, and in many cases start your engine. When your key fob stops working, gets lost, or needs to be replaced, you need a professional automotive locksmith who can program the new fob to communicate with your specific vehicle.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              1st Capital Locksmith programs key fobs and smart keys for all major vehicle brands on-site throughout Delaware. We also handle push-to-start proximity keys and remote start fobs. We source quality replacement fobs and program them to your vehicle's security system the same day.
            </p>
            <p class="text-gray-700 leading-relaxed">
              Dealerships often charge two to three times what we charge for the same key fob programming service. Skip the wait and the markup — call our mobile automotive locksmiths and we'll come to you.
            </p>
          </div>
        </div>

        <!-- Ignition -->
        <div id="ignition" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Ignition Repair & Replacement in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              A faulty ignition cylinder can leave you completely unable to start your vehicle — or worse, stranded with a key stuck that won't turn or won't come out. Ignition problems can develop over time from general wear, forcing keys, or attempted vehicle theft. When your ignition is giving you trouble, it's a problem that needs professional attention right away.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              Our automotive locksmiths diagnose and repair ignition cylinder issues on-site throughout Delaware. If repair isn't possible, we also perform full ignition cylinder replacements and re-key the new cylinder to work with your existing key so you don't need all new keys cut.
            </p>
            <p class="text-gray-700 leading-relaxed">
              Don't force a key that won't turn — you risk snapping the key off inside the cylinder and turning a simple repair into a much more expensive extraction and replacement job. Call 1st Capital Locksmith at the first sign of ignition trouble.
            </p>
          </div>
        </div>

        <!-- Broken Key Extraction -->
        <div id="broken-key" class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Broken Key Extraction in Delaware</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              A broken key stuck inside your car door lock or ignition cylinder is a stressful situation. The instinct is to try to pull it out yourself with pliers or tweezers, but this almost always makes the problem worse by pushing the broken piece deeper into the lock or damaging the cylinder walls.
            </p>
            <p class="text-gray-700 leading-relaxed mb-3">
              1st Capital Locksmith has the specialized extraction tools to safely remove broken key fragments from door locks and ignition cylinders without causing additional damage. Once the key is removed, we can cut a new key on-site and, if needed, re-program it to your vehicle's transponder system.
            </p>
            <p class="text-gray-700 leading-relaxed">
              If your key has snapped off in your ignition or door lock anywhere in Delaware, stop what you're doing and call us. We will be there quickly and handle the extraction professionally so you can get back to your day.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Why Choose Us</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-4">
          Why Delaware Drivers Choose 1st Capital Locksmith
        </h2>
        <p class="text-gray-700 max-w-3xl mx-auto leading-relaxed">
          There are a lot of locksmith options out there, but here's why drivers throughout Delaware choose us when they need automotive locksmith help.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200">
          <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="font-bold text-[#1A1F22] text-lg mb-2">We Come to You — Fast</h3>
          <p class="text-gray-700 text-sm leading-relaxed">No towing required. Our mobile automotive locksmiths come directly to your vehicle's location anywhere in Delaware. We dispatch quickly and arrive ready to work.</p>
        </div>

        <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200">
          <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-bold text-[#1A1F22] text-lg mb-2">Fraction of Dealership Cost</h3>
          <p class="text-gray-700 text-sm leading-relaxed">Dealerships charge a premium for car key replacement and key fob programming. We provide the same quality service at a significantly lower price with no appointment needed.</p>
        </div>

        <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200">
          <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="font-bold text-[#1A1F22] text-lg mb-2">All Makes & Models</h3>
          <p class="text-gray-700 text-sm leading-relaxed">We work on virtually every vehicle make and model including Toyota, Honda, Ford, Chevrolet, Nissan, BMW, Mercedes, Jeep, and more — domestic and foreign.</p>
        </div>

        <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200">
