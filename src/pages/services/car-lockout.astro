---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="Car Lockout Service in Delaware | Locked Keys in Car | 1st Capital Locksmith"
  description="Locked your keys in your car in Delaware? 1st Capital Locksmith provides fast, mobile car lockout service throughout Kent County. We respond quickly, use non-destructive entry, and serve Dover, Milford, Smyrna, Camden & all surrounding areas. Call (302) 735-0050."
>

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li>
          <a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-[#A61E22] font-semibold">Car Lockout Service</span>
        </li>
      </ol>
    </div>
  </nav>

  <!-- Schema Markup for Breadcrumbs -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://1stcapitallocksmithde.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://1stcapitallocksmithde.com/services/" },
      { "@type": "ListItem", "position": 3, "name": "Car Lockout Service", "item": "https://1stcapitallocksmithde.com/services/car-lockout/" }
    ]
  })} />

  <!-- Schema: Service -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Car Lockout Service in Delaware",
    "description": "Professional mobile car lockout service throughout Delaware. 1st Capital Locksmith uses non-destructive entry tools to unlock your vehicle fast — serving Dover, Milford, Smyrna, Camden, Harrington and all of Kent County.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "1st Capital Locksmith",
      "telephone": "+13027350050",
      "address": { "@type": "PostalAddress", "addressLocality": "Dover", "addressRegion": "DE", "addressCountry": "US" }
    },
    "areaServed": { "@type": "State", "name": "Delaware" },
    "serviceType": "Car Lockout Service"
  })} />

  <!-- Schema: FAQ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How much does a car lockout service cost in Delaware?", "acceptedAnswer": { "@type": "Answer", "text": "Pricing depends on your vehicle type and location. We give you a clear, upfront quote before we dispatch so there are no surprise charges. Call us at (302) 735-0050 for a fast estimate on your specific situation." } },
      { "@type": "Question", "name": "Will you damage my car getting it open?", "acceptedAnswer": { "@type": "Answer", "text": "No. Our locksmiths use professional non-destructive entry tools — air wedge systems and long-reach tools — that allow us to open your vehicle without breaking windows, scratching paint, or damaging the door frame or weather stripping." } },
      { "@type": "Question", "name": "How fast can you respond to a car lockout in Delaware?", "acceptedAnswer": { "@type": "Answer", "text": "We dispatch immediately upon receiving your call and aim to reach your location as quickly as possible. Response time varies by location and demand, but we prioritize lockout calls and move fast. Call (302) 735-0050 for the fastest response." } },
      { "@type": "Question", "name": "Can you open any car, including newer models with electronic locks?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We work on virtually all vehicle makes and models, including newer vehicles with fully electronic locking systems. Our tools and techniques are effective on both traditional mechanical locks and modern electronic systems." } },
      { "@type": "Question", "name": "Should I call 911 or a locksmith if a child or pet is locked inside my car?", "acceptedAnswer": { "@type": "Answer", "text": "If a child or pet is locked inside the vehicle — especially in warm weather — call 911 first. This is a life-safety emergency that first responders are trained and equipped to handle. Once the immediate emergency is resolved, we are available to assist with vehicle access." } },
      { "@type": "Question", "name": "Is it faster to call you or wait for roadside assistance?", "acceptedAnswer": { "@type": "Answer", "text": "In most cases, calling a local mobile locksmith is significantly faster than waiting for roadside assistance dispatched through an insurance plan or membership program. We are based locally in Delaware and can often respond much quicker than a national service dispatch." } }
    ]
  })} />

  <!-- Hero -->
  <section
    class="relative min-h-85 md:min-h-137.5 flex items-center text-white py-10 md:py-20"
    style="background-image: url('/images/car-lockout.jpg'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative max-w-6xl mx-auto px-5 md:px-6 z-10">
      <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-xs md:text-sm mb-2 md:mb-4">Car Lockout Service — Delaware</p>
      <h1 class="text-2xl sm:text-3xl md:text-5xl font-bold mb-3 md:mb-6 max-w-3xl leading-tight">
        Car Lockout Service in Delaware — Fast, Non-Destructive Entry
      </h1>
      <p class="text-gray-300 text-sm md:text-lg max-w-2xl leading-relaxed mb-5 md:mb-8">
        Locked your keys inside your car? Don't panic and don't damage your vehicle trying to get in yourself. 1st Capital Locksmith provides fast, professional car lockout service throughout Delaware. We dispatch quickly, come directly to your location, and get you back in your vehicle without any damage.
      </p>
      <div class="flex flex-wrap gap-3 md:gap-4">
        <a
          href="tel:3027350050"
          class="inline-flex items-center rounded-full bg-[#A61E22] px-6 py-3 md:px-8 md:py-4 text-white font-bold text-base md:text-lg hover:bg-[#8C181B] transition"
        >
          Call (302) 735-0050
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center rounded-full border border-white px-6 py-3 md:px-8 md:py-4 text-white font-semibold text-sm md:text-base hover:bg-white hover:text-[#1A1F22] transition"
        >
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Fast Response</p>
          <p class="text-gray-300 text-sm mt-1">We Dispatch Immediately</p>
