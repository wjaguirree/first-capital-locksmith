---
import MainLayout from "../../../layouts/MainLayout.astro";
import LocationLocalFlavor from "../../../components/LocationLocalFlavor.astro";
import { sp, compose, townAnchor } from "../../../data/serviceCopy";
import { locations } from "../../../data/locations";
import type { Location } from "../../../data/locations";

export function getStaticPaths() {
  return locations.map((loc) => ({
    params: { location: loc.slug },
    props: { location: loc },
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;
const { city, state, slug, county, description } = location;

const heroP = sp(slug, "hero", [
  `Locked out of your business in ${city}? Need a master key system set up? Looking to upgrade your commercial door hardware? 1st Capital Locksmith provides professional commercial locksmith services throughout ${city}, Delaware — we respond quickly and minimize downtime for your business.`,
  `A lock problem at your ${city} business costs money by the minute. 1st Capital Locksmith provides commercial locksmith service throughout ${city}, Delaware — lockouts, master key systems, rekeying, and exit hardware — with fast response and minimal disruption to your operations.`,
  `From a pre-open lockout to a full master key rollout, ${city} businesses call 1st Capital Locksmith for commercial locksmith work that's fast, professional, and finished on-site. Serving all of ${city}, Delaware.`,
  `Commercial security problems don't wait for business hours, and neither do we. 1st Capital Locksmith handles lockouts, rekeys, master key systems, and panic hardware for businesses throughout ${city}, Delaware.`,
]);

const intro1 = sp(slug, "intro-1", [
  `${city} is ${description}, and 1st Capital Locksmith provides the commercial locksmith services that ${city} businesses count on to stay secure and operational. A security issue or lockout at your business is more than an inconvenience — it's a liability and a direct cost to your bottom line. We respond with urgency and handle every commercial locksmith job completely on-site.`,
  `For businesses in ${city} — ${description} — a lock problem is never just a lock problem. It's lost revenue, a security gap, or a code issue waiting for an inspector. 1st Capital Locksmith responds across ${city} with commercial locksmith service that treats your downtime like the emergency it is.`,
  `${city} businesses operate in ${description}, and they need a locksmith who understands commercial urgency. 1st Capital Locksmith handles lockouts, rekeying, master key systems, and hardware upgrades throughout ${city} — on-site, on schedule, with minimal disruption to your day.`,
  `1st Capital Locksmith serves the business community of ${city} — ${description} — with commercial locksmith work done the way businesses need it: fast dispatch, on-site completion, and pricing quoted before we touch a lock.`,
]);

const intro2 = sp(slug, "intro-2", [
  `From small retail shops and professional offices to multi-unit commercial buildings throughout ${city} and ${county}, we have the tools and experience to handle any commercial lock and key situation efficiently and professionally.`,
  `Retail storefronts, professional offices, restaurants, and multi-unit commercial buildings across ${city} and ${county} — we service them all, with commercial-grade hardware on the truck and the experience to match.`,
  `Whether you run a small shop or manage a multi-tenant facility in ${city}, our commercial locksmith coverage spans all of ${county}. We arrive with the hardware and the expertise to finish commercial work in a single visit.`,
  `Our commercial work in ${city} covers everything from single-door shops to large facilities across ${county}. The common thread: professional hardware, efficient work, and minimal interruption to your business.`,
]);

const bizLockout1 = compose(slug, "biz-lockout-1", {
  open: [
    `Being locked out of your business in ${city} is a situation that needs immediate attention.`,
    `A business lockout in ${city} means every minute outside is revenue you'll never recover.`,
    `When your ${city} business can't open on time because of a lock, the clock is running on real losses.`,
    `Locked out of your ${city} business with customers or staff waiting? That's not a wait-and-see problem.`,
  ],
  mid: [
    `Every minute you're standing outside unable to open is lost revenue and productivity. 1st Capital Locksmith treats commercial lockout calls with the urgency they deserve — we dispatch quickly to your ${city} business location and get you back inside professionally.`,
    `1st Capital Locksmith treats commercial lockouts as what they are: business emergencies. We dispatch directly to your ${city} location and get the door open professionally, without damage.`,
    `We answer ${city} business lockouts with emergency-level urgency — a stocked truck dispatched directly to your door, opened without damage, so you're operational again fast.`,
    `Our commercial lockout response in ${city} is built for speed: quick dispatch, non-destructive entry, and you're back to business.`,
  ],
  close: [
    townAnchor(slug, "commercial", "biz-lockout-1"),
    `Once you're in, we can address whatever caused the lockout — worn hardware, a failed cylinder, a lost key situation — in the same visit.`,
    `If the lockout exposed a deeper problem — failing hardware or a key control issue — we can fix that too before we leave.`,
  ],
});

const bizLockout2 = sp(slug, "biz-lockout-2", [
  `We work with all types of commercial door hardware including cylindrical locks, mortise locks, electronic locks, and access control entry systems. We gain entry without damage so your lock hardware remains intact and functional after we leave.`,
  `Cylindrical locks, mortise hardware, electronic locks, and access control systems — we open all of them without damage, so your door hardware is fully functional when we leave.`,
  `Commercial hardware is our specialty: mortise locks, cylindrical sets, electronic strikes, and access control entry. Entry is gained non-destructively, and your hardware stays in service.`,
]);

const masterKey1 = sp(slug, "master-key-1", [
  `A master key system allows you to control access across your entire ${city} facility with a single master key while still giving employees individual keys that only open the areas they need. This eliminates the need to carry a heavy key ring and gives you full control over who can access what in your building.`,
  `If your ${city} business runs on a ring of twenty keys and nobody's sure which opens what, a master key system fixes that. One master opens everything for you; change keys open only what each employee needs — full control, no key-ring archaeology.`,
  `Master key systems give ${city} business owners hierarchy and control: your master key opens every door, managers' keys open their areas, and staff keys open only their own. Access becomes deliberate instead of accidental.`,
]);

const masterKey2 = sp(slug, "master-key-2", [
  `1st Capital Locksmith designs and installs master key systems for businesses throughout ${city} — from simple two-level systems to complex grand master key hierarchies for large commercial facilities. We assess your specific needs and design a system that fits your access control requirements precisely.`,
  `We design and build master key systems for ${city} businesses of every size — a simple two-level setup for a small shop, or a grand master hierarchy for a large facility. Every system is documented so future rekeys and expansions are straightforward.`,
  `From a small ${city} office needing two access levels to a multi-department facility needing a full hierarchy, we design the system around how your business actually works — then document it so managing it later is easy.`,
]);

const commRekey1 = compose(slug, "comm-rekey-1", {
  open: [
    `When an employee leaves your ${city} business — especially under difficult circumstances — rekeying your commercial locks should be an immediate priority.`,
    `An employee departure in ${city} — friendly or otherwise — means a key you no longer control is out there.`,
    `Every key a former employee didn't return is a door into your ${city} business that you can't account for.`,
    `Staff changes at ${city} businesses quietly create security gaps: keys copied, keys kept, keys lost months ago.`,
  ],
  mid: [
    `Former employees with key access represent a genuine security risk. 1st Capital Locksmith provides fast commercial rekeying services throughout ${city} to eliminate that risk quickly and affordably.`,
    `Rekeying closes that gap the same day: we re-pin your existing locks so old keys stop working, without the cost of new hardware. We handle commercial rekeys across ${city} fast.`,
    `1st Capital Locksmith rekeys commercial locks throughout ${city} — old keys dead the moment we finish, new keys in your hand, hardware untouched.`,
    `We re-pin your existing commercial locks on-site anywhere in ${city}, so unaccounted keys become useless metal the same day you call.`,
  ],
  close: [
    townAnchor(slug, "commercial", "comm-rekey-1"),
    `We can also take the opportunity to key alike or set up a simple master arrangement while we're there.`,
    `If key control has been loose for a while, ask about a master key setup while we're on-site — one visit can fix both problems.`,
  ],
});

const commRekey2 = sp(slug, "comm-rekey-2", [
  `Rekeying changes the internal pin configuration of your existing locks so old keys no longer work — without the expense of replacing all your lock hardware. We rekey all types of commercial locks and can service an entire facility in a single visit.`,
  `Because rekeying reuses your existing hardware, it costs a fraction of replacement — and we can rekey an entire ${city} facility in one visit, keyed alike or in a master arrangement, whatever fits your operation.`,
  `All commercial lock types are covered, and entire facilities can be done in a single visit. Your hardware stays; only the pins change — which is why rekeying costs so much less than replacing.`,
]);

const panicBar1 = sp(slug, "panic-bar-1", [
  `If your ${city} business has commercial exits that require panic bar hardware for code compliance or safety, 1st Capital Locksmith installs and services panic bars and exit devices for commercial facilities throughout ${city}. Panic bars (also called push bars or crash bars) allow quick, single-motion exit from a building in an emergency.`,
  `Panic bars — the push bars on commercial exit doors — are life-safety equipment with code requirements behind them. 1st Capital Locksmith installs and services exit devices for ${city} businesses, keeping your exits compliant and your occupants safe.`,
  `Commercial exits in ${city} need hardware that opens with one motion in an emergency — that's what panic bars do, and building codes often require them. We install, repair, and replace exit devices throughout ${city}.`,
]);

const panicBar2 = sp(slug, "panic-bar-2", [
  `We install, repair, and replace panic bar hardware on commercial doors of all types, ensuring your exit devices meet applicable fire safety and building code requirements while maintaining proper security control on your doors.`,
  `From new installations to repairs on sticky or loose existing devices, we work on all commercial door types — and we set exit hardware to meet code requirements without compromising your door's security from the outside.`,
  `A panic bar must do two jobs: release instantly from inside, stay secure from outside. We install and service exit devices on all commercial door types in ${city} with both requirements in mind.`,
]);

const hardware1 = sp(slug, "hardware-1", [
  `Whether your ${city} business needs new commercial-grade door hardware installed, existing locks replaced with higher-security options, or a complete hardware upgrade across your facility, 1st Capital Locksmith handles commercial lock installation of all types.`,
  `New doors, tired hardware, or a security upgrade across the whole facility — ${city} businesses call 1st Capital Locksmith for commercial lock installation at every scale, from one storefront door to an entire building.`,
  `Commercial doors work harder than residential ones, and the hardware has to match. We install commercial-grade locks, closers, and related hardware for ${city} businesses — single doors or facility-wide projects.`,
]);

const hardware2 = sp(slug, "hardware-2", [
  `We work with quality commercial lock brands and install mortise locks, cylindrical locks, rim locks, and other commercial hardware on wood, metal, and hollow-core doors. All installation work is completed on-site in a single visit whenever possible.`,
  `Mortise locks, cylindrical sets, rim locks, and more — installed on wood, metal, or hollow-core doors with quality commercial brands. We complete installation work on-site in a single visit whenever possible.`,
  `Our trucks carry commercial hardware from brands we trust, and we install on wood, metal, and hollow-core doors — mortise, cylindrical, and rim configurations. Most projects finish in one on-site visit.`,
]);

const ctaP = sp(slug, "cta", [
  `Call 1st Capital Locksmith now for fast, professional commercial locksmith service at your ${city} business. We respond quickly and minimize downtime.`,
  `Lockouts, rekeys, master systems, exit hardware — one call brings a commercial locksmith to your ${city} business with everything needed to finish on-site. Call now.`,
  `Your ${city} business can't afford to wait on a lock problem. Call 1st Capital Locksmith for fast dispatch and upfront pricing.`,
]);
---

<MainLayout
  title={`Commercial Locksmith in ${city}, ${state} | 1st Capital Locksmith`}
  description={`Commercial locksmith in ${city}, ${state}: business lockouts, master key systems & panic bar installation. Fast mobile service. Call (302) 735-0050.`}
>

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li>
          <a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <a href="/services/commercial-locksmith/" class="hover:text-[#A61E22] transition font-medium">Commercial Locksmith</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-[#A61E22] font-semibold">{city}, {state}</span>
        </li>
      </ol>
    </div>
  </nav>

  <!-- Schema: Breadcrumb -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://1stcapitallocksmithde.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://1stcapitallocksmithde.com/services/" },
      { "@type": "ListItem", "position": 3, "name": "Commercial Locksmith", "item": "https://1stcapitallocksmithde.com/services/commercial-locksmith/" },
      { "@type": "ListItem", "position": 4, "name": `${city}, ${state}`, "item": `https://1stcapitallocksmithde.com/services/commercial-locksmith/${slug}/` }
    ]
  })} />

  <!-- Schema: Local Business -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "1st Capital Locksmith",
    "telephone": "+13027350050",
    "url": "https://1stcapitallocksmithde.com",
    "address": { "@type": "PostalAddress", "streetAddress": "2089 S Dupont Hwy #2", "addressLocality": "Dover", "addressRegion": "DE", "postalCode": "19901", "addressCountry": "US" },
    "geo": { "@type": "GeoCoordinates", "latitude": "39.1212111", "longitude": "-75.5331705" },
    "areaServed": { "@type": "City", "name": city, "containedIn": { "@type": "State", "name": "Delaware" } },
    "serviceType": ["Commercial Locksmith", "Business Lockout", "Master Key Systems", "Access Control", "Panic Bar Installation", "Commercial Lock Rekeying"]
  })} />

  <!-- Schema: Service -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "Service",
    "name": `Commercial Locksmith Service in ${city}, ${state}`,
    "serviceType": "Commercial Locksmith",
    "provider": { "@type": "LocalBusiness", "name": "1st Capital Locksmith", "telephone": "+13027350050", "url": "https://1stcapitallocksmithde.com" },
    "areaServed": { "@type": "City", "name": city, "containedIn": { "@type": "State", "name": "Delaware" } }
  })} />

  <!-- Hero -->
  <section
    class="relative min-h-85 md:min-h-137.5 flex items-center text-white py-10 md:py-20"
    style="background-image: url('/images/hero.webp'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative max-w-6xl mx-auto px-5 md:px-6 z-10">
      <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-xs md:text-sm mb-2 md:mb-4">Commercial Locksmith in {city}, Delaware</p>
      <h1 class="text-2xl sm:text-3xl md:text-5xl font-bold mb-3 md:mb-6 max-w-3xl leading-tight">
        Commercial Locksmith in {city}, {state} — Business Lockouts, Master Keys & More
      </h1>
      <p class="text-gray-300 text-sm md:text-lg max-w-2xl leading-relaxed mb-5 md:mb-8">
        {heroP}
      </p>
      <div class="flex flex-wrap gap-3 md:gap-4">
        <a
          href="tel:3027350050"
          class="inline-flex items-center rounded-full bg-[#A61E22] px-6 py-3 md:px-8 md:py-4 text-white font-bold text-base md:text-lg hover:bg-[#8C181B] transition"
        >
          Call (302) 735-0050
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center rounded-full border border-white px-6 py-3 md:px-8 md:py-4 text-white font-semibold text-sm md:text-base hover:bg-white hover:text-[#1A1F22] transition"
        >
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">6 Days</p>
          <p class="text-gray-300 text-sm mt-1">Open 6 Days a Week</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Mobile</p>
          <p class="text-gray-300 text-sm mt-1">We Come to Your {city} Business</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">All Sizes</p>
          <p class="text-gray-300 text-sm mt-1">Small Businesses to Large Facilities</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-[#A61E22]">Upfront</p>
          <p class="text-gray-300 text-sm mt-1">Clear Pricing Before We Start</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Your Commercial Locksmith in {city}</p>
          <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-6 leading-snug">
            Professional Commercial Locksmith Services in {city}, {state}
          </h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            {intro1}
          </p>
          <p class="text-gray-700 leading-relaxed mb-4">
            {intro2}
          </p>
          <p class="text-gray-700 leading-relaxed">
            Call us at <a href="tel:3027350050" class="text-[#A61E22] font-semibold hover:underline">(302) 735-0050</a> for commercial locksmith service in {city}, {state}.
          </p>
        </div>
        <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200">
          <h3 class="text-xl font-bold text-[#1A1F22] mb-6">Commercial Services We Provide in {city}:</h3>
          <ul class="space-y-3">
            {[
              { label: "Business Lockout Service", href: `/services/commercial-locksmith/${slug}/office-lockout` },
              { label: "Commercial Lock Installation & Replacement", href: "/services/commercial-locksmith" },
              { label: "Master Key System Design & Setup", href: `/services/commercial-locksmith/${slug}/master-key-systems` },
              { label: "Access Control Solutions", href: "/services/commercial-locksmith" },
              { label: "Panic Bar & Exit Device Installation", href: `/services/commercial-locksmith/${slug}/panic-bar-installation` },
              { label: "Commercial Lock Rekeying", href: `/services/commercial-locksmith/${slug}/commercial-lock-rekeying` },
              { label: "High-Security Lock Upgrades", href: `/services/residential-locksmith/${slug}/lock-change` },
              { label: "Post-Break-In Lock Replacement", href: "/services/emergency-locksmith" },
            ].map(({ label, href }) => (
              <li class="flex items-center gap-3 text-gray-700">
                <span class="w-6 h-6 bg-[#A61E22] rounded-full flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <a href={href} class="hover:text-[#A61E22] hover:underline transition">{label}</a>
              </li>
            ))}
          </ul>
          <div class="mt-6 pt-6 border-t border-gray-200">
            <a
              href="tel:3027350050"
              class="w-full inline-flex justify-center items-center rounded-full bg-[#A61E22] px-6 py-3 text-white font-bold hover:bg-[#8C181B] transition"
            >
              Call (302) 735-0050 Now
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Detail -->
  <section class="bg-[#F8F8F5] py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-14">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">What We Do in {city}</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-4">
          Commercial Locksmith Services in {city}, {state}
        </h2>
        <p class="text-gray-700 max-w-3xl mx-auto leading-relaxed">
          From emergency business lockouts to master key system installations, here is a complete look at every commercial locksmith service we provide to businesses in {city}, Delaware.
        </p>
      </div>

      <div class="space-y-8">

        <!-- Business Lockout -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V7a2 2 0 00-2-2H7a2 2 0 00-2 2v14M3 21h18M9 21v-4a1 1 0 011-1h4a1 1 0 011 1v4" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Business Lockout Service in {city}, {state}</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              {bizLockout1}
            </p>
            <p class="text-gray-700 leading-relaxed">
              {bizLockout2}
            </p>
            <div class="mt-4">
              <a href={`/services/commercial-locksmith/${slug}/office-lockout/`} class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Commercial Lockout Service in Delaware →</a>
            </div>
          </div>
        </div>

        <!-- Master Key Systems -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Master Key Systems in {city}, {state}</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              {masterKey1}
            </p>
            <p class="text-gray-700 leading-relaxed">
              {masterKey2}
            </p>
            <div class="mt-4">
              <a href={`/services/commercial-locksmith/${slug}/master-key-systems/`} class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Master Key Systems in Delaware →</a>
            </div>
          </div>
        </div>

        <!-- Commercial Lock Rekeying -->
        <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm grid md:grid-cols-[auto_1fr] gap-6">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#1A1F22] mb-3">Commercial Lock Rekeying in {city}, {state}</h3>
            <p class="text-gray-700 leading-relaxed mb-3">
              {commRekey1}
            </p>
