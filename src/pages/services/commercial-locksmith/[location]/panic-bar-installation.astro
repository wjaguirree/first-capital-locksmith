---
import MainLayout from "../../../../layouts/MainLayout.astro";
import { locations } from "../../../../data/locations";
import type { Location } from "../../../../data/locations";

export function getStaticPaths() {
  return locations.map((loc) => ({
    params: { location: loc.slug },
    props: { location: loc },
  }));
}

interface Props { location: Location; }
const { location } = Astro.props;
const { city, state, slug, county } = location;
---

<MainLayout
  title={`Panic Bar Installation in ${city}, ${state} | Exit Device Installation | 1st Capital Locksmith`}
  description={`Panic bar and exit device installation in ${city}, ${state}. 1st Capital Locksmith installs commercial panic bars and crash bars on commercial doors throughout ${city} and ${county}, Delaware. Code-compliant installation. Call (302) 735-0050.`}
>

  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li><a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href={`/services/commercial-locksmith/${slug}/`} class="hover:text-[#A61E22] transition font-medium">Commercial Locksmith in {city}</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><span class="text-[#A61E22] font-semibold">Panic Bar Installation — {city}, {state}</span></li>
      </ol>
    </div>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.1stcapitallocksmith.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.1stcapitallocksmith.com/services/" },
      { "@type": "ListItem", "position": 3, "name": `Commercial Locksmith in ${city}`, "item": `https://www.1stcapitallocksmith.com/services/commercial-locksmith/${slug}/` },
      { "@type": "ListItem", "position": 4, "name": `Panic Bar Installation in ${city}, ${state}`, "item": `https://www.1stcapitallocksmith.com/services/commercial-locksmith/${slug}/panic-bar-installation/` }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "LocalBusiness",
    "@id": "https://www.1stcapitallocksmith.com",
    "name": "1st Capital Locksmith", "telephone": "+13027350050",
    "url": `https://www.1stcapitallocksmith.com/services/commercial-locksmith/${slug}/panic-bar-installation/`,
    "description": `Panic bar and exit device installation in ${city}, ${state}. Code-compliant crash bar installation on commercial doors throughout ${county}, Delaware.`,
    "areaServed": { "@type": "City", "name": city, "containedInPlace": { "@type": "State", "name": "Delaware" } },
    "priceRange": "$$"
  })} />

  <section class="relative min-h-[420px] flex items-center py-12 md:py-20" style="background-image: url('/images/commercial-locksmith.png'); background-size: cover; background-position: center;">
  <div class="absolute inset-0 bg-[#0E1B2F]/85"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 w-full">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Commercial Locksmith · {city}, {state}</p>
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Panic Bar Installation in {city}, {state}</h1>
          <p class="text-gray-300 mb-6 leading-relaxed">
            Panic bars (also called crash bars or exit devices) are required by code on many commercial egress doors — and provide critical life-safety egress for building occupants in an emergency. 1st Capital Locksmith installs, replaces, and services commercial panic bar hardware throughout {city} and {county}.
          </p>
          <ul class="space-y-3">
            {[
              { label: "New Panic Bar Installation", href: "/services/panic-bar-installation" },
              { label: "Panic Bar Replacement", href: "/services/panic-bar-installation" },
              { label: "Rim-Type Exit Device Installation", href: "/services/panic-bar-installation" },
              { label: "Mortise Exit Device Installation", href: "/services/panic-bar-installation" },
              { label: "Panic Bar with Alarm", href: "/services/panic-bar-installation" },
              { label: "Panic Bar Repair & Adjustment", href: "/services/panic-bar-installation" },
              { label: "Code-Compliant Commercial Egress", href: "/services/panic-bar-installation" },
            ].map(({ label, href }) => (
              <li class="flex items-center gap-3 text-gray-300">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <a href={href} class="hover:text-white hover:underline transition">{label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-[#1A2B45] rounded-2xl p-8 border border-[#2A3B55]">
          <h2 class="text-xl font-bold text-white mb-5">Panic Bar Service in {city}</h2>
          <div class="space-y-4">
            {[
              { title: "Code-Compliant Installation", desc: "We install panic bar hardware that meets IBC, NFPA 101, and local Delaware code requirements for commercial egress doors." },
              { title: "All Door Types", desc: "Single and double door configurations, metal frames, hollow core, and solid commercial doors in " + city + "." },
              { title: "Multiple Hardware Brands", desc: "Von Duprin, Schlage, Yale, Detex, Dorma, and other commercial exit device brands." },
              { title: "Alarm-Equipped Exit Devices", desc: "Panic bars with audible alarms help prevent unauthorized exit use in " + city + " commercial facilities." },
            ].map((item) => (
              <div class="flex gap-3 items-start">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <div><p class="font-semibold text-white text-sm">{item.title}</p><p class="text-gray-400 text-sm">{item.desc}</p></div>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-6 border-t border-[#2A3B55]">
            <a href="tel:3027350050" class="block text-center bg-[#A61E22] text-white font-bold rounded-full py-3 px-6 hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div><p class="text-2xl font-bold text-[#A61E22]">Commercial</p><p class="text-gray-300 text-sm mt-1">Business Locksmith</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Mobile</p><p class="text-gray-300 text-sm mt-1">We Come to {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Fast</p><p class="text-gray-300 text-sm mt-1">Minimize Downtime in {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Insured</p><p class="text-gray-300 text-sm mt-1">Verified Professional</p></div>
      </div>
    </div>
  </section>

  <section class="bg-[#F8F8F5] py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Exit Device Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">Panic Bar & Exit Device Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">New Panic Bar Installation</h3>
          <p class="text-gray-600 text-sm leading-relaxed">If your commercial building in {city} has egress doors that don't yet have panic bar hardware, we can install code-compliant exit devices that allow single-motion egress from inside while maintaining controlled entry from outside. We assess your door configuration, recommend appropriate hardware, and complete the installation cleanly. Proper installation is critical — a poorly mounted exit device can fail when it's needed most.</p>
          <div class="mt-4"><a href="/services/panic-bar-installation/" class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Panic Bar Installation →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Rim vs Mortise Exit Devices</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Rim-type exit devices mount on the surface of the door and are the most common type for commercial applications in {city}. Mortise exit devices integrate into a mortise pocket in the door edge and offer a cleaner appearance with potentially higher security. We help you select the right type for your specific door and security requirements, and install it correctly.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Panic Bar with Door Alarm</h3>
          <p class="text-gray-600 text-sm leading-relaxed">For secondary exit doors in retail environments, warehouses, or office buildings in {city}, an exit device equipped with an audible alarm helps prevent unauthorized use without sacrificing code-required egress capability. The alarm sounds when the door is pushed open, deterring employees and customers from using fire exit doors as a convenience exit.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Panic Bar Repair & Replacement</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Existing panic bar hardware can wear out, become difficult to operate, or fail to latch properly over time. Worn or malfunctioning exit devices are both a safety risk and a security risk. We inspect, adjust, and repair existing panic bar hardware in {city} — and if repair is not practical, we supply and install a suitable replacement that matches your door configuration.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">More Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">More Locksmith Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <a href={`/services/commercial-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Commercial Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full commercial locksmith services in {city}.</p>
        </a>
        <a href={`/services/commercial-locksmith/${slug}/master-key-systems/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Master Key Systems in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Custom master key system design and installation in {city}.</p>
        </a>
        <a href={`/services/commercial-locksmith/${slug}/commercial-lock-rekeying/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Commercial Lock Rekeying in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Business lock rekeying after security incidents in {city}.</p>
        </a>
        <a href={`/services/commercial-locksmith/${slug}/office-lockout/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Office Lockout Service in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast commercial lockout response in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/emergency-lockout/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Lockout Service in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency lockout response in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency locksmith response in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Automotive Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Car lockouts and key services in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Residential Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">House lockouts, rekeying, and deadbolts in {city}.</p>
        </a>
        <a href={`/service-areas/${slug}/`} class="bg-[#A61E22] rounded-2xl p-6 border border-[#A61E22] hover:bg-[#8C181B] transition">
          <h3 class="font-bold text-white text-base mb-2">All Services in {city}, {state}</h3>
          <p class="text-white/80 text-sm">View all locksmith services in {city}, {state}.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Need Panic Bar Installation in {city}, {state}?</h2>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto mb-8">Call 1st Capital Locksmith for professional panic bar and exit device installation in {city}. Code-compliant installation for commercial properties throughout {county}, Delaware.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:3027350050" class="inline-flex items-center rounded-full bg-[#A61E22] px-8 py-4 text-white font-bold text-lg hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
        <a href="/contact/" class="inline-flex items-center rounded-full border border-white px-8 py-4 text-white font-semibold hover:bg-white hover:text-[#1A1F22] transition">Get a Free Quote</a>
      </div>
    </div>
  </section>

</MainLayout>
