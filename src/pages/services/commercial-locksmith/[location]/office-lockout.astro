---
import MainLayout from "../../../../layouts/MainLayout.astro";
import { locations } from "../../../../data/locations";
import type { Location } from "../../../../data/locations";

export function getStaticPaths() {
  return locations.map((loc) => ({
    params: { location: loc.slug },
    props: { location: loc },
  }));
}

interface Props { location: Location; }
const { location } = Astro.props;
const { city, state, slug, county } = location;
---

<MainLayout
  title={`Office Lockout Service in ${city}, ${state} | Business Lockout | 1st Capital Locksmith`}
  description={`Locked out of your office or business in ${city}, ${state}? 1st Capital Locksmith provides fast commercial lockout service throughout ${city} and ${county}, Delaware. All commercial door hardware. Call (302) 735-0050.`}
>

  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li><a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href="/services" class="hover:text-[#A61E22] transition font-medium">Services</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href={`/services/commercial-locksmith/${slug}`} class="hover:text-[#A61E22] transition font-medium">Commercial Locksmith in {city}</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><span class="text-[#A61E22] font-semibold">Office Lockout — {city}, {state}</span></li>
      </ol>
    </div>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.1stcapitallocksmith.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.1stcapitallocksmith.com/services/" },
      { "@type": "ListItem", "position": 3, "name": `Commercial Locksmith in ${city}`, "item": `https://www.1stcapitallocksmith.com/services/commercial-locksmith/${slug}/` },
      { "@type": "ListItem", "position": 4, "name": `Office Lockout Service in ${city}, ${state}`, "item": `https://www.1stcapitallocksmith.com/services/commercial-locksmith/${slug}/office-lockout/` }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "LocalBusiness",
    "@id": "https://www.1stcapitallocksmith.com",
    "name": "1st Capital Locksmith", "telephone": "+13027350050",
    "url": `https://www.1stcapitallocksmith.com/services/commercial-locksmith/${slug}/office-lockout/`,
    "description": `Commercial and office lockout service in ${city}, ${state}. Fast, non-destructive entry for all commercial door hardware throughout ${county}, Delaware.`,
    "areaServed": { "@type": "City", "name": city, "containedInPlace": { "@type": "State", "name": "Delaware" } },
    "priceRange": "$$"
  })} />

  <section class="relative min-h-[420px] flex items-center py-12 md:py-20" style="background-image: url('/images/commercial-locksmith.png'); background-size: cover; background-position: center;">
  <div class="absolute inset-0 bg-[#0E1B2F]/85"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 w-full">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Commercial Locksmith · {city}, {state}</p>
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Office Lockout Service in {city}, {state}</h1>
          <p class="text-gray-300 mb-6 leading-relaxed">
            Locked out of your office, store, or business in {city}? 1st Capital Locksmith provides professional commercial lockout service throughout {city} and {county}. We work quickly and professionally — minimizing your downtime and protecting your commercial door hardware.
          </p>
          <ul class="space-y-3">
            {[
              { label: "Office & Professional Suite Lockout", href: "/services/office-lockout" },
              { label: "Retail Store Lockout", href: "/services/office-lockout" },
              { label: "Warehouse & Storage Lockout", href: "/services/office-lockout" },
              { label: "After-Hours Commercial Lockout", href: "/services/emergency-lockout" },
              { label: "Damaged or Malfunctioning Commercial Lock", href: "/services/office-lockout" },
              { label: "Multi-Point Commercial Door Lockout", href: "/services/office-lockout" },
              { label: "Emergency Business Lockout", href: "/services/emergency-lockout" },
            ].map(({ label, href }) => (
              <li class="flex items-center gap-3 text-gray-300">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <a href={href} class="hover:text-white hover:underline transition">{label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-[#1A2B45] rounded-2xl p-8 border border-[#2A3B55]">
          <h2 class="text-xl font-bold text-white mb-5">Commercial Lockout Service in {city}</h2>
          <div class="space-y-4">
            {[
              { title: "Non-Destructive Entry", desc: "We use professional commercial entry tools — no drilling, no damage to your door hardware." },
              { title: "All Commercial Hardware", desc: "Cylindrical locks, mortise locks, electronic locks, and access control systems in " + city + "." },
              { title: "Fast Response", desc: `We respond throughout ${city} and ${county} — your business downtime is minimized.` },
              { title: "Authorized Business Access", desc: "We verify authorization before proceeding — protecting your business security." },
            ].map((item) => (
              <div class="flex gap-3 items-start">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <div><p class="font-semibold text-white text-sm">{item.title}</p><p class="text-gray-400 text-sm">{item.desc}</p></div>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-6 border-t border-[#2A3B55]">
            <a href="tel:3027350050" class="block text-center bg-[#A61E22] text-white font-bold rounded-full py-3 px-6 hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div><p class="text-2xl font-bold text-[#A61E22]">Commercial</p><p class="text-gray-300 text-sm mt-1">Business Locksmith</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Mobile</p><p class="text-gray-300 text-sm mt-1">We Come to {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Fast</p><p class="text-gray-300 text-sm mt-1">Minimize Downtime in {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Insured</p><p class="text-gray-300 text-sm mt-1">Verified Professional</p></div>
      </div>
    </div>
  </section>

  <section class="bg-[#F8F8F5] py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Commercial Lockout Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">Office & Business Lockout Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Office & Professional Suite Lockout</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Getting locked out of your office in {city} can disrupt your entire workday. We respond quickly and work non-destructively on all commercial door hardware — cylindrical lock sets, mortise locks, lever handles, and electronic access control systems. We gain entry without damage so your lock hardware remains intact and functional after we leave.</p>
          <div class="mt-4"><a href="/services/office-lockout" class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Office Lockout Service →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Retail & Storefront Lockout</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Retail storefronts in {city} often use commercial-grade mortise or rim locks on glass or metal-framed doors. These require specialized tools different from residential entry methods. We are familiar with common commercial storefront hardware and can open your store quickly and professionally so you can get back to serving customers.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Warehouse & Storage Lockout</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Warehouses, storage facilities, and commercial garages use heavy-duty padlocks, deadbolts, and commercial door hardware that can be challenging to access when you're locked out. We work on all commercial hardware types in {city} and can address damaged or malfunctioning locks during the same service call.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">After-Hours Emergency Lockout</h3>
          <p class="text-gray-600 text-sm leading-relaxed">An after-hours commercial lockout can have real financial consequences — especially if you have staff waiting outside, deliveries to receive, or time-sensitive operations underway. Call us at <a href="tel:3027350050" class="text-[#A61E22] font-semibold">(302) 735-0050</a> for emergency commercial lockout service throughout {city}. We can also assess the lock after entry and address any hardware issues on the spot.</p>
          <div class="mt-4"><a href="/services/emergency-lockout" class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Emergency Lockout Service →</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">More Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">More Locksmith Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <a href={`/services/commercial-locksmith/${slug}`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Commercial Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full commercial locksmith services in {city}.</p>
        </a>
        <a href={`/services/commercial-locksmith/${slug}/commercial-lock-rekeying`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Commercial Lock Rekeying in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Business lock rekeying after employee departure or security incidents in {city}.</p>
        </a>
        <a href={`/services/commercial-locksmith/${slug}/master-key-systems`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Master Key Systems in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Custom master key system design and installation for businesses in {city}.</p>
        </a>
        <a href={`/services/commercial-locksmith/${slug}/panic-bar-installation`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Panic Bar Installation in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Panic bar and exit device installation for commercial doors in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/emergency-lockout`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Lockout Service in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency lockout response for homes, vehicles, and businesses in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency locksmith response in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Automotive Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Car lockouts and key services for employees and fleet vehicles in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Residential Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">House lockouts, rekeying, and deadbolts in {city}.</p>
        </a>
        <a href={`/service-areas/${slug}`} class="bg-[#A61E22] rounded-2xl p-6 border border-[#A61E22] hover:bg-[#8C181B] transition">
          <h3 class="font-bold text-white text-base mb-2">All Services in {city}, {state}</h3>
          <p class="text-white/80 text-sm">View all locksmith services in {city}, {state}.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Locked Out of Your Business in {city}, {state}?</h2>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto mb-8">Call 1st Capital Locksmith for fast commercial lockout service in {city}. We come to your business — professional, non-destructive entry for all commercial door hardware.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:3027350050" class="inline-flex items-center rounded-full bg-[#A61E22] px-8 py-4 text-white font-bold text-lg hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
        <a href="/contact" class="inline-flex items-center rounded-full border border-white px-8 py-4 text-white font-semibold hover:bg-white hover:text-[#1A1F22] transition">Get a Free Quote</a>
      </div>
    </div>
  </section>

</MainLayout>
