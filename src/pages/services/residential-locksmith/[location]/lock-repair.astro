---
import MainLayout from "../../../../layouts/MainLayout.astro";
import { locations } from "../../../../data/locations";
import type { Location } from "../../../../data/locations";

export function getStaticPaths() {
  return locations.map((loc) => ({
    params: { location: loc.slug },
    props: { location: loc },
  }));
}

interface Props { location: Location; }
const { location } = Astro.props;
const { city, state, slug, county } = location;
---

<MainLayout
  title={`Lock Repair in ${city}, ${state} | Residential Lock Repair | 1st Capital Locksmith`}
  description={`Lock repair service in ${city}, ${state}. 1st Capital Locksmith repairs stuck, jammed, and damaged residential locks throughout ${city} and ${county}, Delaware. On-site mobile service. Call (302) 735-0050.`}
>

  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li><a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href={`/services/residential-locksmith/${slug}/`} class="hover:text-[#A61E22] transition font-medium">Residential Locksmith in {city}</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><span class="text-[#A61E22] font-semibold">Lock Repair — {city}, {state}</span></li>
      </ol>
    </div>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://1stcapitallocksmithde.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://1stcapitallocksmithde.com/services/" },
      { "@type": "ListItem", "position": 3, "name": `Residential Locksmith in ${city}`, "item": `https://1stcapitallocksmithde.com/services/residential-locksmith/${slug}/` },
      { "@type": "ListItem", "position": 4, "name": `Lock Repair in ${city}, ${state}`, "item": `https://1stcapitallocksmithde.com/services/residential-locksmith/${slug}/lock-repair/` }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "LocalBusiness",
    "@id": "https://1stcapitallocksmithde.com",
    "name": "1st Capital Locksmith", "telephone": "+13027350050",
    "url": `https://1stcapitallocksmithde.com/services/residential-locksmith/${slug}/lock-repair/`,
    "description": `Residential lock repair in ${city}, ${state}. On-site repair of stuck, jammed, and damaged door locks throughout ${county}, Delaware.`,
    "areaServed": { "@type": "City", "name": city, "containedInPlace": { "@type": "State", "name": "Delaware" } },
    "priceRange": "$$"
  })} />

  <section class="relative min-h-[420px] flex items-center py-12 md:py-20" style="background-image: url('/images/locksmith-tools-residential.jpg'); background-size: cover; background-position: center;">
  <div class="absolute inset-0 bg-[#0E1B2F]/85"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 w-full">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Residential Locksmith · {city}, {state}</p>
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Lock Repair in {city}, {state}</h1>
          <p class="text-gray-300 mb-6 leading-relaxed">
            A lock that sticks, won't fully engage, or feels loose is more than an inconvenience — it's a security concern. 1st Capital Locksmith provides on-site lock repair throughout {city} and {county} for all types of residential door locks.
          </p>
          <ul class="space-y-3">
            {[
              { label: "Stuck or Jammed Door Lock Repair", href: "/services/lock-repair" },
              { label: "Loose or Wobbly Handle & Knob Repair", href: "/services/lock-repair" },
              { label: "Misaligned Strike Plate Adjustment", href: "/services/lock-repair" },
              { label: "Damaged Lock Cylinder Repair", href: "/services/lock-repair" },
              { label: "Weather-Worn Lock Service", href: "/services/lock-repair" },
              { label: "Broken Key Extraction from Lock", href: "/services/broken-key-extraction" },
              { label: "Lock Change When Repair Isn't Enough", href: "/services/lock-change" },
            ].map(({ label, href }) => (
              <li class="flex items-center gap-3 text-gray-300">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <a href={href} class="hover:text-white hover:underline transition">{label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-[#1A2B45] rounded-2xl p-8 border border-[#2A3B55]">
          <h2 class="text-xl font-bold text-white mb-5">Repair Before Replace in {city}</h2>
          <div class="space-y-4">
            {[
              { title: "Honest Assessment", desc: "We assess your lock honestly — many problems can be repaired without needing to replace the hardware." },
              { title: "All Lock Types", desc: "Knob locks, lever handles, deadbolts, and multi-point locking systems on all residential door types." },
              { title: "Same-Day Service", desc: `We come to your home in ${city} and handle the repair on-site — no need to remove and ship hardware.` },
              { title: "Licensed & Local", desc: "Licensed Delaware locksmith serving " + city + " and " + county + "." },
            ].map((item) => (
              <div class="flex gap-3 items-start">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <div><p class="font-semibold text-white text-sm">{item.title}</p><p class="text-gray-400 text-sm">{item.desc}</p></div>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-6 border-t border-[#2A3B55]">
            <a href="tel:3027350050" class="block text-center bg-[#A61E22] text-white font-bold rounded-full py-3 px-6 hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div><p class="text-2xl font-bold text-[#A61E22]">Licensed</p><p class="text-gray-300 text-sm mt-1">Professional Locksmith</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Mobile</p><p class="text-gray-300 text-sm mt-1">We Come to {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Fast</p><p class="text-gray-300 text-sm mt-1">Quick Response in {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Upfront</p><p class="text-gray-300 text-sm mt-1">Clear Pricing Every Time</p></div>
      </div>
    </div>
  </section>

  <section class="bg-[#F8F8F5] py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Lock Repair Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">Lock Repair Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Stuck or Jammed Lock</h3>
          <p class="text-gray-600 text-sm leading-relaxed">A lock that won't turn, a deadbolt that won't fully extend, or a latch that gets stuck is usually repairable without replacing the entire hardware set. Common causes include worn internal components, debris inside the cylinder, misalignment between the bolt and strike plate, or a door frame that has settled over time. We diagnose and address the root cause on-site in {city}.</p>
          <div class="mt-4"><a href="/services/lock-repair/" class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Lock Repair →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Loose Handle & Strike Plate</h3>
          <p class="text-gray-600 text-sm leading-relaxed">A wobbly door handle or a strike plate with stripped screws is a security weakness — these are common in older homes throughout {city}. We tighten loose hardware, fill stripped screw holes with epoxy or wood filler, and ensure strike plates are properly anchored to the door frame studs. We also install reinforced strike plates where the existing hardware is inadequate.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Broken Key Extraction</h3>
          <p class="text-gray-600 text-sm leading-relaxed">A key that breaks off inside a residential door lock is a common issue — especially with older, worn keys on brass cylinders. We use specialized extraction tools to remove the broken fragment cleanly without damaging the lock cylinder. After extraction, we can cut a new key and assess whether the cylinder should be repaired, rekeyed, or replaced.</p>
          <div class="mt-4"><a href="/services/broken-key-extraction/" class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Broken Key Extraction →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">When Repair Becomes Replacement</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Some locks are too worn, corroded, or structurally compromised to repair cost-effectively. If your lock has cracked housing, a severely damaged cylinder, or is simply too low-quality to be worth repairing, we'll recommend a <a href="/services/lock-change/" class="text-[#A61E22] font-semibold">lock change</a> instead. We only recommend replacement when it genuinely makes more sense than repair for your situation in {city}.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">More Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">More Locksmith Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <a href={`/services/residential-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Residential Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full residential locksmith services in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/lock-change/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Lock Change in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full lock replacement when repair isn't the right option in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/lock-rekeying/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Lock Rekeying in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast, affordable lock rekeying in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/house-lockout/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">House Lockout Service in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast house lockout service in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/deadbolt-installation/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Deadbolt Installation in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Grade 1 and Grade 2 deadbolt installation in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/broken-key-extraction/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Broken Key Extraction in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Safe key fragment removal from door locks and ignition cylinders in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Automotive Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Car lockouts, key replacement, and ignition repair in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency locksmith response in {city}.</p>
        </a>
        <a href={`/service-areas/${slug}/`} class="bg-[#A61E22] rounded-2xl p-6 border border-[#A61E22] hover:bg-[#8C181B] transition">
          <h3 class="font-bold text-white text-base mb-2">All Services in {city}, {state}</h3>
          <p class="text-white/80 text-sm">View all locksmith services in {city}, {state}.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Need Lock Repair in {city}, {state}?</h2>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto mb-8">Call 1st Capital Locksmith for on-site lock repair in {city}. We diagnose and repair stuck, jammed, and damaged locks — same-day service available.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:3027350050" class="inline-flex items-center rounded-full bg-[#A61E22] px-8 py-4 text-white font-bold text-lg hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
        <a href="/contact/" class="inline-flex items-center rounded-full border border-white px-8 py-4 text-white font-semibold hover:bg-white hover:text-[#1A1F22] transition">Get a Free Quote</a>
      </div>
    </div>
  </section>

</MainLayout>
