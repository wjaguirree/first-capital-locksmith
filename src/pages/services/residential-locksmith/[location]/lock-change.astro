---
import MainLayout from "../../../../layouts/MainLayout.astro";
import { locations } from "../../../../data/locations";
import type { Location } from "../../../../data/locations";

export function getStaticPaths() {
  return locations.map((loc) => ({
    params: { location: loc.slug },
    props: { location: loc },
  }));
}

interface Props { location: Location; }
const { location } = Astro.props;
const { city, state, slug, county } = location;
---

<MainLayout
  title={`Lock Change in ${city}, ${state} | 1st Capital Locksmith`}
  description={`Lock change and security hardware upgrades in ${city}, ${state}. Same-day service. Call (302) 735-0050.`}
>

  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li><a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href={`/services/residential-locksmith/${slug}/`} class="hover:text-[#A61E22] transition font-medium">Residential Locksmith in {city}</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><span class="text-[#A61E22] font-semibold">Lock Change — {city}, {state}</span></li>
      </ol>
    </div>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://1stcapitallocksmithde.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://1stcapitallocksmithde.com/services/" },
      { "@type": "ListItem", "position": 3, "name": `Residential Locksmith in ${city}`, "item": `https://1stcapitallocksmithde.com/services/residential-locksmith/${slug}/` },
      { "@type": "ListItem", "position": 4, "name": `Lock Change in ${city}, ${state}`, "item": `https://1stcapitallocksmithde.com/services/residential-locksmith/${slug}/lock-change/` }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "LocalBusiness",
    "@id": "https://1stcapitallocksmithde.com",
    "name": "1st Capital Locksmith", "telephone": "+13027350050",
    "url": "https://1stcapitallocksmithde.com",
    "address": { "@type": "PostalAddress", "streetAddress": "2089 S Dupont Hwy #2", "addressLocality": "Dover", "addressRegion": "DE", "postalCode": "19901", "addressCountry": "US" },
    "geo": { "@type": "GeoCoordinates", "latitude": "39.1212111", "longitude": "-75.5331705" },
    "description": `Lock change service in ${city}, ${state}. Full door lock replacement and security upgrades throughout ${county}, Delaware. Same-day service available.`,
    "areaServed": { "@type": "City", "name": city, "containedInPlace": { "@type": "State", "name": "Delaware" } },
    "priceRange": "$$"
  })} />

  <!-- Schema: Service -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "Service",
    "name": `Lock Change in ${city}, ${state}`,
    "serviceType": "Lock Change",
    "provider": { "@type": "LocalBusiness", "name": "1st Capital Locksmith", "telephone": "+13027350050", "url": "https://1stcapitallocksmithde.com" },
    "areaServed": { "@type": "City", "name": city, "containedInPlace": { "@type": "State", "name": "Delaware" } }
  })} />

  <section class="relative min-h-105 flex items-center py-12 md:py-20" style="background-image: url('/images/locksmith-tools-residential.jpg'); background-size: cover; background-position: center;">
  <div class="absolute inset-0 bg-[#0E1B2F]/85"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 w-full">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Residential Locksmith · {city}, {state}</p>
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Lock Change in {city}, {state}</h1>
          <p class="text-gray-300 mb-6 leading-relaxed">
            When rekeying isn't enough — because your locks are worn, damaged, low-quality, or you want a full hardware upgrade — 1st Capital Locksmith provides full lock change service throughout {city} and {county}. We supply and install quality replacement hardware on all door types.
          </p>
          <ul class="space-y-3">
            {[
              { label: "Full Lock Replacement (Knob, Lever, Deadbolt)", href: "/services/lock-change" },
              { label: "Security Upgrade (Low-Quality → High-Security)", href: "/services/lock-change" },
              { label: "After Break-In Lock Replacement", href: "/services/lock-change" },
              { label: "Worn or Damaged Lock Replacement", href: "/services/lock-change" },
              { label: "Brand Upgrade (Schlage, Kwikset, Baldwin)", href: "/services/lock-change" },
              { label: "Deadbolt Installation on New Door", href: "/services/deadbolt-installation" },
              { label: "Lock Rekeying if Hardware Is Still Good", href: "/services/lock-rekeying" },
            ].map(({ label, href }) => (
              <li class="flex items-center gap-3 text-gray-300">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <a href={href} class="hover:text-white hover:underline transition">{label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-[#1A2B45] rounded-2xl p-8 border border-[#2A3B55]">
          <h2 class="text-xl font-bold text-white mb-5">Lock Change Service in {city}</h2>
          <div class="space-y-4">
            {[
              { title: "Quality Hardware Supplied", desc: "We supply and install quality lock hardware from trusted brands — Schlage, Kwikset, Yale, and others." },
              { title: "Rekeying Included", desc: "New lock hardware is keyed to your preference — we can key all locks to a single key for your home in " + city + "." },
              { title: "All Door Types", desc: `Wood, steel, and fiberglass doors throughout ${city} and ${county}, Delaware.` },
              { title: "Same-Day Service", desc: "We come to your home and complete the lock change in a single visit — same-day service available." },
            ].map((item) => (
              <div class="flex gap-3 items-start">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <div><p class="font-semibold text-white text-sm">{item.title}</p><p class="text-gray-400 text-sm">{item.desc}</p></div>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-6 border-t border-[#2A3B55]">
            <a href="tel:3027350050" class="block text-center bg-[#A61E22] text-white font-bold rounded-full py-3 px-6 hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div><p class="text-2xl font-bold text-[#A61E22]">Licensed</p><p class="text-gray-300 text-sm mt-1">Professional Locksmith</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Mobile</p><p class="text-gray-300 text-sm mt-1">We Come to {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Fast</p><p class="text-gray-300 text-sm mt-1">Quick Response in {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Upfront</p><p class="text-gray-300 text-sm mt-1">Clear Pricing Every Time</p></div>
      </div>
    </div>
  </section>

  <section class="bg-[#F8F8F5] py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Lock Change Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">Lock Change Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Full Lock Replacement</h3>
          <p class="text-gray-600 text-sm leading-relaxed">A full lock change involves removing the existing lock hardware and installing a new set in the same bore holes. This is the right call when your existing hardware is worn, damaged, or simply outdated. We supply quality residential lock sets from Schlage, Kwikset, and other reputable brands and install them correctly on your doors in {city}. New hardware comes with new keys.</p>
          <div class="mt-4"><a href="/services/lock-change/" class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Lock Change Service →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Security Upgrade</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Many homes in {city} come with builder-grade lock hardware that provides minimal security. Upgrading to Grade 1 deadbolts and properly fitted lock sets significantly raises the barrier to forced entry. We assess your current hardware, recommend appropriate upgrades, and install them with reinforced strike plates and proper door prep to maximize security.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">After a Break-In</h3>
          <p class="text-gray-600 text-sm leading-relaxed">A break-in that involved forced door entry typically damages or compromises the lock hardware. Even if the lock still functions, it may be weakened or the cylinder may have been manipulated. We respond to post-break-in calls throughout {city} and replace damaged hardware immediately, restoring your door security in a single visit.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Lock Change vs Rekeying</h3>
          <p class="text-gray-600 text-sm leading-relaxed">If your hardware is in good condition, <a href="/services/lock-rekeying/" class="text-[#A61E22] font-semibold">rekeying</a> is typically faster and more cost-effective than a full lock change. We help you understand the right option for your situation in {city} — there's no need to pay for new hardware when rekeying accomplishes the same security goal at lower cost. We only recommend replacement when it's genuinely the better choice.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">More Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">More Locksmith Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <a href={`/services/residential-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Residential Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full residential locksmith services in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/lock-repair/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Lock Repair in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Lock repair when replacement isn't necessary in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/lock-rekeying/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Lock Rekeying in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast, affordable rekeying when hardware is still in good condition in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/deadbolt-installation/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Deadbolt Installation in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Grade 1 and Grade 2 deadbolt installation in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/house-lockout/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">House Lockout Service in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast house lockout service in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/emergency-house-lockout/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency House Lockout in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency house lockout response in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Automotive Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Car lockouts, key replacement, and ignition repair in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency locksmith response in {city}.</p>
        </a>
        <a href={`/service-areas/${slug}/`} class="bg-[#A61E22] rounded-2xl p-6 border border-[#A61E22] hover:bg-[#8C181B] transition">
          <h3 class="font-bold text-white text-base mb-2">All Services in {city}, {state}</h3>
          <p class="text-white/80 text-sm">View all locksmith services in {city}, {state}.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Need a Lock Change in {city}, {state}?</h2>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto mb-8">Call 1st Capital Locksmith for full lock replacement in {city}. We supply and install quality hardware — same-day service available throughout {county}.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:3027350050" class="inline-flex items-center rounded-full bg-[#A61E22] px-8 py-4 text-white font-bold text-lg hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
        <a href="/contact/" class="inline-flex items-center rounded-full border border-white px-8 py-4 text-white font-semibold hover:bg-white hover:text-[#1A1F22] transition">Get a Free Quote</a>
      </div>
    </div>
  </section>

</MainLayout>


