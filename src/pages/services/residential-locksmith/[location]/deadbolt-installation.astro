---
import MainLayout from "../../../../layouts/MainLayout.astro";
import { locations } from "../../../../data/locations";
import type { Location } from "../../../../data/locations";

export function getStaticPaths() {
  return locations.map((loc) => ({
    params: { location: loc.slug },
    props: { location: loc },
  }));
}

interface Props { location: Location; }
const { location } = Astro.props;
const { city, state, slug, county } = location;
---

<MainLayout
  title={`Deadbolt Installation in ${city}, ${state} | Grade 1 & Grade 2 Deadbolts | 1st Capital Locksmith`}
  description={`Deadbolt installation in ${city}, ${state}. 1st Capital Locksmith installs Grade 1 and Grade 2 deadbolts on residential doors throughout ${city} and ${county}, Delaware. New installation and upgrades. Call (302) 735-0050.`}
>

  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li><a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href={`/services/residential-locksmith/${slug}/`} class="hover:text-[#A61E22] transition font-medium">Residential Locksmith in {city}</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><span class="text-[#A61E22] font-semibold">Deadbolt Installation — {city}, {state}</span></li>
      </ol>
    </div>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://1stcapitallocksmithde.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://1stcapitallocksmithde.com/services/" },
      { "@type": "ListItem", "position": 3, "name": `Residential Locksmith in ${city}`, "item": `https://1stcapitallocksmithde.com/services/residential-locksmith/${slug}/` },
      { "@type": "ListItem", "position": 4, "name": `Deadbolt Installation in ${city}, ${state}`, "item": `https://1stcapitallocksmithde.com/services/residential-locksmith/${slug}/deadbolt-installation/` }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "LocalBusiness",
    "@id": "https://1stcapitallocksmithde.com",
    "name": "1st Capital Locksmith", "telephone": "+13027350050",
    "url": `https://1stcapitallocksmithde.com/services/residential-locksmith/${slug}/deadbolt-installation/`,
    "description": `Deadbolt installation in ${city}, ${state}. Grade 1 and Grade 2 deadbolt installation and replacement on residential doors throughout ${county}, Delaware.`,
    "areaServed": { "@type": "City", "name": city, "containedInPlace": { "@type": "State", "name": "Delaware" } },
    "priceRange": "$$"
  })} />

  <section class="relative min-h-[420px] flex items-center py-12 md:py-20" style="background-image: url('/images/locksmith-tools-residential.jpg'); background-size: cover; background-position: center;">
  <div class="absolute inset-0 bg-[#0E1B2F]/85"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 w-full">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Residential Locksmith · {city}, {state}</p>
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Deadbolt Installation in {city}, {state}</h1>
          <p class="text-gray-300 mb-6 leading-relaxed">
            A properly installed deadbolt is one of the most effective ways to improve the security of your home in {city}. 1st Capital Locksmith installs Grade 1 and Grade 2 deadbolts on residential doors throughout {city} and {county} — new installations, upgrades, and replacements.
          </p>
          <ul class="space-y-3">
            {[
              { label: "Grade 1 Deadbolt Installation (Highest Security)", href: "/services/deadbolt-installation" },
              { label: "Grade 2 Deadbolt Installation", href: "/services/deadbolt-installation" },
              { label: "Double-Cylinder Deadbolt Installation", href: "/services/deadbolt-installation" },
              { label: "Deadbolt Upgrade (Replace Existing)", href: "/services/deadbolt-installation" },
              { label: "New Deadbolt on Door Without One", href: "/services/deadbolt-installation" },
              { label: "Smart Lock / Electronic Deadbolt", href: "/services/deadbolt-installation" },
              { label: "Lock Rekeying After Installation", href: "/services/lock-rekeying" },
            ].map(({ label, href }) => (
              <li class="flex items-center gap-3 text-gray-300">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <a href={href} class="hover:text-white hover:underline transition">{label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-[#1A2B45] rounded-2xl p-8 border border-[#2A3B55]">
          <h2 class="text-xl font-bold text-white mb-5">Professional Deadbolt Installation in {city}</h2>
          <div class="space-y-4">
            {[
              { title: "Proper Installation Matters", desc: "A deadbolt installed with the wrong backset, too much door gap, or a weak strike plate provides minimal security. We install correctly." },
              { title: "Grade 1 Available", desc: "ANSI Grade 1 deadbolts provide the highest residential security rating — we stock and install these in " + city + "." },
              { title: "Reinforced Strike Plate", desc: "We install extended strike plates with 3-inch screws for maximum resistance to kick-in attempts." },
              { title: "All Door Types", desc: `Wood, steel, and fiberglass doors on front, back, and side entries throughout ${city}.` },
            ].map((item) => (
              <div class="flex gap-3 items-start">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <div><p class="font-semibold text-white text-sm">{item.title}</p><p class="text-gray-400 text-sm">{item.desc}</p></div>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-6 border-t border-[#2A3B55]">
            <a href="tel:3027350050" class="block text-center bg-[#A61E22] text-white font-bold rounded-full py-3 px-6 hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div><p class="text-2xl font-bold text-[#A61E22]">Licensed</p><p class="text-gray-300 text-sm mt-1">Professional Locksmith</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Mobile</p><p class="text-gray-300 text-sm mt-1">We Come to {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Fast</p><p class="text-gray-300 text-sm mt-1">Quick Response in {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Upfront</p><p class="text-gray-300 text-sm mt-1">Clear Pricing Every Time</p></div>
      </div>
    </div>
  </section>

  <section class="bg-[#F8F8F5] py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Deadbolt Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">Deadbolt Installation Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Grade 1 vs Grade 2 Deadbolts</h3>
          <p class="text-gray-600 text-sm leading-relaxed">ANSI Grade 1 deadbolts are the highest residential security rating and are tested to withstand 250,000 cycles and 10 blows of 75 foot-pounds of force. Grade 2 deadbolts offer good security for most residential applications and are tested to 150,000 cycles. We recommend Grade 1 for exterior doors facing the street or in higher-risk areas of {city}. We'll help you choose the right option during your service call.</p>
          <div class="mt-4"><a href="/services/deadbolt-installation/" class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Deadbolt Installation →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">New Deadbolt on an Existing Door</h3>
          <p class="text-gray-600 text-sm leading-relaxed">If your door doesn't have a deadbolt, or has only a knob lock without a deadbolt, adding one is the most impactful security upgrade you can make in {city}. We measure your door, bore the hole if needed, and install a properly sized deadbolt with the correct backset and throw for your door and frame. We also ensure the strike plate is reinforced with long screws reaching the door frame studs.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Deadbolt Upgrade & Replacement</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Replacing an old, low-quality, or worn deadbolt with a new Grade 1 or Grade 2 unit is a straightforward upgrade that significantly improves your door security. We remove the existing deadbolt, install the new one with proper alignment, and can rekey it to match your other locks if needed so you only need one key for your home in {city}.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Smart & Electronic Deadbolts</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Electronic deadbolts with keypads or smart lock capabilities (Z-Wave, Zigbee, Bluetooth, Wi-Fi) offer keyless convenience and remote access control. We install and configure electronic deadbolts from major brands including Schlage, Kwikset, Yale, and Baldwin for homeowners throughout {city}. We ensure proper fit and function and can also provide backup key access options.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">More Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">More Locksmith Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <a href={`/services/residential-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Residential Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full residential locksmith services in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/lock-rekeying/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Lock Rekeying in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast, affordable lock rekeying for homes in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/house-lockout/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">House Lockout Service in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Non-destructive house lockout service in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/lock-repair/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Lock Repair in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Residential lock repair for stuck and damaged locks in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/lock-change/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Lock Change in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full lock replacement and security upgrades in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/mailbox-lock-replacement/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Mailbox Lock Replacement in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Residential mailbox lock replacement in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Automotive Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Car lockouts, key replacement, and ignition repair in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency locksmith response in {city}.</p>
        </a>
        <a href={`/service-areas/${slug}/`} class="bg-[#A61E22] rounded-2xl p-6 border border-[#A61E22] hover:bg-[#8C181B] transition">
          <h3 class="font-bold text-white text-base mb-2">All Services in {city}, {state}</h3>
          <p class="text-white/80 text-sm">View all locksmith services in {city}, {state}.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Need a Deadbolt Installed in {city}, {state}?</h2>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto mb-8">Call 1st Capital Locksmith for professional deadbolt installation in {city}. We come to your home and install Grade 1 or Grade 2 deadbolts correctly and securely.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:3027350050" class="inline-flex items-center rounded-full bg-[#A61E22] px-8 py-4 text-white font-bold text-lg hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
        <a href="/contact/" class="inline-flex items-center rounded-full border border-white px-8 py-4 text-white font-semibold hover:bg-white hover:text-[#1A1F22] transition">Get a Free Quote</a>
      </div>
    </div>
  </section>

</MainLayout>
