---
import MainLayout from "../../../../layouts/MainLayout.astro";
import { locations } from "../../../../data/locations";
import type { Location } from "../../../../data/locations";

export function getStaticPaths() {
  return locations.map((loc) => ({
    params: { location: loc.slug },
    props: { location: loc },
  }));
}

interface Props { location: Location; }
const { location } = Astro.props;
const { city, state, slug, county } = location;
---

<MainLayout
  title={`Mailbox Lock Replacement in ${city}, ${state} | Residential & Apartment | 1st Capital Locksmith`}
  description={`Mailbox lock replacement in ${city}, ${state}. 1st Capital Locksmith replaces residential and apartment mailbox locks throughout ${city} and ${county}, Delaware. Fast, affordable service. Call (302) 735-0050.`}
>

  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li><a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href={`/services/residential-locksmith/${slug}`} class="hover:text-[#A61E22] transition font-medium">Residential Locksmith in {city}</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><span class="text-[#A61E22] font-semibold">Mailbox Lock Replacement — {city}, {state}</span></li>
      </ol>
    </div>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.1stcapitallocksmith.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.1stcapitallocksmith.com/services/" },
      { "@type": "ListItem", "position": 3, "name": `Residential Locksmith in ${city}`, "item": `https://www.1stcapitallocksmith.com/services/residential-locksmith/${slug}/` },
      { "@type": "ListItem", "position": 4, "name": `Mailbox Lock Replacement in ${city}, ${state}`, "item": `https://www.1stcapitallocksmith.com/services/residential-locksmith/${slug}/mailbox-lock-replacement/` }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "LocalBusiness",
    "@id": "https://www.1stcapitallocksmith.com",
    "name": "1st Capital Locksmith", "telephone": "+13027350050",
    "url": `https://www.1stcapitallocksmith.com/services/residential-locksmith/${slug}/mailbox-lock-replacement/`,
    "description": `Mailbox lock replacement in ${city}, ${state}. Residential and apartment cluster mailbox lock replacement throughout ${county}, Delaware.`,
    "areaServed": { "@type": "City", "name": city, "containedInPlace": { "@type": "State", "name": "Delaware" } },
    "priceRange": "$$"
  })} />

  <section class="relative min-h-[420px] flex items-center py-12 md:py-20" style="background-image: url('/images/locksmith-tools-residential.jpg'); background-size: cover; background-position: center;">
  <div class="absolute inset-0 bg-[#0E1B2F]/85"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 w-full">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Residential Locksmith · {city}, {state}</p>
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Mailbox Lock Replacement in {city}, {state}</h1>
          <p class="text-gray-300 mb-6 leading-relaxed">
            1st Capital Locksmith replaces mailbox locks for residential homeowners, apartment tenants, and landlords throughout {city} and {county}. Whether your mailbox lock is worn, damaged, lost its key, or was vandalized, we provide fast, professional on-site replacement.
          </p>
          <ul class="space-y-3">
            {[
              { label: "Residential Mailbox Lock Replacement", href: "/services/mailbox-lock-replacement" },
              { label: "Apartment & Cluster Mailbox Lock", href: "/services/mailbox-lock-replacement" },
              { label: "USPS-Compatible Lock Replacement", href: "/services/mailbox-lock-replacement" },
              { label: "Mailbox Lock After Key Loss", href: "/services/mailbox-lock-replacement" },
              { label: "Vandalized Mailbox Lock Replacement", href: "/services/mailbox-lock-replacement" },
              { label: "Key Duplication for Mailbox", href: "/services/mailbox-lock-replacement" },
              { label: "Lock Repair if Replacement Not Needed", href: "/services/lock-repair" },
            ].map(({ label, href }) => (
              <li class="flex items-center gap-3 text-gray-300">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <a href={href} class="hover:text-white hover:underline transition">{label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-[#1A2B45] rounded-2xl p-8 border border-[#2A3B55]">
          <h2 class="text-xl font-bold text-white mb-5">Mailbox Lock Service in {city}</h2>
          <div class="space-y-4">
            {[
              { title: "Residential & Apartment", desc: "We service standalone residential mailboxes and apartment cluster mailbox units throughout " + city + "." },
              { title: "USPS Compatible", desc: "We use USPS-compatible replacement locks that meet postal service requirements for residential mailboxes." },
              { title: "Same-Day Service", desc: `We come to your mailbox location in ${city} and complete the replacement on-site — no need to remove and ship.` },
              { title: "Key Cutting Included", desc: "New replacement keys are cut as part of every mailbox lock replacement service in " + city + "." },
            ].map((item) => (
              <div class="flex gap-3 items-start">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <div><p class="font-semibold text-white text-sm">{item.title}</p><p class="text-gray-400 text-sm">{item.desc}</p></div>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-6 border-t border-[#2A3B55]">
            <a href="tel:3027350050" class="block text-center bg-[#A61E22] text-white font-bold rounded-full py-3 px-6 hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div><p class="text-2xl font-bold text-[#A61E22]">Licensed</p><p class="text-gray-300 text-sm mt-1">Professional Locksmith</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Mobile</p><p class="text-gray-300 text-sm mt-1">We Come to {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Fast</p><p class="text-gray-300 text-sm mt-1">Quick Response in {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Upfront</p><p class="text-gray-300 text-sm mt-1">Clear Pricing Every Time</p></div>
      </div>
    </div>
  </section>

  <section class="bg-[#F8F8F5] py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Mailbox Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">Mailbox Lock Replacement in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Residential Mailbox Lock</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Standard residential mailbox locks use a cam-style lock mechanism that can wear out, corrode, or be damaged over time. If you've lost your mailbox key, the lock is stiff and unreliable, or the lock was damaged, we can replace it with a new USPS-compatible lock on-site in {city}. We cut new keys as part of the replacement service.</p>
          <div class="mt-4"><a href="/services/mailbox-lock-replacement/" class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Mailbox Lock Replacement →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Apartment Cluster Mailbox</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Apartment cluster mailboxes (CBUs — centralized box units) use individual tenant locks inside a common unit. When a tenant lock needs replacement — due to key loss, move-out, or damage — we can replace the individual unit lock on-site. For landlords and property managers in {city}, we can service multiple units in a single visit when needed.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Lost Mailbox Key</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Lost your only mailbox key? We can either replace the lock (which is usually the most straightforward solution) or in some cases pick the lock and then cut a duplicate key. We assess which approach makes more sense for your specific mailbox type and condition in {city}.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Landlord Mailbox Service</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Property managers and landlords in {city} often need mailbox locks replaced between tenancies — especially if a tenant didn't return keys or the lock was damaged during the tenancy. We work efficiently with property management clients and can service multiple units in a single trip. Call us to discuss your property's mailbox needs in {county}.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">More Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">More Locksmith Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <a href={`/services/residential-locksmith/${slug}`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Residential Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full residential locksmith services in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/lock-repair`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Lock Repair in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Residential lock repair in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/lock-change`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Lock Change in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full door lock replacement in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/lock-rekeying`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Lock Rekeying in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast, affordable lock rekeying in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/house-lockout`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">House Lockout Service in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast house lockout service in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/deadbolt-installation`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Deadbolt Installation in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Grade 1 and Grade 2 deadbolt installation in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Automotive Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Car lockouts, key replacement, and ignition repair in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency locksmith response in {city}.</p>
        </a>
        <a href={`/service-areas/${slug}`} class="bg-[#A61E22] rounded-2xl p-6 border border-[#A61E22] hover:bg-[#8C181B] transition">
          <h3 class="font-bold text-white text-base mb-2">All Services in {city}, {state}</h3>
          <p class="text-white/80 text-sm">View all locksmith services in {city}, {state}.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Need Mailbox Lock Replacement in {city}, {state}?</h2>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto mb-8">Call 1st Capital Locksmith for on-site mailbox lock replacement in {city}. Fast service for homeowners, renters, and landlords throughout {county}.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:3027350050" class="inline-flex items-center rounded-full bg-[#A61E22] px-8 py-4 text-white font-bold text-lg hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
        <a href="/contact/" class="inline-flex items-center rounded-full border border-white px-8 py-4 text-white font-semibold hover:bg-white hover:text-[#1A1F22] transition">Get a Free Quote</a>
      </div>
    </div>
  </section>

</MainLayout>
