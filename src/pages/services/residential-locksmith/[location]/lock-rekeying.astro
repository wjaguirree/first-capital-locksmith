---
import MainLayout from "../../../../layouts/MainLayout.astro";
import { locations } from "../../../../data/locations";
import { getLocationContentProfile } from "../../../../data/locations";
import type { Location } from "../../../../data/locations";

export function getStaticPaths() {
  return locations.map((loc) => ({
    params: { location: loc.slug },
    props: { location: loc },
  }));
}

interface Props { location: Location; }
const { location } = Astro.props;
const { city, state, slug, county } = location;
const profile = getLocationContentProfile(slug);
---

<MainLayout
  title={`Lock Rekeying in ${city}, ${state} | Residential & Commercial Rekeying | 1st Capital Locksmith`}
  description={`Lock rekeying service in ${city}, ${state}. 1st Capital Locksmith rekeys ${profile.propertyMix} throughout ${city} and ${county}, Delaware. Fast, affordable rekeying for ${profile.rekeyScenario}. Call (302) 735-0050.`}
>

  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li><a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href="/services/" class="hover:text-[#A61E22] transition font-medium">Services</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><a href={`/services/residential-locksmith/${slug}/`} class="hover:text-[#A61E22] transition font-medium">Residential Locksmith in {city}</a></li>
        <li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg><span class="text-[#A61E22] font-semibold">Lock Rekeying — {city}, {state}</span></li>
      </ol>
    </div>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://1stcapitallocksmithde.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://1stcapitallocksmithde.com/services/" },
      { "@type": "ListItem", "position": 3, "name": `Residential Locksmith in ${city}`, "item": `https://1stcapitallocksmithde.com/services/residential-locksmith/${slug}/` },
      { "@type": "ListItem", "position": 4, "name": `Lock Rekeying in ${city}, ${state}`, "item": `https://1stcapitallocksmithde.com/services/residential-locksmith/${slug}/lock-rekeying/` }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "LocalBusiness",
    "@id": "https://1stcapitallocksmithde.com",
    "name": "1st Capital Locksmith", "telephone": "+13027350050",
    "url": `https://1stcapitallocksmithde.com/services/residential-locksmith/${slug}/lock-rekeying/`,
    "description": `Lock rekeying service in ${city}, ${state}. Fast, affordable residential and rental property lock rekeying throughout ${county}, Delaware.`,
    "areaServed": { "@type": "City", "name": city, "containedInPlace": { "@type": "State", "name": "Delaware" } },
    "priceRange": "$$"
  })} />

  <section class="relative min-h-105 flex items-center py-12 md:py-20" style="background-image: url('/images/locksmith-tools-residential.jpg'); background-size: cover; background-position: center;">
  <div class="absolute inset-0 bg-[#0E1B2F]/85"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 w-full">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Residential Locksmith · {city}, {state}</p>
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Lock Rekeying in {city}, {state}</h1>
          <p class="text-gray-300 mb-6 leading-relaxed">
            Rekeying changes lock pin configuration so old keys no longer work without replacing the hardware. In {city}, we handle rekeys for {profile.propertyMix}, especially for {profile.rekeyScenario}.
          </p>
          <ul class="space-y-3">
            {[
              { label: "New Homeowner Lock Rekeying", href: "/services/lock-rekeying" },
              { label: "Post-Move-In Rekeying", href: "/services/lock-rekeying" },
              { label: "After Key Loss Rekeying", href: "/services/lock-rekeying" },
              { label: "Rental Property Rekeying", href: "/services/lock-rekeying" },
              { label: "Rekey All Locks to One Key", href: "/services/lock-rekeying" },
              { label: "Rekey After Relationship Change", href: "/services/lock-rekeying" },
              { label: "Lock Change When Rekeying Isn't Enough", href: "/services/lock-change" },
            ].map(({ label, href }) => (
              <li class="flex items-center gap-3 text-gray-300">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <a href={href} class="hover:text-white hover:underline transition">{label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-[#1A2B45] rounded-2xl p-8 border border-[#2A3B55]">
          <h2 class="text-xl font-bold text-white mb-5">Rekeying vs Replacing in {city}</h2>
          <div class="space-y-4">
            {[
              { title: "More Affordable Than Replacement", desc: "Rekeying costs significantly less than replacing lock hardware — your existing locks stay in place." },
              { title: "Same Security Level", desc: "A rekeyed lock provides the same level of security as a brand-new lock with fresh hardware." },
              { title: "All Locks to One Key", desc: `We can rekey all your locks so they work with a single new key — front door, back door, deadbolt.` },
              { title: "Mobile Service in " + city, desc: `We come to your property in ${city} with dispatch planning based on ${profile.routeFocus}.` },
            ].map((item) => (
              <div class="flex gap-3 items-start">
                <span class="w-5 h-5 bg-[#A61E22] rounded-full flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <div><p class="font-semibold text-white text-sm">{item.title}</p><p class="text-gray-400 text-sm">{item.desc}</p></div>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-6 border-t border-[#2A3B55]">
            <a href="tel:3027350050" class="block text-center bg-[#A61E22] text-white font-bold rounded-full py-3 px-6 hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-8">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div><p class="text-2xl font-bold text-[#A61E22]">Licensed</p><p class="text-gray-300 text-sm mt-1">Professional Locksmith</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Mobile</p><p class="text-gray-300 text-sm mt-1">We Come to {city}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Fast</p><p class="text-gray-300 text-sm mt-1">Quick Response via {profile.routeFocus}</p></div>
        <div><p class="text-2xl font-bold text-[#A61E22]">Upfront</p><p class="text-gray-300 text-sm mt-1">Clear Pricing Every Time</p></div>
      </div>
    </div>
  </section>

  <section class="bg-[#F8F8F5] py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Rekeying Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">Lock Rekeying Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">New Homeowner Rekeying</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Moving into a new home in {city} — whether it's a new build or a resale — means you don't know how many copies of the existing keys are out there. Previous owners, contractors, real estate agents, and neighbors may all have copies. Rekeying immediately after closing is the single most important security step a new homeowner can take. We can rekey every lock in your home in a single visit.</p>
          <div class="mt-4"><a href="/services/lock-rekeying/" class="text-[#A61E22] font-semibold hover:underline text-sm">Learn more about Lock Rekeying →</a></div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">Rental Property Rekeying</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Landlords in {city} should rekey between every tenancy to protect new tenants and reduce liability. We support {profile.propertyMix} across {county}, with efficient turnover rekeys and multi-unit scheduling where needed.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">After Key Loss or Security Concern</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Lost a key, changed roommates, or unsure who still has access? Those are common {city} triggers for rekeying. Rekeying invalidates old keys immediately and gives you clean key control without replacing all hardware.</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <h3 class="text-lg font-bold text-[#1A1F22] mb-3">When Rekeying Isn't Enough</h3>
          <p class="text-gray-600 text-sm leading-relaxed">Some situations call for a full <a href="/services/lock-change/" class="text-[#A61E22] font-semibold">lock change</a> rather than rekeying — for example, if your existing locks are worn, damaged, low-quality, or have been physically compromised. We assess your hardware honestly and tell you whether rekeying is the right call or if a <a href="/services/deadbolt-installation/" class="text-[#A61E22] font-semibold">deadbolt installation</a> or full replacement would serve you better.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">More Services in {city}</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1A1F22] mb-3">More Locksmith Services in {city}, {state}</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <a href={`/services/residential-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Residential Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full residential locksmith services in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/house-lockout/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">House Lockout Service in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast non-destructive house lockout service in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/deadbolt-installation/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Deadbolt Installation in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Grade 1 and Grade 2 deadbolt installation in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/lock-repair/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Lock Repair in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Residential lock repair for stuck and worn locks in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/lock-change/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Lock Change in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Full lock replacement when rekeying isn't enough in {city}.</p>
        </a>
        <a href={`/services/residential-locksmith/${slug}/mailbox-lock-replacement/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Mailbox Lock Replacement in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Residential and apartment mailbox lock replacement in {city}.</p>
        </a>
        <a href={`/services/automotive-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Automotive Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Car lockouts, key replacement, and ignition repair in {city}.</p>
        </a>
        <a href={`/services/emergency-locksmith/${slug}/`} class="bg-[#F8F8F5] rounded-2xl p-6 border border-gray-200 hover:border-[#A61E22] hover:shadow-md transition group">
          <h3 class="font-bold text-[#1A1F22] text-base mb-2 group-hover:text-[#A61E22] transition">Emergency Locksmith in {city}, {state}</h3>
          <p class="text-gray-600 text-sm">Fast emergency locksmith response in {city}.</p>
        </a>
        <a href={`/service-areas/${slug}/`} class="bg-[#A61E22] rounded-2xl p-6 border border-[#A61E22] hover:bg-[#8C181B] transition">
          <h3 class="font-bold text-white text-base mb-2">All Services in {city}, {state}</h3>
          <p class="text-white/80 text-sm">View all locksmith services in {city}, {state}.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-[#0E1B2F] py-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Need Lock Rekeying in {city}, {state}?</h2>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto mb-8">Call 1st Capital Locksmith for fast, affordable lock rekeying in {city}. We come to your home — same-day service available.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="tel:3027350050" class="inline-flex items-center rounded-full bg-[#A61E22] px-8 py-4 text-white font-bold text-lg hover:bg-[#8C181B] transition">Call (302) 735-0050</a>
        <a href="/contact/" class="inline-flex items-center rounded-full border border-white px-8 py-4 text-white font-semibold hover:bg-white hover:text-[#1A1F22] transition">Get a Free Quote</a>
      </div>
    </div>
  </section>

</MainLayout>


