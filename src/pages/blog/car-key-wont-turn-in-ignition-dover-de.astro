              <tr class="bg-[#F8F8F5] border-t border-gray-200"><td class="px-4 py-3 font-semibold text-[#1A1F22]">Worn ignition cylinder</td><td class="px-4 py-3">Spare key sticks too</td><td class="px-4 py-3">Nothing that lasts</td><td class="px-4 py-3">Yes</td></tr>
              <tr class="bg-white border-t border-gray-200"><td class="px-4 py-3 font-semibold text-[#1A1F22]">Cold weather</td><td class="px-4 py-3">Stiff at dawn, fine by noon</td><td class="px-4 py-3">Warm the key in your hand</td><td class="px-4 py-3">If it sticks around</td></tr>
            </tbody>
