---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout
  title="Locksmith Services in Wyoming, DE | 1st Capital Locksmith"
  description="1st Capital Locksmith provides automotive, residential, commercial, and emergency locksmith services in Wyomissing, Delaware."
>

  <section class="bg-[#1A1F22] text-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-[#9A9D62] font-semibold uppercase tracking-wide">
        Service Area
      </p>

      <h1 class="text-5xl font-bold mt-4">
        Locksmith Services in Wyoming, DE
      </h1>

      <p class="mt-6 text-xl text-gray-300 max-w-3xl">
        Mobile locksmith services for homes, businesses, and vehicles throughout Wyoming and surrounding communities.
      </p>
    </div>
  </section>

  <section class="py-20 bg-[#F8F8F5]">
    <div class="max-w-6xl mx-auto px-6">

      <div class="grid md:grid-cols-2 gap-12 items-center">

        <div>
          <h2 class="text-4xl font-bold text-[#1A1F22] mb-6">
            Fast Mobile Locksmith in Wyoming
          </h2>

          <p class="mb-4 text-gray-700">
            1st Capital Locksmith provides professional automotive, residential, commercial, and emergency locksmith services throughout Wyoming, Delaware.
          </p>

          <p class="mb-4 text-gray-700">
            Whether you need a car key replacement, lockout service, lock rekeying, deadbolt installation, or business security solutions, our mobile locksmiths are ready to help.
          </p>

          <p class="text-gray-700">
            We are committed to fast response times, quality workmanship, and dependable customer service.
          </p>
        </div>

        <div>
          <img
            src="/images/wyoming-locksmith.jpg"
            alt="Locksmith Services in Wyoming DE"
            class="rounded-2xl shadow-lg"
          />
        </div>

      </div>

    </div>
  </section>

  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">

      <h2 class="text-4xl font-bold text-center mb-12">
        Our Locksmith Services
      </h2>

      <div class="grid md:grid-cols-4 gap-6">

        <div class="bg-[#F8F8F5] p-6 rounded-xl">
          <h3 class="font-bold mb-3">Automotive</h3>
          <p>Car keys, key fobs, programming, and lockouts.</p>
        </div>

        <div class="bg-[#F8F8F5] p-6 rounded-xl">
          <h3 class="font-bold mb-3">Residential</h3>
          <p>House lockouts, rekeying, lock changes, and deadbolts.</p>
        </div>

        <div class="bg-[#F8F8F5] p-6 rounded-xl">
          <h3 class="font-bold mb-3">Commercial</h3>
          <p>Business locksmith and security solutions.</p>
        </div>

        <div class="bg-[#F8F8F5] p-6 rounded-xl">
          <h3 class="font-bold mb-3">Emergency</h3>
          <p>Fast locksmith help when you need it most.</p>
        </div>

      </div>

    </div>
  </section>

</MainLayout>