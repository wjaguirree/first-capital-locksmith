    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "1st Capital Locksmith",
    "telephone": "+13027350050",
    "url": "https://1stcapitallocksmithde.com",
    "areaServed": {
      "@type": "City",
      "name": "Milford",
      "containedIn": { "@type": "State", "name": "Delaware" }
    },
    "serviceType": [
      "Automotive Locksmith",
      "Residential Locksmith",
      "Commercial Locksmith",
      "Emergency Locksmith"
    ]
  })} />

