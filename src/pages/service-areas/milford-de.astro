  description="1st Capital Locksmith provides fast, professional locksmith services in Milford, Delaware. Car lockouts, house lockouts, lock rekeying, deadbolt installation, key replacement, and emergency locksmith service in Milford, DE and surrounding Kent and Sussex County communities."
>

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
