    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://1stcapitallocksmithde.com/" },
      { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": "https://1stcapitallocksmithde.com/service-areas/" },
      { "@type": "ListItem", "position": 3, "name": "Milford, DE", "item": "https://1stcapitallocksmithde.com/service-areas/milford-de/" }
    ]
  })} />

  <!-- Schema: Local Business -->
