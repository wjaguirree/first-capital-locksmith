        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-semibold mb-2">City</label>
            <input type="text" name="city" placeholder="City" class="w-full bg-gray-800 text-white px-4 py-3 rounded border border-gray-600 focus:outline-none focus:border-[#9A9D62]" required />
          </div>
          <div>
