          <select name="service" class="w-full bg-gray-800/50 text-white px-4 py-3 rounded border border-gray-600 focus:outline-none focus:border-[#9A9D62]" required>
            <option>Choose a service</option>
            <optgroup label="Automotive Services">
              <option>Automotive Locksmith</option>
              <option>Car Key Replacement</option>
              <option>Car Lockout</option>
              <option>Emergency Car Lockout</option>
              <option>Broken Key Extraction</option>
              <option>Ignition Repair</option>
              <option>Ignition Replacement</option>
              <option>Key Fob Programming</option>
