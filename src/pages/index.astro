---
import MainLayout from "../layouts/MainLayout.astro";
import Reviews from "../components/Reviews.astro";
---

<MainLayout
  title="Dover Locksmith | 1st Capital Locksmith"
  description="Fast mobile locksmith services in Dover, Delaware: car lockouts, house lockouts, key replacement & rekeying. Call (302) 735-0050."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "1st Capital Locksmith",
    "url": "https://1stcapitallocksmithde.com",
    "telephone": "+13027350050",
    "description": "Mobile locksmith services in Dover, Delaware — automotive, residential, commercial, and emergency locksmith. Serving Kent County and surrounding areas.",
    "areaServed": { "@type": "State", "name": "Delaware" },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "2089 S Dupont Hwy #2",
      "addressLocality": "Dover",
      "addressRegion": "DE",
      "postalCode": "19901",
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "39.1212111",
      "longitude": "-75.5331705"
    },
    "openingHours": "Mo-Su 00:00-23:59",
    "priceRange": "$$",
    "image": "https://1stcapitallocksmithde.com/images/logo.png",
    "sameAs": ["https://1stcapitallocksmithde.com"]
  })} />
  <section
  class="relative min-h-150 flex items-center text-white overflow-hidden"
>
  <img
    src="/images/hero.webp"
    alt="1st Capital Locksmith mobile locksmith van in Dover, Delaware"
    fetchpriority="high"
    loading="eager"
    decoding="async"
    class="absolute inset-0 w-full h-full object-cover"
  />
  <div class="absolute inset-0 bg-black/70"></div>

  <div class="relative max-w-6xl mx-auto px-6 py-12 z-10 w-full grid md:grid-cols-2 gap-12 items-center">
    <!-- Left Column -->
    <div>
      <p class="text-[#9A9D62] font-semibold mb-6 text-sm uppercase tracking-wide">
        Mobile Locksmith Services
      </p>

      <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-6">
        Locked Out? Need New Keys? We Come To You.
      </h1>

      <p class="text-lg mb-8">
        Fast, professional mobile locksmith services for homes, vehicles, and businesses — emergency lockouts, on-site key replacement, rekeying, and security upgrades for Dover residents and nearby Delaware communities.
      </p>

      <div class="flex flex-wrap gap-4 text-sm font-semibold">
        <span>✓ Mobile Service</span>
        <span>✓ Automotive</span>
        <span>✓ Residential</span>
        <span>✓ Commercial</span>
        <span>✓ Emergency Locksmith</span>
      </div>
    </div>

    <!-- Right Column - Callback Form -->
    <div class="bg-gray-900/80 backdrop-blur p-8 rounded-lg border border-gray-700">
      <p class="text-[#9A9D62] font-semibold uppercase text-xs tracking-wide mb-4">
        Request A Callback
      </p>
      
      <h2 class="text-2xl font-bold mb-6">
        Tell us what's locked, broken, or missing
      </h2>

      <form class="space-y-4" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="093dbea7-e786-412b-b725-4380abee056b" />
        <input type="hidden" name="subject" value="New Contact Form Submission – 1st Capital Locksmith" />
        <input type="checkbox" name="botcheck" style="display:none" />
        <div>
          <label class="block text-sm font-semibold mb-2">What Do You Need?</label>
          <select name="service" class="w-full bg-gray-800/50 text-white px-4 py-3 rounded border border-gray-600 focus:outline-none focus:border-[#9A9D62]" required>
            <option>Choose a service</option>
            <optgroup label="Automotive Services">
              <option>Automotive Locksmith</option>
              <option>Car Key Replacement</option>
              <option>Car Lockout</option>
              <option>Emergency Car Lockout</option>
              <option>Broken Key Extraction</option>
              <option>Ignition Repair</option>
              <option>Ignition Replacement</option>
              <option>Key Fob Programming</option>
            </optgroup>
            <optgroup label="Residential Services">
              <option>Residential Locksmith</option>
              <option>House Lockout</option>
              <option>Emergency House Lockout</option>
              <option>Lock Change</option>
              <option>Lock Rekeying</option>
              <option>Lock Repair</option>
              <option>Deadbolt Installation</option>
              <option>Mailbox Lock Replacement</option>
              <option>Master Key Systems</option>
            </optgroup>
            <optgroup label="Commercial Services">
              <option>Commercial Locksmith</option>
              <option>Commercial Lock Rekeying</option>
              <option>Office Lockout</option>
              <option>Panic Bar Installation</option>
            </optgroup>
            <optgroup label="Emergency Services">
              <option>Emergency Locksmith</option>
              <option>Emergency Lockout</option>
              <option>Safe Lockout Services</option>
            </optgroup>
          </select>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold mb-2">Name</label>
            <input type="text" name="name" placeholder="Your name" class="w-full bg-gray-800 text-white px-4 py-3 rounded border border-gray-600 focus:outline-none focus:border-[#9A9D62]" required />
          </div>
          <div>
            <label class="block text-sm font-semibold mb-2">Phone</label>
            <input type="tel" name="phone" placeholder="(302) 555-1234" class="w-full bg-gray-800 text-white px-4 py-3 rounded border border-gray-600 focus:outline-none focus:border-[#9A9D62]" required />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold mb-2">Service Address</label>
          <input type="text" name="address" placeholder="Street number and name" class="w-full bg-gray-800 text-white px-4 py-3 rounded border border-gray-600 focus:outline-none focus:border-[#9A9D62]" required />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-semibold mb-2">City</label>
            <input type="text" name="city" placeholder="City" class="w-full bg-gray-800 text-white px-4 py-3 rounded border border-gray-600 focus:outline-none focus:border-[#9A9D62]" required />
          </div>
          <div>
            <label class="block text-sm font-semibold mb-2">State</label>
            <input type="text" name="state" placeholder="State" class="w-full bg-gray-800 text-white px-4 py-3 rounded border border-gray-600 focus:outline-none focus:border-[#9A9D62]" required />
          </div>
          <div>
            <label class="block text-sm font-semibold mb-2">ZIP</label>
            <input type="text" name="zip" placeholder="ZIP" class="w-full bg-gray-800 text-white px-4 py-3 rounded border border-gray-600 focus:outline-none focus:border-[#9A9D62]" required />
          </div>
        </div>

        <button type="submit" class="w-full bg-[#A61E22] hover:bg-[#8C181B] text-white font-bold py-3 rounded-lg transition">
          Get Quote
        </button>
      </form>
    </div>
  </div>
</section>

  <section class="bg-[#EDEBE7] py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-[#1A1F22] mb-6">
          Dover's Trusted Mobile Locksmith Service
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed">
          1st Capital Locksmith is your go-to mobile locksmith provider serving Dover, Delaware and surrounding communities. With fast response times, upfront pricing, and expert technicians, we handle automotive lockouts, residential lock issues, commercial security solutions, and emergency locksmith services. Whether you're locked out of your car, need a home security upgrade, or require professional commercial lock services, our licensed locksmiths come directly to you with the right tools to solve your problem on the spot.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8 text-center">
        <div>
          <div class="text-4xl font-bold text-[#A61E22] mb-3">Fast</div>
          <p class="text-gray-700">Mobile locksmith service arrives quickly in Dover and nearby towns for lockouts, lost keys, and urgent security problems.</p>
        </div>
        <div>
          <div class="text-4xl font-bold text-[#A61E22] mb-3">Professional</div>
          <p class="text-gray-700">Trained locksmiths provide quality workmanship for automotive, residential, and commercial jobs across Dover and Kent County.</p>
        </div>
        <div>
          <div class="text-4xl font-bold text-[#A61E22] mb-3">Reliable</div>
          <p class="text-gray-700">Available for emergency locksmith service with transparent pricing, clear communication, and dependable customer support.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#EDEBE7] py-16">
    <div class="max-w-6xl mx-auto px-6 bg-[#0E1B2F] rounded-4xl p-10">
      <div class="text-center mb-12">
        <p class="text-sm uppercase tracking-[0.3em] text-[#9A9D62] mb-4">Local locksmith solutions</p>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Professional Locksmith Services in Dover, Delaware</h2>
        <p class="mx-auto max-w-3xl text-gray-300 leading-relaxed">
          From vehicle lockouts to residential security upgrades and commercial access control, our mobile locksmith team delivers dependable service across Dover, Camden, Milford, Smyrna, and surrounding Delaware communities. Each service is designed to save you time, secure your property, and restore access quickly.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        <a href="/services/automotive-locksmith/" class="bg-white p-8 rounded-3xl shadow-lg border border-gray-200 hover:shadow-2xl hover:border-[#A61E22] transition block">
          <h3 class="font-bold text-2xl mb-4">Automotive Locksmith</h3>
        <p class="text-gray-700 mb-4">Mobile car key replacement, key fob programming, ignition repair, and fast vehicle lockout service for Dover drivers.</p>
        <ul class="space-y-3 text-gray-600">
          <li>Car key replacement</li>
          <li>Emergency car lockout</li>
          <li>Ignition repair &amp; replacement</li>
        </ul>
      </a>

      <a href="/services/residential-locksmith/" class="bg-white p-8 rounded-3xl shadow-lg border border-gray-200 hover:shadow-2xl hover:border-[#A61E22] transition block">
        <h3 class="font-bold text-2xl mb-4">Residential Locksmith</h3>
        <p class="text-gray-700 mb-4">Secure your home with rekeying, deadbolt installation, lock repair, and house lockout assistance throughout Dover.</p>
        <ul class="space-y-3 text-gray-600">
          <li>House lockout help</li>
          <li>Deadbolt installation</li>
          <li>Lock rekeying &amp; repair</li>
        </ul>
      </a>

      <a href="/services/commercial-locksmith/" class="bg-white p-8 rounded-3xl shadow-lg border border-gray-200 hover:shadow-2xl hover:border-[#A61E22] transition block">
        <h3 class="font-bold text-2xl mb-4">Commercial Locksmith</h3>
        <p class="text-gray-700 mb-4">Business lock rekeying, panic bar installation, storefront lock service, and access control support for Dover commercial properties.</p>
        <ul class="space-y-3 text-gray-600">
          <li>Commercial rekeying</li>
          <li>Panic bar installation</li>
          <li>Office lockout service</li>
        </ul>
      </a>

      <a href="/services/emergency-locksmith/" class="bg-white p-8 rounded-3xl shadow-lg border border-gray-200 hover:shadow-2xl hover:border-[#A61E22] transition block">
        <h3 class="font-bold text-2xl mb-4">Emergency Locksmith</h3>
        <p class="text-gray-700 mb-4">Quick emergency lockout response for homes, vehicles, and offices, including broken key extraction and safe lockout service.</p>
        <ul class="space-y-3 text-gray-600">
          <li>Home &amp; office lockouts</li>
          <li>Safe lockout service</li>
          <li>Broken key extraction</li>
        </ul>
      </a>
    </div>
  </section>

