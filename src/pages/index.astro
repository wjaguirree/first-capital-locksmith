        </a>
        <a href="/service-areas/leipsic-de/" class="rounded-3xl bg-white p-6 shadow-sm border border-gray-200 text-center hover:border-[#A61E22] hover:shadow-md transition block">
          <h3 class="font-semibold text-xl mb-2">Leipsic</h3>
          <p class="text-gray-600">Local locksmith help for urgent lockouts and security upgrades.</p>
        </a>
      </div>
      <div class="mt-10 text-center">
        <a href="/service-areas/" class="inline-flex items-center justify-center gap-2 rounded-full bg-[#A61E22] px-8 py-3 text-white font-semibold shadow-lg shadow-[#A61E2270] hover:bg-[#8C181B] transition">
          View all service areas
          <span class="text-xl">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
