            <div>
              <label class="block text-sm font-semibold text-white mb-2">Name</label>
              <input type="text" name="name" placeholder="Your name" class="w-full bg-gray-800 text-white px-4 py-3 rounded border border-gray-700 focus:outline-none focus:border-[#9A9D62]" required />
