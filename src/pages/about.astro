              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10l2 2h7l1-2z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 6h3l3 4v4h-2" />
            </svg>
          </div>
          <h3 class="font-bold text-lg text-[#1A1F22] mb-3">Automotive Locksmith</h3>
          <p class="text-gray-700 text-sm mb-4 leading-relaxed">Car lockouts, lost car key replacement, transponder key programming, key fob setup, and ignition repair for all vehicle makes and models.</p>
          <a href="/services/automotive-locksmith" class="text-[#A61E22] hover:text-[#8C181B] font-semibold text-sm transition">Learn more →</a>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-gray-200">
