---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Contact 1st Capital Locksmith | Locksmith in Dover, DE"
  description="Contact 1st Capital Locksmith for fast, professional locksmith service in Dover, Delaware. Call (302) 735-0050 for automotive, residential, commercial, and emergency locksmith help throughout Kent County."
>

  <!-- Breadcrumbs -->
  <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li>
          <a href="/" class="hover:text-[#A61E22] transition font-medium">Home</a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-[#A61E22] font-semibold">Contact</span>
        </li>
      </ol>
    </div>
  </nav>

  <!-- Schema: Breadcrumb -->
  <Fragment set:html={`<script type="application/ld+json">${JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.1stcapitallocksmith.com/" },
      { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://www.1stcapitallocksmith.com/contact/" }
    ]
  })}</script>`} />

  <!-- Hero -->
  <section
    class="relative min-h-[280px] md:min-h-[400px] flex items-center text-white py-10 md:py-16"
    style="background-image: url('/images/hero.png'); background-size: cover; background-position: center;"
  >
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative max-w-6xl mx-auto px-6 z-10">
      <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-4">Contact Us</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Get in Touch With a Dover Locksmith</h1>
      <p class="text-gray-300 text-lg max-w-2xl leading-relaxed">
        Need a locksmith in Dover, Delaware? Call us now or fill out the form below and we will get back to you as soon as possible. We provide mobile locksmith service throughout Kent County and surrounding areas.
      </p>
    </div>
  </section>

  <!-- Contact Info + Form -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-12">

      <!-- Left: Contact Info -->
      <div>
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Reach Us Directly</p>
        <h2 class="text-3xl font-bold text-[#1A1F22] mb-6">
          Contact 1st Capital Locksmith in Dover, DE
        </h2>
        <p class="text-gray-700 mb-8 leading-relaxed">
          We are a fully mobile locksmith company serving Dover, Kent County, and surrounding Delaware communities. Whether you need emergency lockout service, a key programmed, or a lock rekeyed, we are ready to help. Call us for the fastest response.
        </p>

        <div class="space-y-6">

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.28a2 2 0 011.897 1.368l.758 2.275a2 2 0 01-.45 2.05L8.232 9.94a16.042 16.042 0 006.826 6.826l1.247-1.253a2 2 0 012.05-.45l2.275.758A2 2 0 0121 16.72V19a2 2 0 01-2 2h-1C9.163 21 3 14.837 3 7V6a2 2 0 012-2z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-[#1A1F22] mb-1">Phone</p>
              <a href="tel:3027350050" class="text-[#A61E22] font-semibold text-lg hover:text-[#8C181B] transition">(302) 735-0050</a>
              <p class="text-gray-500 text-sm mt-1">Call for the fastest response</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-[#1A1F22] mb-1">Email</p>
              <a href="mailto:1stcapitallocksmithde@gmail.com" class="text-[#A61E22] font-semibold hover:text-[#8C181B] transition">1stcapitallocksmithde@gmail.com</a>
              <p class="text-gray-500 text-sm mt-1">We respond as quickly as possible</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0L6.343 16.657a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-[#1A1F22] mb-1">Service Area</p>
              <p class="text-gray-700">Dover, DE and surrounding Kent County</p>
              <p class="text-gray-500 text-sm mt-1">Milford, Smyrna, Camden, Harrington & more</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#A61E22] rounded-full flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-[#1A1F22] mb-1">Hours</p>
              <p class="text-gray-700">Sunday – Thursday: 7am – 10pm</p>
              <p class="text-gray-700">Friday: 7am – 6pm</p>
              <p class="text-gray-700">Saturday: Closed</p>
              <p class="text-gray-500 text-sm mt-1">Emergency service available</p>
            </div>
          </div>

        </div>
      </div>

      <!-- Right: Form -->
      <div class="bg-[#F8F8F5] rounded-2xl p-8 border border-gray-200 shadow-sm">
        <h2 class="text-2xl font-bold text-[#1A1F22] mb-2">Send Us a Message</h2>
        <p class="text-gray-600 mb-6 text-sm">Fill out the form below and we will follow up as soon as possible.</p>

        <form class="space-y-5" action="https://formspree.io/f/mzzdqzjy" method="POST">

          <!-- Hidden redirect to locksmithjobs01@gmail.com handled by Formspree dashboard -->

          <div>
            <label class="block text-sm font-semibold text-[#1A1F22] mb-2">Full Name <span class="text-[#A61E22]">*</span></label>
            <input
              type="text"
              name="name"
              placeholder="Your full name"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:border-[#9A9D62] bg-white text-[#1A1F22]"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-[#1A1F22] mb-2">Phone Number <span class="text-[#A61E22]">*</span></label>
            <input
              type="tel"
              name="phone"
              placeholder="(302) 555-1234"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:border-[#9A9D62] bg-white text-[#1A1F22]"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-[#1A1F22] mb-2">Email Address</label>
            <input
              type="email"
              name="email"
              placeholder="your@email.com"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:border-[#9A9D62] bg-white text-[#1A1F22]"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-[#1A1F22] mb-2">Service Needed <span class="text-[#A61E22]">*</span></label>
            <select
              name="service"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:border-[#9A9D62] bg-white text-[#1A1F22]"
            >
              <option value="">Select a service</option>
              <option>Car Lockout</option>
              <option>Car Key Replacement</option>
              <option>Key Fob Programming</option>
              <option>Ignition Repair or Replacement</option>
              <option>House Lockout</option>
              <option>Lock Rekeying</option>
              <option>Deadbolt Installation</option>
              <option>Lock Repair</option>
              <option>Commercial Lockout</option>
              <option>Commercial Rekeying</option>
              <option>Panic Bar Installation</option>
              <option>Master Key System</option>
              <option>Emergency Locksmith</option>
              <option>Other</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-[#1A1F22] mb-2">Location / City</label>
            <input
              type="text"
              name="location"
              placeholder="Dover, DE"
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:border-[#9A9D62] bg-white text-[#1A1F22]"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-[#1A1F22] mb-2">Message</label>
            <textarea
              name="message"
              rows="4"
              placeholder="Tell us a little about your situation..."
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:border-[#9A9D62] bg-white text-[#1A1F22] resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-[#A61E22] hover:bg-[#8C181B] text-white font-bold py-3 rounded-lg transition"
          >
            Send Message
          </button>
        </form>
      </div>

    </div>
  </section>

  <!-- What to Expect -->
  <section class="bg-[#F8F8F5] py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">What to Expect</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22] mb-4">
          Fast, Professional Locksmith Service in Dover, DE
        </h2>
        <p class="text-gray-700 max-w-3xl mx-auto leading-relaxed">
          When you contact 1st Capital Locksmith, you can expect a fast response, clear communication, and professional service from a trained locksmith technician. We serve Dover and all of Kent County with mobile locksmith solutions for homes, vehicles, and businesses.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm text-center">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.28a2 2 0 011.897 1.368l.758 2.275a2 2 0 01-.45 2.05L8.232 9.94a16.042 16.042 0 006.826 6.826l1.247-1.253a2 2 0 012.05-.45l2.275.758A2 2 0 0121 16.72V19a2 2 0 01-2 2h-1C9.163 21 3 14.837 3 7V6a2 2 0 012-2z" />
            </svg>
          </div>
          <h3 class="font-bold text-lg text-[#1A1F22] mb-2">Step 1 — Call or Message</h3>
          <p class="text-gray-700 text-sm leading-relaxed">Call us at (302) 735-0050 or submit the contact form above. Describe your situation and location so we can dispatch quickly.</p>
        </div>

        <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm text-center">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-3-3v6m9-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-bold text-lg text-[#1A1F22] mb-2">Step 2 — Get a Quote</h3>
          <p class="text-gray-700 text-sm leading-relaxed">We provide a clear upfront quote before any work begins. No hidden fees and no surprise charges when the job is complete.</p>
        </div>

        <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm text-center">
          <div class="w-14 h-14 bg-[#A61E22] rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="font-bold text-lg text-[#1A1F22] mb-2">Step 3 — Job Done</h3>
          <p class="text-gray-700 text-sm leading-relaxed">Our technician arrives at your location, completes the job professionally, and ensures everything is working properly before leaving.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Services Links -->
  <section class="bg-[#0E1B2F] py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">What We Do</p>
        <h2 class="text-3xl font-bold text-white mb-4">Our Locksmith Services in Dover, DE</h2>
        <p class="text-gray-300 max-w-2xl mx-auto">Browse all services or <a href="/services" class="text-[#9A9D62] font-semibold hover:underline">view the full services page</a>.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-8">
        <div>
          <p class="text-[#9A9D62] font-bold uppercase text-xs tracking-wide mb-3">Automotive</p>
          <ul class="space-y-2">
            <li><a href="/services/car-lockout" class="text-gray-300 hover:text-white transition text-sm">Car Lockout</a></li>
            <li><a href="/services/car-key-replacement" class="text-gray-300 hover:text-white transition text-sm">Car Key Replacement</a></li>
            <li><a href="/services/key-fob-programming" class="text-gray-300 hover:text-white transition text-sm">Key Fob Programming</a></li>
            <li><a href="/services/ignition-repair" class="text-gray-300 hover:text-white transition text-sm">Ignition Repair</a></li>
            <li><a href="/services/ignition-replacement" class="text-gray-300 hover:text-white transition text-sm">Ignition Replacement</a></li>
          </ul>
        </div>
        <div>
          <p class="text-[#9A9D62] font-bold uppercase text-xs tracking-wide mb-3">Residential</p>
          <ul class="space-y-2">
            <li><a href="/services/house-lockout" class="text-gray-300 hover:text-white transition text-sm">House Lockout</a></li>
            <li><a href="/services/emergency-house-lockout" class="text-gray-300 hover:text-white transition text-sm">Emergency House Lockout</a></li>
            <li><a href="/services/lock-rekeying" class="text-gray-300 hover:text-white transition text-sm">Lock Rekeying</a></li>
            <li><a href="/services/deadbolt-installation" class="text-gray-300 hover:text-white transition text-sm">Deadbolt Installation</a></li>
            <li><a href="/services/lock-repair" class="text-gray-300 hover:text-white transition text-sm">Lock Repair</a></li>
            <li><a href="/services/lock-change" class="text-gray-300 hover:text-white transition text-sm">Lock Change</a></li>
          </ul>
        </div>
        <div>
          <p class="text-[#9A9D62] font-bold uppercase text-xs tracking-wide mb-3">Commercial</p>
          <ul class="space-y-2">
            <li><a href="/services/office-lockout" class="text-gray-300 hover:text-white transition text-sm">Office Lockout</a></li>
            <li><a href="/services/commercial-lock-rekeying" class="text-gray-300 hover:text-white transition text-sm">Commercial Rekeying</a></li>
            <li><a href="/services/master-key-systems" class="text-gray-300 hover:text-white transition text-sm">Master Key Systems</a></li>
            <li><a href="/services/panic-bar-installation" class="text-gray-300 hover:text-white transition text-sm">Panic Bar Installation</a></li>
            <li><a href="/services/commercial-locksmith" class="text-gray-300 hover:text-white transition text-sm">Commercial Locksmith</a></li>
          </ul>
        </div>
        <div>
          <p class="text-[#9A9D62] font-bold uppercase text-xs tracking-wide mb-3">Emergency</p>
          <ul class="space-y-2">
            <li><a href="/services/emergency-lockout" class="text-gray-300 hover:text-white transition text-sm">Emergency Lockout</a></li>
            <li><a href="/services/emergency-house-lockout" class="text-gray-300 hover:text-white transition text-sm">Emergency House Lockout</a></li>
            <li><a href="/services/emergency-car-lockout" class="text-gray-300 hover:text-white transition text-sm">Emergency Car Lockout</a></li>
            <li><a href="/services/broken-key-extraction" class="text-gray-300 hover:text-white transition text-sm">Broken Key Extraction</a></li>
            <li><a href="/services/safe-lockout-services" class="text-gray-300 hover:text-white transition text-sm">Safe Lockout Services</a></li>
          </ul>
        </div>
        <div>
          <p class="text-[#9A9D62] font-bold uppercase text-xs tracking-wide mb-3">Service Areas</p>
          <ul class="space-y-2">
            <li><a href="/service-areas/dover-de" class="text-gray-300 hover:text-white transition text-sm">Dover, DE</a></li>
            <li><a href="/service-areas/smyrna-de" class="text-gray-300 hover:text-white transition text-sm">Smyrna, DE</a></li>
            <li><a href="/service-areas/milford-de" class="text-gray-300 hover:text-white transition text-sm">Milford, DE</a></li>
            <li><a href="/service-areas/camden-de" class="text-gray-300 hover:text-white transition text-sm">Camden, DE</a></li>
            <li><a href="/service-areas/harrington-de" class="text-gray-300 hover:text-white transition text-sm">Harrington, DE</a></li>
            <li><a href="/service-areas/felton-de" class="text-gray-300 hover:text-white transition text-sm">Felton, DE</a></li>
            <li><a href="/service-areas" class="text-[#9A9D62] font-semibold hover:underline text-sm">View all areas →</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-[#9A9D62] font-semibold uppercase tracking-wide text-sm mb-3">Customer Reviews</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1A1F22]">
          Trusted by Customers Throughout Delaware
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-[#F8F8F5] p-6 rounded-xl border border-gray-200 shadow-sm">
          <p class="mb-4 text-gray-700">"Fast response and very professional. Got my car unlocked quickly and without damage. Best locksmith in Dover!"</p>
          <p class="text-sm text-gray-500 mb-1">Michael R. — Car lockout</p>
          <p class="text-sm text-gray-500">Dover, DE</p>
          <strong class="text-[#1A1F22]">★★★★★</strong>
        </div>

        <div class="bg-[#F8F8F5] p-6 rounded-xl border border-gray-200 shadow-sm">
          <p class="mb-4 text-gray-700">"Needed a new key fob programmed on-site. Service was quick, pricing was fair, and the technician was very knowledgeable."</p>
          <p class="text-sm text-gray-500 mb-1">Samantha T. — Key fob programming</p>
          <p class="text-sm text-gray-500">Milford, DE</p>
          <strong class="text-[#1A1F22]">★★★★★</strong>
        </div>

        <div class="bg-[#F8F8F5] p-6 rounded-xl border border-gray-200 shadow-sm">
          <p class="mb-4 text-gray-700">"Excellent locksmith service. Arrived on time and rekeyed all our locks the same day. Very professional team."</p>
          <p class="text-sm text-gray-500 mb-1">David H. — Residential rekey</p>
          <p class="text-sm text-gray-500">Smyrna, DE</p>
          <strong class="text-[#1A1F22]">★★★★★</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#1A1F22] py-20">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Need a Locksmith in Dover, DE Right Now?
      </h2>
      <p class="text-gray-300 mb-8 text-lg max-w-2xl mx-auto leading-relaxed">
        Don't wait. Call 1st Capital Locksmith for fast mobile locksmith service throughout Dover, Kent County, and surrounding Delaware areas.
      </p>
      <a
        href="tel:3027350050"
        class="inline-flex items-center rounded-full bg-[#A61E22] px-10 py-4 text-white font-bold text-lg hover:bg-[#8C181B] transition"
      >
        Call (302) 735-0050
      </a>
    </div>
  </section>

</MainLayout>