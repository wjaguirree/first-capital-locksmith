---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const {
  title = "1st Capital Locksmith",
  description = "Mobile locksmith services in Delaware.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body class="bg-[#EDEBE7] text-gray-900">
    <Header />
    <slot />
    <Footer />
  </body>
</html>