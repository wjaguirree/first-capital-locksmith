---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const {
  title = "1st Capital Locksmith | Mobile Locksmith in Dover, DE",
  description = "Mobile locksmith services in Delaware.",
  image = "/images/hero.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="1st Capital Locksmith" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body class="bg-[#EDEBE7] text-gray-900">
    <Header />
    <slot />
    <Footer />

    <!-- Mobile reviews carousel -->
    <script>
      (function () {
        function initReviewCarousels() {
          if (window.innerWidth >= 768) return;

          // Find all grids that contain star-rating review cards
          const reviewGrids = new Set();
          document.querySelectorAll('strong').forEach(function (el) {
            if (el.textContent.trim().startsWith('\u2605\u2605\u2605\u2605\u2605')) {
              let parent = el.parentElement;
              while (parent) {
                if (parent.classList.contains('grid')) {
                  reviewGrids.add(parent);
                  break;
                }
                parent = parent.parentElement;
              }
            }
          });

          if (reviewGrids.size === 0) return;

          // Inject scrollbar-hide style once
          const style = document.createElement('style');
          style.textContent = '.rv-track::-webkit-scrollbar{display:none}';
          document.head.appendChild(style);

          reviewGrids.forEach(function (grid) {
            const cards = Array.from(grid.children);
            if (cards.length < 2) return;

            // Build scroll track
            const track = document.createElement('div');
            track.className = 'rv-track';
            track.style.cssText = 'display:flex;overflow-x:scroll;scroll-snap-type:x mandatory;scroll-behavior:smooth;-webkit-overflow-scrolling:touch;scrollbar-width:none;';

            cards.forEach(function (card) {
              const slide = document.createElement('div');
              slide.style.cssText = 'flex:0 0 100%;scroll-snap-align:start;box-sizing:border-box;';
              slide.appendChild(card);
              track.appendChild(slide);
            });

            // Dot indicators
            let current = 0;
            const dotsWrap = document.createElement('div');
            dotsWrap.style.cssText = 'display:flex;justify-content:center;gap:6px;margin-top:14px;';

            const dots = cards.map(function (_, i) {
              const dot = document.createElement('button');
              dot.setAttribute('aria-label', 'Review ' + (i + 1));
              dot.style.cssText = 'width:8px;height:8px;border-radius:50%;border:none;padding:0;cursor:pointer;transition:background .2s;background:' + (i === 0 ? '#A61E22' : '#CBD5E1') + ';';
              dot.addEventListener('click', function () {
                track.scrollTo({ left: i * track.offsetWidth, behavior: 'smooth' });
              });
              dotsWrap.appendChild(dot);
              return dot;
            });

            track.addEventListener('scroll', function () {
              const idx = Math.round(track.scrollLeft / track.offsetWidth);
              if (idx !== current && idx >= 0 && idx < cards.length) {
                dots[current].style.background = '#CBD5E1';
                current = idx;
                dots[current].style.background = '#A61E22';
              }
            }, { passive: true });

            // Prev / Next buttons
            function makeNavBtn(symbol, label, side) {
              const btn = document.createElement('button');
              btn.innerHTML = symbol;
              btn.setAttribute('aria-label', label);
              btn.style.cssText = 'position:absolute;top:50%;transform:translateY(-50%);z-index:10;background:#A61E22;color:white;border:none;width:32px;height:32px;border-radius:50%;font-size:20px;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(0,0,0,.25);padding:0;' + side + ':8px;';
              return btn;
            }

            const prevBtn = makeNavBtn('&#8249;', 'Previous review', 'left');
            const nextBtn = makeNavBtn('&#8250;', 'Next review', 'right');

            prevBtn.addEventListener('click', function () {
              track.scrollTo({ left: Math.max(0, current - 1) * track.offsetWidth, behavior: 'smooth' });
            });
            nextBtn.addEventListener('click', function () {
              track.scrollTo({ left: Math.min(cards.length - 1, current + 1) * track.offsetWidth, behavior: 'smooth' });
            });

            // Wrap it all
            const wrapper = document.createElement('div');
            wrapper.style.cssText = 'position:relative;';
            wrapper.appendChild(track);
            wrapper.appendChild(prevBtn);
            wrapper.appendChild(nextBtn);

            grid.parentNode.insertBefore(wrapper, grid);
            grid.parentNode.insertBefore(dotsWrap, wrapper.nextSibling);
            grid.parentNode.removeChild(grid);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initReviewCarousels);
        } else {
          initReviewCarousels();
        }
      })();
    </script>

    <!-- Mobile sticky call button -->
    <a
      href="tel:3027350050"
      class="fixed bottom-0 left-0 right-0 z-50 flex items-center justify-center gap-2 bg-[#A61E22] text-white font-bold text-lg py-4 shadow-lg md:hidden"
      aria-label="Call 1st Capital Locksmith"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
        <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.24 1.01l-2.21 2.2z"/>
      </svg>
      Call Now — (302) 735-0050
    </a>
  </body>
</html>