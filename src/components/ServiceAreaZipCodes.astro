        <h2 id="service-area-links" class="text-2xl font-bold text-[#1A1F22] mb-3">{zipInfo.city}, DE ZIP Code</h2>
        <p class="text-gray-700 leading-relaxed">
          {zipInfo.note} If you are near the town line or need service outside the core address range, call <a href="tel:3027350050" class="text-[#A61E22] font-semibold hover:underline">(302) 735-0050</a> and we will confirm coverage before dispatching.
        </p>
        <p class="text-gray-700 leading-relaxed mt-4">
          Common requests here include <a href={zipInfo.relatedLinks[0].href} class="text-[#A61E22] font-semibold hover:underline">{zipInfo.relatedLinks[0].label}</a>, <a href={zipInfo.relatedLinks[1].href} class="text-[#A61E22] font-semibold hover:underline">{zipInfo.relatedLinks[1].label}</a>, and <a href={zipInfo.relatedLinks[2].href} class="text-[#A61E22] font-semibold hover:underline">{zipInfo.relatedLinks[2].label}</a>, all handled by our mobile team on site.
        </p>
      </div>
    </div>
  </section>
) : (
  <section aria-labelledby="sitewide-internal-links" class="bg-[#F8F8F5] py-12 border-t border-b border-gray-200">
