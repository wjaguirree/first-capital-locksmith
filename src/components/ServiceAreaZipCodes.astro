const pathname = Astro.url.pathname.replace(/\/+$/, "/");
const slug = pathname.split("/").filter(Boolean).pop() ?? "";
const zipInfo = zipBySlug[slug];
const isServiceAreaListing = pathname === "/service-areas/";
const isServiceListing = pathname === "/services/";
const isBlogListing = pathname === "/blog/";
const isHomePage = pathname === "/";
const pageType = Astro.props.type;
const isArticle = pageType === "article";
const isServiceAreaPage = !!zipInfo;
---

{isServiceAreaPage ? (
  <section aria-labelledby="service-area-links" class="bg-[#F8F8F5] py-12 border-t border-b border-gray-200">
