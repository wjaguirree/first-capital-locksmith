# Hashed build assets — safe to cache forever, filenames change on every rebuild
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static images — not filename-hashed, but rarely change; safe to cache long-lived
/images/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

# HTML pages — always revalidate so content updates show immediately
/*
  Cache-Control: public, max-age=0, must-revalidate
